<VBox class="kyraAdminWhiteCard sapUiSmallMarginBottom" width="100%">
                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="kyraAdminCardHeaderRow">
                                <Title text="{= 'System (' + (${accessModel>/adminSystems} ? ${accessModel>/adminSystems}.length : 0) + ')' }" level="H4" class="kyraAdminCardTitle" />
                                <HBox alignItems="Center" class="kyraAdminHeaderActions">
                                    <Button icon="sap-icon://decline" type="Transparent" press=".onCloseAdminSection" tooltip="Close Section" class="kyraCloseIconBtn" />
                                </HBox>
                            </HBox>

                            <Table
                                id="adminSystemsTable"
                                items="{accessModel>/adminSystems}"
                                fixedLayout="true"
                                class="sapUiNoMargin kyraAdminCleanTable">
                                <columns>
                                    <Column width="50%" hAlign="Begin"><Text text="SYSTEM NAME" class="kyraAdminColHeader" /></Column>
                                    <Column width="30%" hAlign="Begin"><Text text="STATUS" class="kyraAdminColHeader" /></Column>
                                    <Column width="20%" hAlign="Begin"><Text text="ACTIONS" class="kyraAdminColHeader" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem vAlign="Middle" class="kyraAdminTableRow">
                                        <cells>
                                            <Text text="{accessModel>systemName}" class="kyraAdminCellBold" />
                                            <HBox alignItems="Center" class="kyraAdminStatusPill">
                                                <customData>
                                                    <core:CustomData key="status" value="{accessModel>status}" writeToDom="true" />
                                                </customData>
                                                <HBox class="kyraAdminVectorDot" />
                                                <Text
                                                    text="{accessModel>status}"
                                                    class="kyraAdminPillText" />
                                            </HBox>
                                            <HBox alignItems="Center" class="kyraAdminRowActionGroup">
                                                <Button
                                                    icon="sap-icon://edit"
                                                    press=".onEditAdminSystem"
                                                    class="kyraAdminSystemEditBtn"
                                                    tooltip="Edit System" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
