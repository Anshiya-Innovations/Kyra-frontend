<mvc:View
    controllerName="kyra001.pages.login.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page showHeader="false" enableScrolling="false" class="fioriLoginBg">
        <content>
            <VBox class="fioriLoginWrapper" justifyContent="Center" alignItems="Center">
                <VBox class="fioriLoginCard" alignItems="Center">
                    <Avatar
                        src="sap-icon://shield"
                        displaySize="L"
                        backgroundColor="Accent1"
                        class="fioriSquareIconAvatar sapUiSmallMarginBottom" />

                    <Title text="KYRA Enterprise" level="H2" class="sapUiTinyMarginBottom" style="color:#0F2B48; font-weight:700;" />
                    <Text text="User Access Governance Portal Login" class="fioriDescriptionText sapUiMediumMarginBottom" />

                    <VBox width="100%" class="sapUiSmallMarginBottom">
                        <Label text="User / Admin ID" class="fioriFormLabel" />
                        <Input
                            id="loginUserIdInput"
                            placeholder="Enter user or admin ID..."
                            width="100%"
                            value="admin@kyra.com"
                            class="fioriFormSelect" />
                    </VBox>

                    <VBox width="100%" class="sapUiSmallMarginBottom">
                        <Label text="Team Role Category" class="fioriFormLabel" />
                        <Select
                            id="loginTeamCategorySelect"
                            width="100%"
                            selectedKey="System Administrator"
                            class="fioriFormSelect">
                            <core:Item key="System Administrator" text="System Administrator" icon="sap-icon://shield" />
                            <core:Item key="System Owners" text="System Owners" icon="sap-icon://user-settings" />
                            <core:Item key="Stakeholders" text="Stakeholders" icon="sap-icon://manager" />
                        </Select>
                    </VBox>

                    <VBox width="100%" class="sapUiMediumMarginBottom">
                        <Label text="Password" class="fioriFormLabel" />
                        <Input
                            id="loginPasswordInput"
                            type="Password"
                            placeholder="Enter password..."
                            width="100%"
                            value="2233"
                            class="fioriFormSelect" />
                    </VBox>

                    <Button
                        text="Sign In to Portal"
                        type="Emphasized"
                        icon="sap-icon://log-in"
                        press=".onLoginSubmit"
                        width="100%"
                        class="fioriEmphasizedBtn" />
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
