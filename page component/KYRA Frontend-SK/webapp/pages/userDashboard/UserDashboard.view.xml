<mvc:View
    controllerName="kyra001.pages.userDashboard.UserDashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page showHeader="false" enableScrolling="true" class="fioriDashboardBg">
        <!-- User Top ShellBar -->
        <f:ShellBar
            title="{i18n>userDashboardTitle}"
            secondTitle="User Portal"
            homeIcon="sap-icon://customer"
            showCopilot="false"
            showSearch="true"
            showNotifications="true"
            notificationsNumber="2">
            <f:profile>
                <Avatar initials="US" backgroundColor="Accent6" />
            </f:profile>
            <f:additionalContent>
                <Button
                    icon="sap-icon://log-out"
                    text="{i18n>logoutButton}"
                    type="Transparent"
                    press=".onLogout"
                    tooltip="{i18n>logoutButton}" />
            </f:additionalContent>
        </f:ShellBar>

        <!-- Main User Dashboard Content -->
        <VBox class="sapUiResponsiveMargin">
            <!-- Welcome Banner Card -->
            <VBox class="fioriWelcomeCard sapUiSmallMarginBottom sapUiResponsivePadding">
                <HBox justifyContent="SpaceBetween" alignItems="Center">
                    <VBox>
                        <Title text="{i18n>welcomeUserMessage}" level="H2" class="fioriWelcomeTitle" />
                        <Text text="{i18n>userRoleText}" class="fioriWelcomeSubtitle" />
                    </VBox>
                    <HBox alignItems="Center">
                        <ObjectStatus
                            title="Role"
                            text="Standard User"
                            state="Success"
                            icon="sap-icon://sys-enter-2"
                            class="sapUiSmallMarginEnd" />
                        <Button
                            icon="sap-icon://refresh"
                            type="Transparent"
                            press=".onRefreshData"
                            tooltip="Refresh Dashboard" />
                    </HBox>
                </HBox>
            </VBox>

            <!-- User KPI Tiles Container -->
            <Title text="My Workcenter &amp; Metrics" level="H3" class="sapUiSmallMarginBottom" />
            <HBox wrap="Wrap" class="fioriTileRow sapUiSmallMarginBottom">
                <GenericTile
                    header="My Tasks"
                    subheader="Assigned to me"
                    class="sapUiTinyMarginEnd sapUiTinyMarginBottom fioriKpiTile"
                    press=".onTilePress">
                    <TileContent footer="5 Pending">
                        <NumericContent
                            value="5"
                            icon="sap-icon://task"
                            valueColor="Neutral" />
                    </TileContent>
                </GenericTile>

                <GenericTile
                    header="Time Tracking"
                    subheader="Hours logged this week"
                    class="sapUiTinyMarginEnd sapUiTinyMarginBottom fioriKpiTile"
                    press=".onTilePress">
                    <TileContent footer="Target 40h">
                        <NumericContent
                            value="38.5"
                            icon="sap-icon://time-entry-request"
                            valueColor="Good" />
                    </TileContent>
                </GenericTile>

                <GenericTile
                    header="Support Tickets"
                    subheader="Open requests"
                    class="sapUiTinyMarginEnd sapUiTinyMarginBottom fioriKpiTile"
                    press=".onTilePress">
                    <TileContent footer="1 Active">
                        <NumericContent
                            value="1"
                            icon="sap-icon://sys-help"
                            valueColor="Critical" />
                    </TileContent>
                </GenericTile>
            </HBox>

            <!-- Quick Actions -->
            <VBox class="fioriQuickActionsBox sapUiSmallMarginBottom sapUiResponsivePadding">
                <Title text="{i18n>quickActionsTitle}" level="H4" class="sapUiSmallMarginBottom" />
                <HBox wrap="Wrap">
                    <Button
                        text="{i18n>actionNewRequest}"
                        icon="sap-icon://add-document"
                        type="Default"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                        press=".onQuickAction" />
                    <Button
                        text="{i18n>actionTimeTracking}"
                        icon="sap-icon://time-entry-request"
                        type="Default"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                        press=".onQuickAction" />
                    <Button
                        text="{i18n>actionSupport}"
                        icon="sap-icon://sys-help"
                        type="Default"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                        press=".onQuickAction" />
                </HBox>
            </VBox>
        </VBox>
    </Page>
</mvc:View>
