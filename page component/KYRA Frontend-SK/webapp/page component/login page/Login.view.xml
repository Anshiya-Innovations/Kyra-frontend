<mvc:View
    controllerName="kyra001.pages.login.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    
    <Page showHeader="false" enableScrolling="true" class="fioriLoginBg">
        <content>
            <VBox justifyContent="Center" alignItems="Center" class="fioriLoginWrapper">
                <VBox class="fioriLoginCard">
                    <!-- Top Centered Header -->
                    <VBox alignItems="Center" class="fioriBrandHeader">
                        <!-- Shield Logo Avatar -->
                        <Avatar
                            src="sap-icon://shield"
                            displaySize="L"
                            type="Icon"
                            backgroundColor="Accent6"
                            class="fioriShieldCircle" />
                        <Title text="{i18n>loginTitle}" level="H1" class="fioriMainTitle" />
                        <Text text="{i18n>loginSubtitle}" class="fioriMainSubtitle" />
                        <Text text="{i18n>loginDescription}" class="fioriDescriptionText" />
                    </VBox>

                    <!-- Role Selection Dropdown -->
                    <VBox class="fioriInputGroup" width="100%">
                        <Label text="Persona" labelFor="roleSelect" class="fioriFormLabel" />
                        <Select
                            id="roleSelect"
                            selectedKey="{login>/selectedRole}"
                            change=".onRoleChange"
                            width="100%"
                            class="fioriFormSelect">
                            <items>
                                <core:Item key="Requester" text="Requester" icon="sap-icon://customer" />
                                <core:Item key="Compliance Reviewer" text="Compliance Reviewer" icon="sap-icon://activity-assigned-to-goal" />
                                <core:Item key="Approver" text="Approver" icon="sap-icon://manager" />
                            </items>
                        </Select>
                    </VBox>

                    <!-- Error Notification MessageStrip -->
                    <MessageStrip
                        visible="{login>/hasError}"
                        text="{login>/errorMessage}"
                        type="Error"
                        showIcon="true"
                        showCloseButton="true"
                        close=".onDismissError"
                        class="sapUiSmallMarginBottom" />

                    <!-- Form Controls -->
                    <VBox width="100%">
                        <!-- Dynamic ID Input -->
                        <VBox class="fioriInputGroup" width="100%">
                            <Label text="{login>/idLabel}" labelFor="idInput" class="fioriFormLabel" />
                            <Input
                                id="idInput"
                                value="{login>/userId}"
                                placeholder="{login>/idPlaceholder}"
                                valueState="{login>/idState}"
                                valueStateText="{login>/idStateText}"
                                liveChange=".onInputChange"
                                change=".onInputChange"
                                showValueHelp="true"
                                valueHelpIconSrc="sap-icon://customer"
                                showClearButton="true"
                                class="fioriFormInput"
                                width="100%" />
                        </VBox>

                        <!-- Password Field -->
                        <VBox class="fioriInputGroup" width="100%">
                            <Label text="{i18n>passwordLabel}" labelFor="passwordInput" class="fioriFormLabel" />
                            <Input
                                id="passwordInput"
                                value="{login>/password}"
                                type="{= ${login>/showPassword} ? 'Text' : 'Password' }"
                                placeholder="{i18n>passwordPlaceholder}"
                                valueState="{login>/passwordState}"
                                valueStateText="{login>/passwordStateText}"
                                liveChange=".onInputChange"
                                change=".onInputChange"
                                submit=".onLogin"
                                showValueHelp="true"
                                valueHelpIconSrc="{= ${login>/showPassword} ? 'sap-icon://hide' : 'sap-icon://show' }"
                                valueHelpRequest=".onTogglePasswordVisibility"
                                class="fioriFormInput"
                                width="100%" />
                        </VBox>

                        <!-- Remember Me & Forgot Password FlexBox Row -->
                        <FlexBox justifyContent="SpaceBetween" alignItems="Center" width="100%" class="fioriFlexRow">
                            <CheckBox text="{i18n>rememberMeLabel}" selected="{login>/rememberMe}" class="fioriCheckBox" />
                            <Link text="{i18n>forgotPasswordLabel}" press=".onForgotPassword" class="fioriForgotLink" />
                        </FlexBox>

                        <!-- SAP Emphasized Sign In Button -->
                        <Button
                            id="signInButton"
                            text="{i18n>signInButton}"
                            type="Emphasized"
                            width="100%"
                            press=".onLogin"
                            busy="{login>/isBusy}"
                            class="fioriEmphasizedBtn" />



                        <!-- Footer Section -->
                        <VBox alignItems="Center" class="fioriFooterBox">
                            <Text text="{i18n>footerText}" class="fioriFooterText" />
                        </VBox>
                    </VBox>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
