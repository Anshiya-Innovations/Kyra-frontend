<mvc:View
    controllerName="kyra001.pages.Approver.Approver"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core">

    <VBox class="sapUiNoContentPadding">


        <!-- SECTION 2: USER REQUESTS BOX & HISTORY LOG -->
        <VBox
            visible="true"
            class="fioriTableCard sapUiResponsivePadding sapUiSmallMarginBottom sapUiSmallMarginTop">
            <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="sapUiSmallMarginBottom">
                <VBox class="sapUiTinyMarginBottom">
                    <HBox alignItems="Center">
                        <Title text="{= ${accessModel>/showApprovalHistory} ? 'Processed Approval History Log' : 'User Requests' }" level="H4" class="sapUiTinyMarginEnd" />
                    </HBox>
                    <Text text="{= ${accessModel>/showApprovalHistory} ? 'Audit history of all previously approved, rejected, and cancelled access requests.' : 'Click any request row bar below to open the dedicated full summary review page.' }" class="fioriDescriptionText" />
                </VBox>
                <HBox alignItems="Center">
                    <!-- ROUND HISTORY BUTTON TO TOGGLE PENDING QUEUE VS PROCESSED HISTORY -->
                    <Button
                        icon="sap-icon://history"
                        text="{= ${accessModel>/showApprovalHistory} ? 'Show Pending Queue (' + ${accessModel>/pendingRequests}.length + ')' : 'Processed History (' + ${accessModel>/processedRequests}.length + ')' }"
                        type="{= ${accessModel>/showApprovalHistory} ? 'Emphasized' : 'Default' }"
                        press=".onToggleApprovalHistory"
                        tooltip="Toggle Approval History"
                        class="sapUiTinyMarginEnd" />

                    <SearchField
                        placeholder="Search requester or request ID..."
                        width="220px"
                        liveChange=".onSearchApprovalTable"
                        class="sapUiTinyMarginEnd" />
                    <Button
                        icon="sap-icon://excel-attachment"
                        press=".onExportApprovals"
                        tooltip="Export Audit Log" />
                </HBox>
            </HBox>

            <!-- 2 CLASSIFICATIONS: ACCESS REQUESTS AND REVOKE REQUESTS -->
            <VBox visible="{= !${accessModel>/showApprovalHistory} }">
                <IconTabBar id="approverPendingTabs" expandable="false" class="sapUiNoMargin">
                    <items>
                        <!-- CLASSIFICATION 1: ACCESS REQUESTS -->
                        <IconTabFilter
                            key="accessRequests"
                            text="Access Requests"
                            count="{accessModel>/pendingAccessCount}"
                            icon="sap-icon://add"
                            iconColor="Positive">
                            <Table
                                id="approvalAccessTable"
                                items="{accessModel>/pendingAccessRequests}"
                                noDataText="No pending access requests in queue."
                                popinLayout="GridSmall"
                                class="sapUiNoMargin">
                                <columns>
                                    <Column width="14%"><Text text="User Id" /></Column>
                                    <Column width="15%"><Text text="User Details" /></Column>
                                    <Column width="22%" minScreenWidth="Tablet" demandPopin="true"><Text text="Business Sector" /></Column>
                                    <Column width="24%" minScreenWidth="Tablet" demandPopin="true"><Text text="Business Function" /></Column>
                                    <Column width="13%" minScreenWidth="Desktop" demandPopin="true"><Text text="Submission Date" /></Column>
                                    <Column width="12%"><Text text="Approval Status" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem type="Navigation" press=".onOpenRequestSummaryDialog" vAlign="Middle">
                                        <cells>
                                            <ObjectIdentifier title="{accessModel>requesterId}" subtitle="{accessModel>requestId}" />
                                            <Text text="{= ${accessModel>selectedPersona} || (${accessModel>persona} &amp;&amp; ${accessModel>persona} !== 'Requester' ? ${accessModel>persona} : 'Frontend &amp; UI Developer Persona') }" class="fioriCellBold" />
                                            <Text text="{accessModel>sector}" wrapping="true" style="font-weight: 600;" />
                                            <Text text="{accessModel>function}" wrapping="true" />
                                            <Text text="{accessModel>submissionDate}" />
                                            <ObjectStatus text="{accessModel>status}" state="{accessModel>statusState}" icon="{accessModel>statusIcon}" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </IconTabFilter>

                        <!-- CLASSIFICATION 2: REVOKE REQUESTS -->
                        <IconTabFilter
                            key="revokeRequests"
                            text="Revoke Requests"
                            count="{accessModel>/pendingRevokeCount}"
                            icon="sap-icon://delete"
                            iconColor="Critical">
                            <Table
                                id="approvalRevokeTable"
                                items="{accessModel>/pendingRevokeRequests}"
                                noDataText="No pending revocation requests in queue."
                                popinLayout="GridSmall"
                                class="sapUiNoMargin">
                                <columns>
                                    <Column width="14%"><Text text="User Id" /></Column>
                                    <Column width="15%"><Text text="User Details" /></Column>
                                    <Column width="22%" minScreenWidth="Tablet" demandPopin="true"><Text text="Business Sector" /></Column>
                                    <Column width="24%" minScreenWidth="Tablet" demandPopin="true"><Text text="Business Function" /></Column>
                                    <Column width="13%" minScreenWidth="Desktop" demandPopin="true"><Text text="Submission Date" /></Column>
                                    <Column width="12%"><Text text="Approval Status" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem type="Navigation" press=".onOpenRequestSummaryDialog" vAlign="Middle">
                                        <cells>
                                            <ObjectIdentifier title="{accessModel>requesterId}" subtitle="{accessModel>requestId}" />
                                            <Text text="{= ${accessModel>selectedPersona} || (${accessModel>persona} &amp;&amp; ${accessModel>persona} !== 'Requester' ? ${accessModel>persona} : 'Frontend &amp; UI Developer Persona') }" class="fioriCellBold" />
                                            <Text text="{accessModel>sector}" wrapping="true" style="font-weight: 600;" />
                                            <Text text="{accessModel>function}" wrapping="true" />
                                            <Text text="{accessModel>submissionDate}" />
                                            <ObjectStatus text="{accessModel>status}" state="{accessModel>statusState}" icon="{accessModel>statusIcon}" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </IconTabFilter>
                    </items>
                </IconTabBar>
            </VBox>

            <!-- TABLE 2: PROCESSED APPROVAL HISTORY LOG TABLE -->
            <Table
                id="approvalHistoryTable"
                visible="{accessModel>/showApprovalHistory}"
                items="{accessModel>/processedRequests}"
                noDataText="No processed approval history available."
                popinLayout="GridSmall"
                class="sapUiNoMargin">
                <columns>
                    <Column width="13%"><Text text="User Id" /></Column>
                    <Column width="14%"><Text text="User Details" /></Column>
                    <Column width="20%" minScreenWidth="Tablet" demandPopin="true"><Text text="Business Sector" /></Column>
                    <Column width="22%" minScreenWidth="Tablet" demandPopin="true"><Text text="Business Function" /></Column>
                    <Column width="12%" minScreenWidth="Desktop" demandPopin="true"><Text text="Decision Date" /></Column>
                    <Column width="12%"><Text text="Final Decision" /></Column>
                    <Column width="7%" hAlign="Center"><Text text="Decision Breakdown" /></Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <ObjectIdentifier title="{accessModel>requesterId}" subtitle="{accessModel>requestId}" />
                            <Text text="{= ${accessModel>selectedPersona} || (${accessModel>persona} &amp;&amp; ${accessModel>persona} !== 'Requester' ? ${accessModel>persona} : 'Frontend &amp; UI Developer Persona') }" class="fioriCellBold" />
                            <Text text="{accessModel>sector}" wrapping="true" style="font-weight: 600;" />
                            <Text text="{accessModel>function}" wrapping="true" />
                            <Text text="{accessModel>decisionDate}" />
                            <ObjectStatus
                                text="{accessModel>status}"
                                state="{accessModel>statusState}"
                                icon="{accessModel>statusIcon}" />
                            <HBox justifyContent="Center">
                                <Button
                                    text="View Breakdown"
                                    icon="sap-icon://hint"
                                    type="Default"
                                    press=".onOpenDecisionBreakdownDialog"
                                    tooltip="View Approved and Rejected Details" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </VBox>
</mvc:View>
