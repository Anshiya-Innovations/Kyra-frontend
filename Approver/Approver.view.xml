<mvc:View
    controllerName="kyra001.pages.Approver.Approver"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core">

    <VBox class="sapUiNoContentPadding">

        <!-- SECTION 1: ACCESS MANAGEMENT QUICK ACTIONS (2 SQUARE BOXES: ADD ACCESS & REMOVE ACCESS) -->
        <Title
            text="Access Management Operations"
            level="H3"
            class="sapUiSmallMarginBottom sapUiSmallMarginTop" />

        <l:Grid
            defaultSpan="L6 M6 S12"
            class="sapUiNoContentPadding sapUiSmallMarginBottom">
            <!-- SQUARE BOX 1: ADD ACCESS -->
            <VBox class="fioriSquareBoxCard sapUiResponsivePadding" alignItems="Center" justifyContent="SpaceBetween">
                <VBox alignItems="Center" class="sapUiSmallMarginTop">
                    <Avatar
                        src="sap-icon://add"
                        backgroundColor="Accent1"
                        displaySize="L"
                        class="fioriSquareIconAvatar sapUiSmallMarginBottom" />
                    <Title text="Add Access" level="H3" class="fioriSquareBoxTitle" />
                    <Text text="Submit a new business sector and system role access request for approval." textAlign="Center" class="fioriSquareBoxDesc sapUiSmallMarginBottom" />
                </VBox>
                <Button
                    text="Open Add Access Form"
                    icon="sap-icon://add"
                    type="Emphasized"
                    press=".onOpenAddAccessDialog"
                    class="fioriEmphasizedBtn sapUiSmallMarginBottom"
                    width="90%" />
            </VBox>

            <!-- SQUARE BOX 2: REMOVE ACCESS -->
            <VBox class="fioriSquareBoxCard sapUiResponsivePadding" alignItems="Center" justifyContent="SpaceBetween">
                <VBox alignItems="Center" class="sapUiSmallMarginTop">
                    <Avatar
                        src="sap-icon://delete"
                        backgroundColor="Accent3"
                        displaySize="L"
                        class="fioriSquareIconAvatar sapUiSmallMarginBottom" />
                    <Title text="Remove Access" level="H3" class="fioriSquareBoxTitle" />
                    <Text text="Select an active granted entitlement to initiate access revocation." textAlign="Center" class="fioriSquareBoxDesc sapUiSmallMarginBottom" />
                </VBox>
                <Button
                    text="Open Remove Access List"
                    icon="sap-icon://delete"
                    type="Reject"
                    press=".onOpenRemoveAccessDialog"
                    class="sapUiSmallMarginBottom"
                    width="90%" />
            </VBox>
        </l:Grid>

        <!-- SECTION 2: USER REQUESTER ACCESS REQUESTS BOX & HISTORY LOG -->
        <VBox
            visible="{accessModel>/isApproverPersona}"
            class="fioriTableCard sapUiResponsivePadding sapUiSmallMarginBottom sapUiSmallMarginTop">
            <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="sapUiSmallMarginBottom">
                <VBox class="sapUiTinyMarginBottom">
                    <HBox alignItems="Center">
                        <Title text="{= ${accessModel>/showApprovalHistory} ? 'Processed Approval History Log' : 'User Requester Access Requests' }" level="H4" class="sapUiTinyMarginEnd" />
                    </HBox>
                    <Text text="{= ${accessModel>/showApprovalHistory} ? 'Audit history of all previously approved, rejected, and cancelled access requests.' : 'Click any request row bar below to open the dedicated full summary review page.' }" class="fioriDescriptionText" />
                </VBox>
                <HBox alignItems="Center">
                    <!-- ROUND HISTORY BUTTON TO TOGGLE PENDING QUEUE VS PROCESSED HISTORY -->
                    <Button
                        icon="sap-icon://history"
                        text="{= ${accessModel>/showApprovalHistory} ? 'Show Pending Queue (' + ${accessModel>/pendingRequests}.length + ')' : 'Processed History (' + ${accessModel>/processedRequests}.length + ')' }"
                        type="{= ${accessModel>/showApprovalHistory} ? 'Emphasized' : 'Default' }"
                        press=".onToggleApprovalHistory"
                        tooltip="Toggle Approval History"
                        class="sapUiTinyMarginEnd" />

                    <SearchField
                        placeholder="Search requester or request ID..."
                        width="220px"
                        liveChange=".onSearchApprovalTable"
                        class="sapUiTinyMarginEnd" />
                    <Button
                        icon="sap-icon://excel-attachment"
                        press=".onExportApprovals"
                        tooltip="Export Audit Log" />
                </HBox>
            </HBox>

            <!-- TABLE 1: ACTIVE PENDING REQUESTS QUEUE -->
            <Table
                id="approvalTable"
                visible="{= !${accessModel>/showApprovalHistory} }"
                items="{accessModel>/pendingRequests}"
                noDataText="No pending access requests in queue."
                popinLayout="GridSmall"
                class="sapUiNoMargin">
                <columns>
                    <Column width="15%"><Text text="User Id" /></Column>
                    <Column width="16%"><Text text="User Details" /></Column>
                    <Column width="24%" minScreenWidth="Tablet" demandPopin="true"><Text text="Target System" /></Column>
                    <Column width="28%" minScreenWidth="Tablet" demandPopin="true"><Text text="Services &amp; Team Roles" /></Column>
                    <Column width="14%" minScreenWidth="Desktop" demandPopin="true"><Text text="Submission Date" /></Column>
                    <Column width="13%"><Text text="Approval Status" /></Column>
                </columns>
                <items>
                    <!-- Click row bar to open dedicated Full Summary Page -->
                    <ColumnListItem
                        type="Navigation"
                        press=".onOpenRequestSummaryDialog"
                        vAlign="Middle">
                        <cells>
                            <ObjectIdentifier title="{accessModel>requestId}" subtitle="{accessModel>duration}" />
                            <!-- User Details displays ONLY Requester or Approval persona type (NO personal name inside) -->
                            <ObjectIdentifier title="{accessModel>persona}" subtitle="{accessModel>requesterId}" />
                            <Text text="{accessModel>system}" wrapping="true" style="font-weight: 600;" />
                            <Text text="{accessModel>serviceAndRole}" wrapping="true" />
                            <Text text="{accessModel>submissionDate}" />
                            <ObjectStatus
                                text="{accessModel>status}"
                                state="{accessModel>statusState}"
                                icon="{accessModel>statusIcon}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>

            <!-- TABLE 2: PROCESSED APPROVAL HISTORY LOG TABLE -->
            <Table
                id="approvalHistoryTable"
                visible="{accessModel>/showApprovalHistory}"
                items="{accessModel>/processedRequests}"
                noDataText="No processed approval history available."
                popinLayout="GridSmall"
                class="sapUiNoMargin">
                <columns>
                    <Column width="14%"><Text text="User Id" /></Column>
                    <Column width="15%"><Text text="User Details" /></Column>
                    <Column width="22%" minScreenWidth="Tablet" demandPopin="true"><Text text="Target System" /></Column>
                    <Column width="24%" minScreenWidth="Tablet" demandPopin="true"><Text text="Services &amp; Team Roles" /></Column>
                    <Column width="12%" minScreenWidth="Desktop" demandPopin="true"><Text text="Decision Date" /></Column>
                    <Column width="13%"><Text text="Final Decision" /></Column>
                    <Column width="14%" hAlign="Center"><Text text="Decision Breakdown" /></Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <ObjectIdentifier title="{accessModel>requestId}" subtitle="{accessModel>duration}" />
                            <!-- User Details displays ONLY Requester or Approval persona type (NO personal name inside) -->
                            <ObjectIdentifier title="{accessModel>persona}" subtitle="{accessModel>requesterId}" />
                            <Text text="{accessModel>system}" wrapping="true" style="font-weight: 600;" />
                            <Text text="{accessModel>serviceAndRole}" wrapping="true" />
                            <Text text="{accessModel>decisionDate}" />
                            <ObjectStatus
                                text="{accessModel>status}"
                                state="{accessModel>statusState}"
                                icon="{accessModel>statusIcon}" />
                            <HBox justifyContent="Center">
                                <Button
                                    text="View Breakdown"
                                    icon="sap-icon://hint"
                                    type="Default"
                                    press=".onOpenDecisionBreakdownDialog"
                                    tooltip="View Approved and Rejected Details" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>

        <!-- SECTION 3: DEDICATED FULL REQUEST GOVERNANCE SUMMARY PAGE (COMBINED INSIDE SINGLE COMPONENT) -->
        <VBox
            visible="{accessModel>/showRequestDetailView}"
            class="sapUiResponsiveMargin">

            <!-- Dynamic Page Title Banner Card for Summary Review -->
            <VBox class="fioriHeaderBannerCard sapUiSmallMarginBottom">
                <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" width="100%">
                    <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                        <Avatar
                            src="sap-icon://summary-detail"
                            displaySize="L"
                            backgroundColor="Accent1"
                            class="fioriShieldHeaderAvatar sapUiMediumMarginEnd" />
                        <VBox>
                            <Title text="Access Request Governance Summary Review" level="H1" class="fioriBannerTitle" />
                            <Text text="{= 'Reviewing entitlement submission for User Id: ' + ${accessModel>/selectedRequest/requestId} }" class="fioriBannerSubtitle" />
                        </VBox>
                    </HBox>
                    <Button
                        text="Back to User Access Portal"
                        icon="sap-icon://navigation-left-arrow"
                        type="Default"
                        press=".onCloseRequestSummaryView" />
                </HBox>
            </VBox>

            <!-- CARD 1: FULL ACCESS GOVERNANCE & REQUESTER DETAILS (4 Grid Columns) -->
            <VBox class="fioriTableCard sapUiResponsivePadding sapUiSmallMarginBottom">
                <Title text="Full Access Governance &amp; Requester Details" level="H3" class="sapUiSmallMarginBottom" />

                <!-- Grid Layout matching exact columns in user uploaded screenshot -->
                <l:Grid defaultSpan="L3 M6 S12" class="sapUiNoContentPadding sapUiSmallMarginBottom">
                    <!-- Column 1 -->
                    <VBox class="sapUiSmallMarginBottom">
                        <VBox class="sapUiSmallMarginBottom">
                            <Label text="Requester User ID" class="fioriFormLabel" />
                            <Text text="{accessModel>/selectedRequest/requesterId}" class="sapUiTinyMarginTop" style="font-weight: 700; font-size: 1.05rem;" />
                        </VBox>
                        <VBox>
                            <Label text="Operating Region" class="fioriFormLabel" />
                            <Text text="{accessModel>/selectedRequest/region}" class="sapUiTinyMarginTop" style="font-weight: 600;" />
                        </VBox>
                    </VBox>

                    <!-- Column 2 -->
                    <VBox class="sapUiSmallMarginBottom">
                        <VBox class="sapUiSmallMarginBottom">
                            <Label text="Requester Role Persona" class="fioriFormLabel" />
                            <Text text="{accessModel>/selectedRequest/persona}" class="sapUiTinyMarginTop" style="font-weight: 600;" />
                        </VBox>
                        <VBox>
                            <Label text="Access Duration" class="fioriFormLabel" />
                            <Text text="{accessModel>/selectedRequest/duration}" class="sapUiTinyMarginTop" style="font-weight: 600;" />
                        </VBox>
                    </VBox>

                    <!-- Column 3 -->
                    <VBox class="sapUiSmallMarginBottom">
                        <VBox class="sapUiSmallMarginBottom">
                            <Label text="Business Sector" class="fioriFormLabel" />
                            <Text text="{accessModel>/selectedRequest/sector}" class="sapUiTinyMarginTop" style="font-weight: 600;" />
                        </VBox>
                        <VBox>
                            <Label text="Business Justification" class="fioriFormLabel" />
                            <Text text="{accessModel>/selectedRequest/justification}" class="sapUiTinyMarginTop" style="font-style: italic;" />
                        </VBox>
                    </VBox>

                    <!-- Column 4 -->
                    <VBox class="sapUiSmallMarginBottom">
                        <VBox class="sapUiSmallMarginBottom">
                            <Label text="Business Function" class="fioriFormLabel" />
                            <Text text="{accessModel>/selectedRequest/function}" class="sapUiTinyMarginTop" style="font-weight: 600;" />
                        </VBox>
                        <VBox>
                            <Label text="Approval Status" class="fioriFormLabel" />
                            <ObjectStatus
                                text="{accessModel>/selectedRequest/status}"
                                state="{accessModel>/selectedRequest/statusState}"
                                icon="{accessModel>/selectedRequest/statusIcon}"
                                class="sapUiTinyMarginTop" />
                        </VBox>
                    </VBox>
                </l:Grid>
            </VBox>

            <!-- CARD 2: TARGET SYSTEMS & ENTITLEMENTS REQUESTED TABLE (ACCEPT / REJECT ACTIONS COLUMN) -->
            <VBox class="fioriTableCard sapUiResponsivePadding sapUiSmallMarginBottom">
                <Title text="Target Systems &amp; Entitlements Requested" level="H4" class="sapUiSmallMarginBottom" />

                <Table
                    id="entitlementsSummaryTable"
                    items="{accessModel>/selectedRequest/entitlements}"
                    noDataText="No entitlement details available."
                    class="sapUiNoMargin">
                    <columns>
                        <Column><Text text="System Name" /></Column>
                        <Column><Text text="Roles" /></Column>
                        <Column><Text text="Team" /></Column>
                        <Column><Text text="Granted Date" /></Column>
                        <Column><Text text="Expiry Date" /></Column>
                        <Column><Text text="Status" /></Column>
                        <Column hAlign="Center"><Text text="Accept / Reject" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem vAlign="Middle">
                            <cells>
                                <Text text="{accessModel>system}" />
                                <Text text="{accessModel>roleName}" style="font-weight: 700;" />
                                <Text text="{accessModel>team}" />
                                <Text text="{accessModel>grantedDate}" />
                                <Text text="{accessModel>expiryDate}" />
                                <ObjectStatus
                                    text="{accessModel>status}"
                                    state="{accessModel>statusState}"
                                    icon="{accessModel>statusIcon}" />
                                <!-- Separate Accept and Reject Tool Buttons -->
                                <HBox justifyContent="Center" alignItems="Center">
                                    <Button
                                        text="Accept"
                                        icon="sap-icon://accept"
                                        type="Accept"
                                        press=".onAcceptEntitlement"
                                        tooltip="Accept this System Entitlement"
                                        class="sapUiTinyMarginEnd" />
                                    <Button
                                        text="Reject"
                                        icon="sap-icon://decline"
                                        type="Reject"
                                        press=".onRejectEntitlement"
                                        tooltip="Reject this System Entitlement" />
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <!-- Summary Down Side Action Buttons (ONLY CANCEL / SUBMIT BUTTONS) -->
                <HBox justifyContent="End" alignItems="Center" class="sapUiSmallMarginTop">
                    <Button
                        text="Cancel"
                        icon="sap-icon://decline"
                        type="Reject"
                        press=".onCancelRequestSummaryView"
                        class="sapUiTinyMarginEnd" />
                    <Button
                        text="Submit"
                        icon="sap-icon://accept"
                        type="Emphasized"
                        press=".onApproveSelectedRequest"
                        class="fioriEmphasizedBtn" />
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</mvc:View>
