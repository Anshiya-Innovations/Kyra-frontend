<mvc:View
    controllerName="kyra001.pages.addAccess.AddAccess"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true">

    <Page showHeader="false" enableScrolling="true" class="fioriDashboardBg">
        <content>
            <!-- Enterprise ShellBar Header -->
            <f:ShellBar
                title="KYRA Enterprise"
                secondTitle="New Access Request Wizard"
                homeIcon="sap-icon://shield"
                showCopilot="false"
                showSearch="true"
                showNotifications="true"
                notificationsNumber="3">
                <f:profile>
                    <Avatar initials="ADM" backgroundColor="Accent1" />
                </f:profile>
                <f:additionalContent>
                    <Button
                        icon="sap-icon://navigation-left-arrow"
                        text="Back to User Portal"
                        type="Transparent"
                        press=".onNavBackToPortal"
                        tooltip="Back to Access Portal" />
                </f:additionalContent>
            </f:ShellBar>

            <!-- Main Content Container -->
            <VBox class="sapUiResponsiveMargin">
                <!-- Page Title Header Card -->
                <VBox class="fioriWelcomeCard sapUiSmallMarginBottom sapUiResponsivePadding">
                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                        <VBox>
                            <Title text="Add Access Request - Business Governance" level="H2" class="fioriWelcomeTitle" />
                            <Text text="Step-by-step role entitlement wizard for enterprise systems and business sectors." class="fioriWelcomeSubtitle" />
                        </VBox>
                        <ObjectStatus
                            title="Wizard Progress"
                            text="{= ${addAccessModel>/step3Visible} ? 'Step 3 of 3 (Summary)' : (${addAccessModel>/step2Visible} ? 'Step 2 of 3' : 'Step 1 of 3') }"
                            state="Information"
                            icon="sap-icon://process" />
                    </HBox>
                </VBox>

                <!-- STEP 1 CONTAINER: BUSINESS SECTOR &amp; BUSINESS FUNCTION -->
                <VBox
                    visible="{addAccessModel>/step1Visible}"
                    class="fioriTableCard sapUiResponsivePadding sapUiSmallMarginBottom">
                    <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                        <Avatar src="sap-icon://building" backgroundColor="Accent1" displaySize="S" class="sapUiTinyMarginEnd" />
                        <VBox>
                            <Title text="Step 1: Business Sector and Business Function Selection" level="H4" />
                            <Text text="Select your target enterprise sector and operational business function below." class="fioriDescriptionText" />
                        </VBox>
                    </HBox>

                    <form:SimpleForm
                        editable="true"
                        layout="ColumnLayout"
                        columnsM="2"
                        columnsL="2"
                        singleContainerFullWidth="false">
                        <form:content>
                            <core:Title text="Business Sector Configuration" />
                            
                            <Label text="Business Sector" required="true" />
                            <Select
                                id="businessSectorSelect"
                                selectedKey="{addAccessModel>/sector}"
                                change=".onSectorChange"
                                width="100%"
                                class="fioriFormSelect">
                                <core:Item key="" text="-- Select Business Sector --" />
                                <core:Item key="Finance &amp; Enterprise Performance" text="Finance &amp; Enterprise Performance" icon="sap-icon://money-bills" />
                                <core:Item key="Global Supply Chain &amp; Logistics" text="Global Supply Chain &amp; Logistics" icon="sap-icon://shipping-status" />
                                <core:Item key="Human Capital Management (HCM)" text="Human Capital Management (HCM)" icon="sap-icon://group" />
                                <core:Item key="Information Technology &amp; Security" text="Information Technology &amp; Security" icon="sap-icon://shield" />
                                <core:Item key="Customer Operations &amp; Sales" text="Customer Operations &amp; Sales" icon="sap-icon://customer-briefing" />
                            </Select>

                            <core:Title text="Business Function Alignment" />

                            <Label text="Business Function" required="true" />
                            <Select
                                id="businessFunctionSelect"
                                selectedKey="{addAccessModel>/function}"
                                items="{addAccessModel>/functionsList}"
                                width="100%"
                                class="fioriFormSelect">
                                <core:Item key="{addAccessModel>key}" text="{addAccessModel>text}" icon="{addAccessModel>icon}" />
                            </Select>
                        </form:content>
                    </form:SimpleForm>

                    <HBox justifyContent="End" class="sapUiSmallMarginTop">
                        <Button
                            text="Cancel"
                            type="Transparent"
                            press=".onNavBackToPortal"
                            class="sapUiTinyMarginEnd" />
                        <Button
                            text="Next"
                            type="Emphasized"
                            press=".onGoToStep2"
                            class="fioriEmphasizedBtn" />
                    </HBox>
                </VBox>

                <!-- STEP 2 CONTAINER: ADD ACCESS REQUEST (REGION, SYSTEMS, SERVICES, TEAM &amp; PERSONA) -->
                <VBox
                    visible="{addAccessModel>/step2Visible}"
                    class="fioriTableCard sapUiResponsivePadding sapUiSmallMarginBottom">
                    <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                        <Avatar src="sap-icon://system" backgroundColor="Accent2" displaySize="S" class="sapUiTinyMarginEnd" />
                        <VBox>
                            <Title text="Add Access Request" level="H4" />
                            <Text text="Configure region, multiple systems, services, team roles, and persona details." class="fioriDescriptionText" />
                        </VBox>
                    </HBox>

                    <form:SimpleForm
                        editable="true"
                        layout="ColumnLayout"
                        columnsM="2"
                        columnsL="2"
                        singleContainerFullWidth="false">
                        <form:content>
                            <core:Title text="Region and Systems Selection" />
                            
                            <Label text="Operating Region Selection" required="true" class="sapUiSmallMarginBottom" />
                            <VBox class="fioriMapCardOuter sapUiSmallMarginBottom">
                                <core:HTML content='&lt;div id="mapWrapperAddAccess" class="map-wrapper"&gt;
                                        &lt;img id="worldMapImgAddAccess" src="world-map.jpg" alt="World Map" class="world-map-img"&gt;
                                        &lt;div id="pinsLayerAddAccess" class="map-pins-layer"&gt;&lt;/div&gt;
                                        
                                        &lt;div id="selectAllBtnAddAccess" class="select-all-btn-wrapper"&gt;
                                          &lt;div class="select-all-icon"&gt;
                                            &lt;svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"&gt;
                                              &lt;path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5-2.5z"/&gt;
                                            &lt;/svg&gt;
                                          &lt;/div&gt;
                                          &lt;span class="select-all-text"&gt;Select All Regions&lt;/span&gt;
                                        &lt;/div&gt;
                                    &lt;/div&gt;'>
                                </core:HTML>
                            </VBox>

                            <VBox class="selected-regions-card-box sapUiSmallMarginBottom" alignContent="Center" alignItems="Center">
                                <Text text="SELECTED REGIONS" class="selected-regions-header" />
                                <HBox id="selectedChipsListAddAccess" items="{addAccessModel>/selectedRegionChips}" class="selected-chips-list" justifyContent="Center" wrap="Wrap">
                                    <Button 
                                        text="{addAccessModel>name}" 
                                        icon="sap-icon://decline" 
                                        iconFirst="false" 
                                        press=".onRemoveMapRegionChip"
                                        class="region-chip-btn sapUiTinyMarginEnd sapUiTinyMarginBottom" />
                                </HBox>
                                <Text text="No regions selected" class="no-selection-text" visible="{= !${addAccessModel>/hasRegionSelection} }" />
                            </VBox>

                            <Label text="Systems" required="true" />
                            <MultiComboBox
                                id="systemsMultiSelect"
                                selectedKeys="{addAccessModel>/selectedSystems}"
                                placeholder="Select one or multiple systems..."
                                width="100%"
                                class="fioriFormSelect">
                                <core:Item key="SAP BTP Cloud Platform" text="SAP BTP Cloud Platform" />
                                <core:Item key="SAP S/4HANA Enterprise" text="SAP S/4HANA Enterprise" />
                                <core:Item key="KYRA Central Governance" text="KYRA Central Governance" />
                                <core:Item key="Active Directory / IAM" text="Active Directory / IAM" />
                                <core:Item key="SAP SuccessFactors" text="SAP SuccessFactors" />
                                <core:Item key="SAP Ariba Supply Network" text="SAP Ariba Supply Network" />
                            </MultiComboBox>

                            <Label text="Services" required="true" />
                            <MultiComboBox
                                id="servicesMultiSelectStep2"
                                selectedKeys="{addAccessModel>/selectedServices}"
                                selectionChange=".onServicesSelectionChange"
                                placeholder="Select one or multiple services..."
                                width="100%"
                                class="fioriFormSelect">
                                <core:Item key="System Administrator" text="System Administrator" />
                                <core:Item key="System Owners" text="System Owners" />
                                <core:Item key="Stakeholders" text="Stakeholders" />
                            </MultiComboBox>

                            <Label text="Team" required="true" />
                            <MultiComboBox
                                id="teamMultiSelectStep2"
                                selectedKeys="{addAccessModel>/selectedRoles}"
                                selectionChange=".onTeamSelectionChange"
                                items="{addAccessModel>/subRolesList}"
                                placeholder="Select one or multiple team roles..."
                                width="100%"
                                class="fioriFormSelect">
                                <core:Item key="{addAccessModel>key}" text="{addAccessModel>text}" icon="{addAccessModel>icon}" />
                            </MultiComboBox>

                            <Label text="Persona" required="true" />
                            <MultiComboBox
                                id="personaMultiSelectStep2"
                                selectedKeys="{addAccessModel>/selectedPersonas}"
                                items="{addAccessModel>/personasList}"
                                placeholder="Select one or multiple personas..."
                                width="100%"
                                class="fioriFormSelect">
                                <core:Item key="{addAccessModel>key}" text="{addAccessModel>text}" icon="{addAccessModel>icon}" />
                            </MultiComboBox>

                            <core:Title text="Duration and Justification" />

                            <Label text="Access Duration" required="true" />
                            <Select
                                id="durationSelectStep2"
                                selectedKey="{addAccessModel>/duration}"
                                width="100%"
                                class="fioriFormSelect">
                                <core:Item key="" text="-- Select Access Duration --" />
                                <core:Item key="Permanent (Default)" text="Permanent (Default)" />
                                <core:Item key="30 Days (Temporary)" text="30 Days (Temporary)" />
                                <core:Item key="90 Days (Project)" text="90 Days (Project)" />
                            </Select>

                            <Label text="Business Justification" required="true" />
                            <TextArea
                                value="{addAccessModel>/justification}"
                                placeholder="Provide detailed justification for granting these system roles..."
                                rows="3"
                                width="100%" />
                        </form:content>
                    </form:SimpleForm>

                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginTop">
                        <Button
                            text="Back to Step 1"
                            icon="sap-icon://navigation-left-arrow"
                            type="Default"
                            press=".onBackToStep1" />
                        <HBox>
                            <Button
                                text="Cancel"
                                type="Transparent"
                                press=".onNavBackToPortal"
                                class="sapUiTinyMarginEnd" />
                            <Button
                                text="Next"
                                type="Emphasized"
                                press=".onGoToStep3Summary"
                                class="fioriEmphasizedBtn" />
                        </HBox>
                    </HBox>
                </VBox>

                <!-- STEP 3 CONTAINER: ACCESS REQUEST SUMMARY &amp; REVIEW PAGE -->
                <VBox
                    visible="{addAccessModel>/step3Visible}"
                    class="fioriTableCard sapUiResponsivePadding sapUiSmallMarginBottom">
                    <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                        <Avatar src="sap-icon://summary-detail" backgroundColor="Accent6" displaySize="S" class="sapUiTinyMarginEnd" />
                        <VBox>
                            <Title text="Access Request Summary and Review" level="H4" />
                            <Text text="Review all configured business governance details clearly before submitting." class="fioriDescriptionText" />
                        </VBox>
                    </HBox>

                    <!-- Itemized Access Request List Table (Formatted similar to Dashboard My Requests with Edit &amp; Remove) -->
                    <VBox class="fioriTableCard sapUiResponsivePadding sapUiSmallMarginBottom">
                        <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom">
                            <Title text="Configured Access Entitlements Review" level="H5" />
                            <Button
                                text="Edit"
                                icon="sap-icon://edit"
                                class="kyraSummaryEditBtn"
                                press=".onBackToStep2"
                                tooltip="Modify selected options in Step 2" />
                        </HBox>
                        <Table
                            id="summaryRequestsTable"
                            items="{addAccessModel>/summaryItems}"
                            noDataText="No access items remaining."
                            fixedLayout="true"
                            class="sapUiNoMargin">
                            <columns>
                                 <Column width="13%" hAlign="Begin"><Text text="Request ID" class="kyraEntitlementColHeader" /></Column>
                                 <Column width="15%" hAlign="Begin"><Text text="Target System" class="kyraEntitlementColHeader" /></Column>
                                 <Column width="21%" hAlign="Begin"><Text text="Role Title &amp; Sector" class="kyraEntitlementColHeader" /></Column>
                                 <Column width="15%" hAlign="Begin"><Text text="Persona" class="kyraEntitlementColHeader" /></Column>
                                 <Column width="12%" hAlign="Center"><Text text="Access Status" class="kyraEntitlementColHeader" /></Column>
                                 <Column width="11%" hAlign="Center"><Text text="Access Type" class="kyraEntitlementColHeader" /></Column>
                                 <Column width="7%" hAlign="Center"><Text text="Duration" class="kyraEntitlementColHeader" /></Column>
                                 <Column width="6%" hAlign="Center"><Text text="Actions" class="kyraEntitlementColHeader" /></Column>
                             </columns>
                             <items>
                                 <ColumnListItem vAlign="Middle">
                                     <cells>
                                         <ObjectIdentifier title="{addAccessModel>requestId}" />
                                         <Text text="{addAccessModel>system}" />
                                         <ObjectIdentifier title="{addAccessModel>roleName}" subtitle="{addAccessModel>sector}" />
                                         <Text text="{addAccessModel>persona}" />
                                         <ObjectStatus
                                             text="{addAccessModel>existingStatus}"
                                             state="{addAccessModel>existingState}"
                                             icon="{= ${addAccessModel>existingStatus} === 'Already Active' ? 'sap-icon://sys-enter-2' : 'sap-icon://pending' }" />
                                         <ObjectStatus
                                             text="{addAccessModel>accessType}"
                                             state="{= ${addAccessModel>accessType} === 'RESTRICTED' ? 'Warning' : 'Success' }"
                                             icon="{= ${addAccessModel>accessType} === 'RESTRICTED' ? 'sap-icon://alert' : 'sap-icon://sys-enter-2' }" />
                                         <Text text="{addAccessModel>duration}" />
                                         <HBox justifyContent="Center" alignItems="Center">
                                             <Button
                                                 icon="sap-icon://delete"
                                                 type="Reject"
                                                 press=".onRemoveSummaryItem"
                                                 tooltip="Remove this access item from request list" />
                                         </HBox>
                                     </cells>
                                 </ColumnListItem>
                             </items>
                         </Table>
                     </VBox>
 
                     <!-- Summary Full Governance &amp; Requester Information Card -->
                     <VBox class="fioriTableCard sapUiResponsivePadding" style="border-left: 4px solid #0066E8;">
                         <Title text="Full Access Governance &amp; Requester Details" level="H5" class="sapUiTinyMarginBottom" />
                         <HBox wrap="Wrap" class="sapUiTinyMarginTop">
                             <VBox width="25%" class="sapUiTinyMarginBottom">
                                 <Label text="Requester User ID" class="fioriFormLabel" />
                                 <Text text="{addAccessModel>/activeUser}" class="sapUiTinyMarginTop" style="font-weight: 600; color: #0066E8;" />
                             </VBox>
                             <VBox width="25%" class="sapUiTinyMarginBottom">
                                 <Label text="Requester Role Persona" class="fioriFormLabel" />
                                 <Text text="{addAccessModel>/activePersona}" class="sapUiTinyMarginTop" style="font-weight: 600;" />
                             </VBox>
                             <VBox width="25%" class="sapUiTinyMarginBottom">
                                 <Label text="Business Function" class="fioriFormLabel" />
                                 <Text text="{addAccessModel>/function}" class="sapUiTinyMarginTop" style="font-weight: 600;" />
                             </VBox>
                             <VBox width="25%" class="sapUiTinyMarginBottom">
                                 <Label text="Operating Region" class="fioriFormLabel" />
                                 <Text text="{addAccessModel>/region}" class="sapUiTinyMarginTop" style="font-weight: 600;" />
                             </VBox>
                             <VBox width="100%" class="sapUiTinyMarginBottom">
                                 <Label text="Business Justification" class="fioriFormLabel" />
                                 <Text text="{addAccessModel>/justification}" class="sapUiTinyMarginTop" style="font-style: italic;" />
                             </VBox>
                         </HBox>
                    </VBox>

                    <!-- Summary Down Side Action Buttons -->
                    <HBox justifyContent="End" alignItems="Center" class="sapUiSmallMarginTop">
                        <Button
                            text="Cancel Request"
                            type="Transparent"
                            press=".onNavBackToPortal"
                            class="sapUiTinyMarginEnd" />
                        <Button
                            text="Submit Access Request"
                            type="Emphasized"
                            icon="sap-icon://paper-plane"
                            press=".onFinalSubmitRequest"
                            enabled="{addAccessModel>/submitEnabled}"
                            class="fioriEmphasizedBtn" />
                    </HBox>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
