<mvc:View
    controllerName="kyra001.pages.login.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    
    <Page showHeader="false" enableScrolling="false" class="kyraDesktopLoginPage">
        <content>
            <!-- Ambient Background Effects (Cyber Mesh Grid, Glow Orbs, Subtle Watermark) -->
            <VBox class="kyraAmbientCanvasContainer" width="100%" height="100%">
                <HBox class="kyraCyberGridOverlay" />
                <HBox class="kyraAmbientOrb kyraAmbientOrb1" />
                <HBox class="kyraAmbientOrb kyraAmbientOrb2" />
                <HBox class="kyraAmbientOrb kyraAmbientOrb3" />
                <Image src="{login>/logoUrl}" densityAware="false" class="kyraWatermarkK" />
            </VBox>

            <FlexBox class="kyraLoginLayoutWrapper" direction="Row" wrap="Wrap" height="100%" width="100%">
                
                <!-- ================= LEFT SECTION (58% COLUMN - ZERO-TRUST CYBERSECURITY HUB) ================= -->
                <VBox class="kyraLoginLeftPanel" justifyContent="Start" alignItems="Stretch">
                    
                    <!-- Top Brand Logo (Clean & Proper) -->
                    <HBox alignItems="Center" class="kyraHeroBrandLogoContainer">
                        <Image src="{login>/logoUrl}" height="44px" densityAware="false" class="kyraHeroBrandLogoOnly" tooltip="KYRA Secure Access" />
                    </HBox>

                    <!-- Hero Typography & Core Value Proposition -->
                    <VBox class="kyraHeroMainContentBox">
                        <!-- Headline in One Single Line -->
                        <HBox alignItems="Baseline" class="kyraHeroHeadlineRow">
                            <Text text="Secure Access." class="kyraHeroTitleDark" />
                            <Text text="Total Control." class="kyraHeroTitleTeal" />
                        </HBox>
                        <HBox class="kyraHeroTealDashBar" />
                        <!-- Subtitle in Exactly Two Lines with 'provisioning, and' on first line -->
                        <VBox class="kyraHeroSubtitleContainer">
                            <Text 
                                text="Centralized enterprise identity governance, dynamic role entitlement provisioning, and" 
                                class="kyraHeroSubtitleLine kyraHeroSubtitleLine1" />
                            <FormattedText 
                                htmlText="continuous automated compliance across your &lt;strong class='kyraTealHighlight'&gt;hybrid cloud ecosystem.&lt;/strong&gt;" 
                                class="kyraHeroSubtitleLine kyraHeroSubtitleLine2" />
                        </VBox>
                    </VBox>

                    <!-- 3D Cyber Constellation Hub (All 5 Separate Icons Interactive Stage) -->
                    <VBox class="kyraCyberStageWrapper" alignItems="Center" justifyContent="Center" width="100%">
                        
                        <!-- Main 3D Interactive Stage Canvas -->
                        <HBox class="kyra3dStageCanvas" justifyContent="Center" alignItems="Center">
                            
                            <!-- Central Core 3D Shield -->
                            <VBox class="kyraCenterShieldNode" alignItems="Center" justifyContent="Center">
                                <Image 
                                    id="kyra3dShieldCenter"
                                    src="{login>/iconShieldUrl}"
                                    densityAware="false"
                                    class="kyra3dCenterShieldImg"
                                    tooltip="KYRA Zero-Trust Security Core" />
                                <HBox class="kyraCenterGlowAura" />
                            </VBox>

                            <!-- Node Top-Left: User Identity -->
                            <VBox class="kyraOrbitNode kyraNodeTopLeft" alignItems="Center">
                                <Image 
                                    src="{login>/iconUserUrl}"
                                    densityAware="false"
                                    class="kyra3dSatelliteImg"
                                    tooltip="Identity Governance" />
                                <Text text="Identity" class="kyraNodeBadgeLabel" />
                            </VBox>

                            <!-- Node Bottom-Left: Verified Compliance -->
                            <VBox class="kyraOrbitNode kyraNodeBottomLeft" alignItems="Center">
                                <Image 
                                    src="{login>/iconVerifiedUrl}"
                                    densityAware="false"
                                    class="kyra3dSatelliteImg"
                                    tooltip="Zero-Trust Compliance" />
                                <Text text="Zero-Trust" class="kyraNodeBadgeLabel" />
                            </VBox>

                            <!-- Node Top-Right: Cloud Infrastructure -->
                            <VBox class="kyraOrbitNode kyraNodeTopRight" alignItems="Center">
                                <Image 
                                    src="{login>/iconServerUrl}"
                                    densityAware="false"
                                    class="kyra3dSatelliteImg"
                                    tooltip="Cloud Gateway &amp; Servers" />
                                <Text text="Cloud Gateway" class="kyraNodeBadgeLabel" />
                            </VBox>

                            <!-- Node Bottom-Right: Continuous Analytics -->
                            <VBox class="kyraOrbitNode kyraNodeBottomRight" alignItems="Center">
                                <Image 
                                    src="{login>/iconAnalyticsUrl}"
                                    densityAware="false"
                                    class="kyra3dSatelliteImg"
                                    tooltip="Continuous Audit &amp; Risk" />
                                <Text text="Continuous Audit" class="kyraNodeBadgeLabel" />
                            </VBox>

                        </HBox>
                    </VBox>

                </VBox>

                <!-- ================= RIGHT SECTION (42% COLUMN - MODERN GLASSMORPHIC LOGIN CARD) ================= -->
                <VBox class="kyraLoginRightPanel" justifyContent="Center" alignItems="Center">
                    <VBox id="kyraLoginCardContainer" class="kyraLoginCardContainer">
                        
                        <!-- Top Card Header: Clean Logo Only + Wordmark -->
                        <VBox alignItems="Center" class="kyraCardHeaderBox">
                            
                            <!-- Clean Brand Logo Direct -->
                            <Image src="{login>/logoUrl}" height="48px" densityAware="false" class="kyraCardLogoImgDirect" tooltip="KYRA Secure Access" />

                            <Text text="KYRA" class="kyraCardBrandTitle" />
                            <Text text="ENTERPRISE ACCESS" class="kyraCardBrandSub" />
                            <Text text="Secure Identity Gateway" class="kyraCardPortalTitle" />
                            <Text text="Welcome back! Please sign in to continue." class="kyraCardWelcomeText" />
                        </VBox>

                        <!-- Enterprise Sleek Inline Error Banner (Dismissable, Never Obscures Sign In Button) -->
                        <HBox
                            id="kyraLoginErrorBanner"
                            visible="{login>/hasError}"
                            alignItems="Center"
                            justifyContent="SpaceBetween"
                            class="kyraCustomErrorBanner sapUiTinyMarginBottom">
                            <HBox alignItems="Center" class="kyraErrorLeftGroup">
                                <HBox class="kyraErrorIconBadge" alignItems="Center" justifyContent="Center">
                                    <core:Icon src="sap-icon://alert" class="kyraErrorBadgeIcon" />
                                </HBox>
                                <VBox class="kyraErrorTextGroup sapUiTinyMarginBegin">
                                    <Text text="Authentication Failed" class="kyraErrorTitle" />
                                    <Text text="{login>/errorMessage}" class="kyraErrorMessage" />
                                </VBox>
                            </HBox>
                            <Button
                                icon="sap-icon://decline"
                                type="Transparent"
                                press=".onDismissError"
                                class="kyraErrorCloseBtn"
                                tooltip="Dismiss error" />
                        </HBox>

                        <!-- Form Controls Container -->
                        <VBox width="100%" class="kyraLoginFormBody">
                            
                            <!-- Persona Dropdown -->
                            <VBox class="kyraFormGroup" width="100%">
                                <HBox alignItems="Center" class="kyraLabelRow">
                                    <core:Icon src="sap-icon://role" class="kyraLabelIcon" />
                                    <Label text="Persona" labelFor="roleSelect" class="kyraFormLabel" />
                                </HBox>
                                <Select
                                    id="roleSelect"
                                    selectedKey="{login>/selectedRole}"
                                    change=".onRoleChange"
                                    forceSelection="true"
                                    width="100%"
                                    class="kyraModernSelect kyraSelectPlaceholderState">
                                    <items>
                                        <core:Item key="" text="Select persona" />
                                        <core:Item key="Requester" text="Requester" icon="sap-icon://customer" />
                                        <core:Item key="Approver" text="Approver" icon="sap-icon://shield" />
                                        <core:Item key="Compliance Review" text="Compliance Review" icon="sap-icon://user-settings" />
                                    </items>
                                </Select>
                            </VBox>

                            <!-- Dynamic ID Input Field -->
                            <VBox class="kyraFormGroup" width="100%">
                                <HBox alignItems="Center" class="kyraLabelRow">
                                    <core:Icon src="sap-icon://employee" class="kyraLabelIcon" />
                                    <Label text="{login>/idLabel}" labelFor="idInput" class="kyraFormLabel" />
                                </HBox>
                                <Input
                                    id="idInput"
                                    value="{login>/userId}"
                                    placeholder="{login>/idPlaceholder}"
                                    valueState="{login>/idState}"
                                    showValueStateMessage="false"
                                    liveChange=".onInputChange"
                                    change=".onInputChange"
                                    submit=".onLogin"
                                    showClearButton="true"
                                    class="kyraModernInput"
                                    width="100%" />
                            </VBox>

                            <!-- Full Width Solid Vibrant Teal Sign In Button with Arrow & Shine -->
                            <Button
                                id="signInButton"
                                text="Sign In"
                                icon="sap-icon://navigation-right-arrow"
                                iconFirst="false"
                                type="Emphasized"
                                width="100%"
                                press=".onLogin"
                                busy="{login>/isBusy}"
                                class="kyraPrimarySignInBtn" />

                        </VBox>
                    </VBox>
                </VBox>

            </FlexBox>
        </content>
    </Page>
</mvc:View>