<mvc:View
    controllerName="kyra001.pages.Approver.Approver"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core">

    <VBox class="sapUiNoContentPadding">

        <!-- SECTION 2: USER REQUESTS BOX &amp; HISTORY LOG -->
        <VBox
            visible="true"
            class="kyraApproverCard sapUiNoMargin">
            
            <!-- ROW 1: HEADER (Left: Avatar, Title, Subtitle with teal bar | Right: Solid Kyra Teal Segmented Pill Buttons) -->
            <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="kyraApproverTopRow">
                <!-- LEFT: Avatar + Title & Subtitle with vertical accent bar -->
                <HBox alignItems="Center" class="kyraCardHeaderLeft">
                    <Avatar src="sap-icon://user-edit" class="kyraMasterViewAvatar kyraSquircleAvatar sapUiSmallMarginEnd" displaySize="S" />
                    <VBox class="kyraCardHeaderTextCol">
                        <Title text="{= ${accessModel>/showApprovalHistory} ? 'Processed Approval History Log' : 'User Requests' }" level="H4" class="fioriApproverTitle kyraCardHeaderTitle" />
                        <Text text="{= ${accessModel>/showApprovalHistory} ? 'Audit history of all previously approved, rejected, and cancelled access requests.' : 'Select any request row below to open the dedicated full summary review page.' }" class="fioriDescriptionText kyraSubtitleWithTealBar" />
                    </VBox>
                </HBox>

                <!-- RIGHT: Pending (7) and History (7) Pill Buttons (Solid Kyra Teal #008C9C on selected) -->
                <HBox class="kyraApproverPillGroup" alignItems="Center">
                    <Button
                        icon="sap-icon://time-entry-request"
                        text="{= 'Pending (' + ((${accessModel>/pendingRequests} || []).length) + ')' }"
                        type="{= !${accessModel>/showApprovalHistory} ? 'Emphasized' : 'Transparent' }"
                        press=".onSelectPendingQueue"
                        tooltip="Pending Queue"
                        class="kyraApproverPillBtn" />
                    <Button
                        icon="sap-icon://history"
                        text="{= 'History (' + ((${accessModel>/processedRequests} || []).length) + ')' }"
                        type="{= ${accessModel>/showApprovalHistory} ? 'Emphasized' : 'Transparent' }"
                        press=".onSelectHistoryLog"
                        tooltip="Processed History"
                        class="kyraApproverPillBtn" />
                </HBox>
            </HBox>

            <!-- ROW 2: SUB-TOOLBAR (Left: Access & Revoke Segmented tabs | Right: Search, Filter, Export) -->
            <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="kyraApproverSubToolbar">
                <!-- LEFT: Access & Revoke tab buttons (Solid Kyra Teal #008C9C on selected) -->
                <HBox visible="{= !${accessModel>/isCompliance} || !${accessModel>/showApprovalHistory} }" class="{= ${accessModel>/isCompliance} ? 'kyraAccessRevokeBar kyraSingleAccessBar' : 'kyraAccessRevokeBar' }" alignItems="Center">
                    <Button
                        text="{= 'Access (' + (${accessModel>/showApprovalHistory} ? (${accessModel>/historyAccessCount} || 0) : (${accessModel>/pendingAccessCount} || 0)) + ')' }"
                        icon="sap-icon://key"
                        type="{= (${accessModel>/showApprovalHistory} ? (${accessModel>/approverHistoryTab} || 'accessRequests') : (${accessModel>/approverPendingTab} || 'accessRequests')) === 'accessRequests' ? 'Emphasized' : 'Transparent' }"
                        press=".onSelectAccessRequestsTab"
                        tooltip="{= ${accessModel>/showApprovalHistory} ? 'History Access Requests' : 'Pending Access Requests' }"
                        class="{= ${accessModel>/isCompliance} ? 'kyraTabPillBtn kyraStaticPillBtn' : 'kyraTabPillBtn' }" />
                    <Button
                        visible="{= !${accessModel>/isCompliance} }"
                        text="{= 'Revoke (' + (${accessModel>/showApprovalHistory} ? (${accessModel>/historyRevokeCount} || 0) : (${accessModel>/pendingRevokeCount} || 0)) + ')' }"
                        icon="sap-icon://delete"
                        type="{= (${accessModel>/showApprovalHistory} ? (${accessModel>/approverHistoryTab} || 'accessRequests') : (${accessModel>/approverPendingTab} || 'accessRequests')) === 'revokeRequests' ? 'Emphasized' : 'Transparent' }"
                        press=".onSelectRevokeRequestsTab"
                        tooltip="{= ${accessModel>/showApprovalHistory} ? 'History Revocation Requests' : 'Pending Revocation Requests' }"
                        class="kyraTabPillBtn" />
                </HBox>

                <!-- RIGHT: Search, Filter, Export Controls -->
                <HBox alignItems="Center" class="kyraApproverRightControls">
                    <SearchField
                        placeholder="Search request..."
                        width="210px"
                        liveChange=".onSearchApprovalTable"
                        class="kyraEntitlementsSearchField" />
                    
                    <Button
                        icon="sap-icon://filter"
                        type="Transparent"
                        press=".onFilterApprovalsDialog"
                        tooltip="Filter Requests"
                        class="kyraHistoryExportBtn" />

                    <Button
                        icon="sap-icon://excel-attachment"
                        type="Transparent"
                        press=".onExportApprovals"
                        tooltip="Export Audit Log"
                        class="kyraHistoryExportBtn" />
                </HBox>
            </HBox>

            <!-- CLASSIFICATIONS CONTENT -->
            <VBox visible="{= !${accessModel>/showApprovalHistory} }" class="sapUiNoMargin">

                <!-- CLASSIFICATION 1: ACCESS REQUESTS -->
                <Table
                    id="approvalAccessTable"
                    visible="{= (${accessModel>/approverPendingTab} || 'accessRequests') === 'accessRequests' }"
                    items="{accessModel>/pendingAccessRequests}"
                    noDataText="No pending access requests in queue."
                    fixedLayout="true"
                    popinLayout="GridSmall"
                    class="sapUiNoMargin kyraApproverTable kyraActiveEntitlementsTable">
                    <columns>
                        <Column width="12%" hAlign="Begin"><Text text="USER ID" class="kyraEntitlementColHeader" /></Column>
                        <Column width="24%" minScreenWidth="Tablet" demandPopin="true" hAlign="Begin"><Text text="Business Sector" class="kyraEntitlementColHeader" /></Column>
                        <Column width="24%" minScreenWidth="Tablet" demandPopin="true" hAlign="Begin"><Text text="Business Function" class="kyraEntitlementColHeader" /></Column>
                        <Column width="14%" minScreenWidth="Desktop" demandPopin="true" hAlign="Center"><Text text="Duration" class="kyraEntitlementColHeader kyraColHeadCenter" /></Column>
                        <Column width="12%" minScreenWidth="Desktop" demandPopin="true" hAlign="Center"><Text text="SUBMISSION DATE" class="kyraEntitlementColHeader kyraColHeadCenter" /></Column>
                        <Column width="14%" hAlign="Center"><Text text="APPROVAL STATUS" class="kyraEntitlementColHeader kyraColHeadCenter" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Navigation" press=".onOpenRequestSummaryDialog" vAlign="Middle" class="kyraApproverRowItem kyraTableRow">
                            <cells>
                                <Text text="{accessModel>requesterId}" class="kyraUserIdText kyraCellText" />
                                <Text text="{= (${accessModel>businessSector} &amp;&amp; ${accessModel>businessSector} !== '—' &amp;&amp; ${accessModel>businessSector} !== '–' &amp;&amp; ${accessModel>businessSector} !== '-') ? ${accessModel>businessSector} : ((${accessModel>sector} &amp;&amp; ${accessModel>sector} !== '—' &amp;&amp; ${accessModel>sector} !== '–' &amp;&amp; ${accessModel>sector} !== '-') ? ${accessModel>sector} : 'Information Technology &amp; Security') }" wrapping="true" class="kyraSectorText kyraCellText" />
                                <Text text="{= (${accessModel>businessFunction} &amp;&amp; ${accessModel>businessFunction} !== '—' &amp;&amp; ${accessModel>businessFunction} !== '–' &amp;&amp; ${accessModel>businessFunction} !== '-') ? ${accessModel>businessFunction} : ((${accessModel>function} &amp;&amp; ${accessModel>function} !== '—' &amp;&amp; ${accessModel>function} !== '–' &amp;&amp; ${accessModel>function} !== '-') ? ${accessModel>function} : 'Corporate Governance') }" wrapping="true" class="kyraFunctionText kyraCellText" />
                                <HBox justifyContent="Center" alignItems="Center" width="100%">
                                    <Text text="{= (${accessModel>duration} &amp;&amp; ${accessModel>duration} !== '—' &amp;&amp; ${accessModel>duration} !== '–' &amp;&amp; ${accessModel>duration} !== '-') ? ${accessModel>duration} : ((${accessModel>accessDuration} &amp;&amp; ${accessModel>accessDuration} !== '—' &amp;&amp; ${accessModel>accessDuration} !== '–' &amp;&amp; ${accessModel>accessDuration} !== '-') ? ${accessModel>accessDuration} : 'Permanent') }" class="kyraCellTextCenter" />
                                </HBox>
                                <HBox justifyContent="Center" alignItems="Center" width="100%">
                                    <Text text="{accessModel>submissionDate}" class="kyraDateText kyraCellTextCenter" />
                                </HBox>
                                <HBox justifyContent="Center" alignItems="Center" width="100%">
                                    <ObjectStatus text="{accessModel>status}" state="{accessModel>statusState}" icon="{= ${accessModel>statusIcon} || (${accessModel>status} === 'Approved' || ${accessModel>status} === 'Active' ? 'sap-icon://sys-enter-2' : (${accessModel>status} === 'Rejected' ? 'sap-icon://error' : 'sap-icon://history')) }" class="kyraTableStatusBadge kyraApproverStatusBadge" />
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <!-- CLASSIFICATION 2: REVOCATION REQUESTS -->
                <Table
                    id="approvalRevokeTable"
                    visible="{= !${accessModel>/isCompliance} &amp;&amp; ${accessModel>/approverPendingTab} === 'revokeRequests' }"
                    items="{accessModel>/pendingRevokeRequests}"
                    noDataText="No pending revocation requests in queue."
                    fixedLayout="true"
                    popinLayout="GridSmall"
                    class="sapUiNoMargin kyraApproverTable kyraActiveEntitlementsTable">
                    <columns>
                        <Column width="12%" hAlign="Begin"><Text text="USER ID" class="kyraEntitlementColHeader" /></Column>
                        <Column width="24%" minScreenWidth="Tablet" demandPopin="true" hAlign="Begin"><Text text="Business Sector" class="kyraEntitlementColHeader" /></Column>
                        <Column width="24%" minScreenWidth="Tablet" demandPopin="true" hAlign="Begin"><Text text="Business Function" class="kyraEntitlementColHeader" /></Column>
                        <Column width="14%" minScreenWidth="Desktop" demandPopin="true" hAlign="Center"><Text text="Duration" class="kyraEntitlementColHeader kyraColHeadCenter" /></Column>
                        <Column width="12%" minScreenWidth="Desktop" demandPopin="true" hAlign="Center"><Text text="SUBMISSION DATE" class="kyraEntitlementColHeader kyraColHeadCenter" /></Column>
                        <Column width="14%" hAlign="Center"><Text text="APPROVAL STATUS" class="kyraEntitlementColHeader kyraColHeadCenter" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Navigation" press=".onOpenRequestSummaryDialog" vAlign="Middle" class="kyraApproverRowItem kyraTableRow">
                            <cells>
                                <Text text="{accessModel>requesterId}" class="kyraUserIdText kyraCellText" />
                                <Text text="{= (${accessModel>businessSector} &amp;&amp; ${accessModel>businessSector} !== '—' &amp;&amp; ${accessModel>businessSector} !== '–' &amp;&amp; ${accessModel>businessSector} !== '-') ? ${accessModel>businessSector} : ((${accessModel>sector} &amp;&amp; ${accessModel>sector} !== '—' &amp;&amp; ${accessModel>sector} !== '–' &amp;&amp; ${accessModel>sector} !== '-') ? ${accessModel>sector} : 'Information Technology &amp; Security') }" wrapping="true" class="kyraSectorText kyraCellText" />
                                <Text text="{= (${accessModel>businessFunction} &amp;&amp; ${accessModel>businessFunction} !== '—' &amp;&amp; ${accessModel>businessFunction} !== '–' &amp;&amp; ${accessModel>businessFunction} !== '-') ? ${accessModel>businessFunction} : ((${accessModel>function} &amp;&amp; ${accessModel>function} !== '—' &amp;&amp; ${accessModel>function} !== '–' &amp;&amp; ${accessModel>function} !== '-') ? ${accessModel>function} : 'Corporate Governance') }" wrapping="true" class="kyraFunctionText kyraCellText" />
                                <HBox justifyContent="Center" alignItems="Center" width="100%">
                                    <Text text="{= (${accessModel>duration} &amp;&amp; ${accessModel>duration} !== '—' &amp;&amp; ${accessModel>duration} !== '–' &amp;&amp; ${accessModel>duration} !== '-') ? ${accessModel>duration} : ((${accessModel>accessDuration} &amp;&amp; ${accessModel>accessDuration} !== '—' &amp;&amp; ${accessModel>accessDuration} !== '–' &amp;&amp; ${accessModel>accessDuration} !== '-') ? ${accessModel>accessDuration} : 'Permanent') }" class="kyraCellTextCenter" />
                                </HBox>
                                <HBox justifyContent="Center" alignItems="Center" width="100%">
                                    <Text text="{accessModel>submissionDate}" class="kyraDateText kyraCellTextCenter" />
                                </HBox>
                                <HBox justifyContent="Center" alignItems="Center" width="100%">
                                    <ObjectStatus text="{accessModel>status}" state="{accessModel>statusState}" icon="{= ${accessModel>statusIcon} || (${accessModel>status} === 'Approved' || ${accessModel>status} === 'Active' ? 'sap-icon://sys-enter-2' : (${accessModel>status} === 'Rejected' ? 'sap-icon://error' : 'sap-icon://history')) }" class="kyraTableStatusBadge kyraApproverStatusBadge" />
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>

            <!-- SECTION 3: PROCESSED APPROVAL HISTORY LOG -->
            <Table
                id="approvalHistoryTable"
                visible="{= ${accessModel>/showApprovalHistory} === true }"
                items="{accessModel>/displayedHistoryRequests}"
                noDataText="{= ${accessModel>/isCompliance} ? 'No processed approval history available.' : ((${accessModel>/approverHistoryTab} || 'accessRequests') === 'revokeRequests' ? 'No processed revocation history available.' : 'No processed access history available.') }"
                fixedLayout="true"
                popinLayout="GridSmall"
                class="sapUiNoMargin kyraApproverTable kyraActiveEntitlementsTable">
                <columns>
                    <Column width="11%" hAlign="Begin"><Text text="USER ID" class="kyraEntitlementColHeader" /></Column>
                    <Column width="22%" minScreenWidth="Tablet" demandPopin="true" hAlign="Begin"><Text text="Business Sector" class="kyraEntitlementColHeader" /></Column>
                    <Column width="22%" minScreenWidth="Tablet" demandPopin="true" hAlign="Begin"><Text text="Business Function" class="kyraEntitlementColHeader" /></Column>
                    <Column width="12%" minScreenWidth="Desktop" demandPopin="true" hAlign="Center"><Text text="Duration" class="kyraEntitlementColHeader kyraColHeadCenter" /></Column>
                    <Column width="11%" minScreenWidth="Desktop" demandPopin="true" hAlign="Center"><Text text="DECISION DATE" class="kyraEntitlementColHeader kyraColHeadCenter" /></Column>
                    <Column width="12%" hAlign="Center"><Text text="FINAL DECISION" class="kyraEntitlementColHeader kyraColHeadCenter" /></Column>
                    <Column width="10%" hAlign="Center"><Text text="BREAKDOWN" class="kyraEntitlementColHeader kyraColHeadCenter" /></Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle" class="kyraApproverRowItem kyraTableRow">
                        <cells>
                            <Text text="{accessModel>requesterId}" class="kyraUserIdText kyraCellText" />
                            <Text text="{= (${accessModel>businessSector} &amp;&amp; ${accessModel>businessSector} !== '—' &amp;&amp; ${accessModel>businessSector} !== '–' &amp;&amp; ${accessModel>businessSector} !== '-') ? ${accessModel>businessSector} : ((${accessModel>sector} &amp;&amp; ${accessModel>sector} !== '—' &amp;&amp; ${accessModel>sector} !== '–' &amp;&amp; ${accessModel>sector} !== '-') ? ${accessModel>sector} : 'Information Technology &amp; Security') }" wrapping="true" class="kyraSectorText kyraCellText" />
                            <Text text="{= (${accessModel>businessFunction} &amp;&amp; ${accessModel>businessFunction} !== '—' &amp;&amp; ${accessModel>businessFunction} !== '–' &amp;&amp; ${accessModel>businessFunction} !== '-') ? ${accessModel>businessFunction} : ((${accessModel>function} &amp;&amp; ${accessModel>function} !== '—' &amp;&amp; ${accessModel>function} !== '–' &amp;&amp; ${accessModel>function} !== '-') ? ${accessModel>function} : 'Corporate Governance') }" wrapping="true" class="kyraFunctionText kyraCellText" />
                            <HBox justifyContent="Center" alignItems="Center" width="100%">
                                <Text text="{= (${accessModel>duration} &amp;&amp; ${accessModel>duration} !== '—' &amp;&amp; ${accessModel>duration} !== '–' &amp;&amp; ${accessModel>duration} !== '-') ? ${accessModel>duration} : ((${accessModel>accessDuration} &amp;&amp; ${accessModel>accessDuration} !== '—' &amp;&amp; ${accessModel>accessDuration} !== '–' &amp;&amp; ${accessModel>accessDuration} !== '-') ? ${accessModel>accessDuration} : 'Permanent') }" class="kyraCellTextCenter" />
                            </HBox>
                            <HBox justifyContent="Center" alignItems="Center" width="100%">
                                <Text text="{accessModel>decisionDate}" class="kyraDateText kyraCellTextCenter" />
                            </HBox>
                            <HBox justifyContent="Center" alignItems="Center" width="100%">
                                <ObjectStatus
                                    text="{accessModel>status}"
                                    state="{accessModel>statusState}"
                                    icon="{= ${accessModel>statusIcon} || (${accessModel>status} === 'Approved' || ${accessModel>status} === 'Active' ? 'sap-icon://sys-enter-2' : (${accessModel>status} === 'Rejected' ? 'sap-icon://error' : 'sap-icon://history')) }"
                                    class="kyraTableStatusBadge kyraApproverStatusBadge" />
                            </HBox>
                            <HBox justifyContent="Center" alignItems="Center" width="100%">
                                <Button
                                    text="View"
                                    icon="sap-icon://hint"
                                    type="Transparent"
                                    press=".onOpenDecisionBreakdownDialog"
                                    tooltip="View Approved and Rejected Details"
                                    class="kyraBreakdownViewBtn kyraTableActionBtn" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </VBox>
</mvc:View>
