<mvc:View
    controllerName="kyra001.pages.access.AccessPage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true">

    <Page showHeader="false" enableScrolling="true" class="fioriDashboardBg">
        <content>
            <!-- Enterprise Access ShellBar Header -->
            <f:ShellBar
                title="KYRA Enterprise"
                secondTitle="User Access Management Portal"
                homeIcon="sap-icon://shield"
                showCopilot="false"
                showSearch="false"
                showNotifications="true"
                notificationsNumber="4">
                <f:profile>
                    <Avatar initials="ADM" backgroundColor="Accent1" />
                </f:profile>
                <f:additionalContent>
                    <Button
                        icon="sap-icon://log-out"
                        text="Sign Out"
                        type="Transparent"
                        press=".onLogout"
                        tooltip="Sign Out" />
                </f:additionalContent>
            </f:ShellBar>

            <!-- Main Content Area -->
            <VBox class="sapUiResponsiveMargin">
                <!-- Welcome Banner Card -->
                <VBox class="fioriWelcomeCard sapUiSmallMarginBottom sapUiResponsivePadding">
                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                        <VBox>
                            <Title text="{accessModel>/userWelcomeTitle}" level="H2" class="fioriWelcomeTitle" />
                            <Text text="Enterprise Identity &amp; Access Governance  •  Role: {accessModel>/activeRole}" class="fioriWelcomeSubtitle" />
                        </VBox>
                        <HBox alignItems="Center">
                            <ObjectStatus
                                title="Access Status"
                                text="100% Compliant"
                                state="Success"
                                icon="sap-icon://sys-enter-2"
                                class="sapUiSmallMarginEnd" />
                            <Button
                                icon="sap-icon://refresh"
                                type="Transparent"
                                press=".onRefreshAccess"
                                tooltip="Refresh Access Data" />
                        </HBox>
                    </HBox>
                </VBox>

                <!-- Access Management Sectors: Add Access, Remove Access, My Access, My Requests -->
                <IconTabBar id="accessIconTabBar" select=".onTabSelect" class="sapUiNoContentPadding sapUiSmallMarginBottom">
                    <items>
                        <!-- SECTOR 1: ADD ACCESS -->
                        <IconTabFilter text="Add Access" icon="sap-icon://add" key="addAccess">
                            <VBox class="fioriTableCard sapUiResponsivePadding">
                                <Title text="Grant / Add New Access Request" level="H4" class="sapUiSmallMarginBottom" />
                                <Text text="Select target system, category, and role to submit a new access request for approval." class="sapUiSmallMarginBottom" />

                                <form:SimpleForm
                                    editable="true"
                                    layout="ColumnLayout"
                                    columnsM="2"
                                    columnsL="2"
                                    singleContainerFullWidth="false">
                                    <form:content>
                                        <core:Title text="Target System &amp; Role Selection" />
                                        
                                        <Label text="Target System" />
                                        <Select
                                            id="targetSystemSelect"
                                            selectedKey="{accessModel>/newRequest/system}"
                                            width="100%"
                                            class="fioriFormSelect">
                                            <core:Item key="SAP BTP Cloud Platform" text="SAP BTP Cloud Platform" icon="sap-icon://cloud" />
                                            <core:Item key="SAP S/4HANA Enterprise" text="SAP S/4HANA Enterprise" icon="sap-icon://database" />
                                            <core:Item key="KYRA Central Governance" text="KYRA Central Governance" icon="sap-icon://shield" />
                                            <core:Item key="Active Directory / IAM" text="Active Directory / IAM" icon="sap-icon://group" />
                                        </Select>

                                        <Label text="Admin Category" />
                                        <Select
                                            id="adminCategorySelect"
                                            selectedKey="{accessModel>/newRequest/category}"
                                            change=".onCategoryChange"
                                            width="100%"
                                            class="fioriFormSelect">
                                            <core:Item key="System Administrator" text="System Administrator" icon="sap-icon://shield" />
                                            <core:Item key="System Owners" text="System Owners" icon="sap-icon://user-settings" />
                                            <core:Item key="Stakeholders" text="Stakeholders" icon="sap-icon://manager" />
                                        </Select>

                                        <Label text="Requested Role" />
                                        <Select
                                            id="requestedRoleSelect"
                                            selectedKey="{accessModel>/newRequest/roleName}"
                                            items="{accessModel>/requestSubRoles}"
                                            width="100%"
                                            class="fioriFormSelect">
                                            <core:Item key="{accessModel>key}" text="{accessModel>text}" icon="{accessModel>icon}" />
                                        </Select>

                                        <core:Title text="Duration &amp; Business Reason" />

                                        <Label text="Access Duration" />
                                        <Select
                                            id="durationSelect"
                                            selectedKey="{accessModel>/newRequest/duration}"
                                            width="100%"
                                            class="fioriFormSelect">
                                            <core:Item key="Permanent (Default)" text="Permanent (Default)" />
                                            <core:Item key="30 Days (Temporary)" text="30 Days (Temporary)" />
                                            <core:Item key="90 Days (Project)" text="90 Days (Project)" />
                                        </Select>

                                        <Label text="Business Justification" />
                                        <TextArea
                                            value="{accessModel>/newRequest/justification}"
                                            placeholder="Enter detailed business reason for adding access..."
                                            rows="4"
                                            width="100%" />
                                    </form:content>
                                </form:SimpleForm>

                                <HBox justifyContent="End" class="sapUiSmallMarginTop">
                                    <Button
                                        text="Clear Form"
                                        type="Transparent"
                                        press=".onClearRequestForm"
                                        class="sapUiTinyMarginEnd" />
                                    <Button
                                        text="Submit Add Access Request"
                                        type="Emphasized"
                                        icon="sap-icon://paper-plane"
                                        press=".onAddAccessSubmit"
                                        class="fioriEmphasizedBtn" />
                                </HBox>
                            </VBox>
                        </IconTabFilter>

                        <!-- SECTOR 2: REMOVE ACCESS -->
                        <IconTabFilter text="Remove Access" icon="sap-icon://delete" key="removeAccess">
                            <VBox class="fioriTableCard sapUiResponsivePadding">
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                                    <VBox>
                                        <Title text="Revoke / Remove Access Entitlements" level="H4" />
                                        <Text text="Select any active access entitlement below to initiate a revocation request." class="fioriDescriptionText" />
                                    </VBox>
                                </HBox>

                                <Table
                                    id="removeAccessTable"
                                    items="{accessModel>/activeRoles}"
                                    noDataText="No active entitlements available for removal."
                                    class="sapUiNoMargin">
                                    <columns>
                                        <Column><Text text="System Name" /></Column>
                                        <Column><Text text="Role Title" /></Column>
                                        <Column><Text text="Category" /></Column>
                                        <Column><Text text="Granted Date" /></Column>
                                        <Column><Text text="Status" /></Column>
                                        <Column hAlign="Center"><Text text="Action" /></Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem vAlign="Middle">
                                            <cells>
                                                <Text text="{accessModel>system}" />
                                                <ObjectIdentifier title="{accessModel>roleName}" subtitle="{accessModel>roleId}" />
                                                <Text text="{accessModel>category}" />
                                                <Text text="{accessModel>grantedDate}" />
                                                <ObjectStatus
                                                    text="{accessModel>status}"
                                                    state="{accessModel>statusState}"
                                                    icon="{accessModel>statusIcon}" />
                                                <HBox justifyContent="Center">
                                                    <Button
                                                        text="{accessModel>removeButtonText}"
                                                        icon="{accessModel>removeButtonIcon}"
                                                        type="{accessModel>removeButtonType}"
                                                        enabled="{accessModel>removeButtonEnabled}"
                                                        press=".onRemoveAccessClick"
                                                        tooltip="Revoke Access" />
                                                </HBox>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </VBox>
                        </IconTabFilter>

                        <!-- SECTOR 3: MY ACCESS -->
                        <IconTabFilter text="My Access" icon="sap-icon://user-settings" key="myAccess">
                            <VBox class="fioriTableCard sapUiResponsivePadding">
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                                    <VBox>
                                        <Title text="My Active Access Roles &amp; Permissions" level="H4" />
                                        <Text text="Comprehensive directory of all your currently granted system entitlements." class="fioriDescriptionText" />
                                    </VBox>
                                    <HBox alignItems="Center">
                                        <SearchField
                                            placeholder="Search my access..."
                                            width="260px"
                                            liveChange=".onSearchMyAccess"
                                            class="sapUiTinyMarginEnd" />
                                        <Button
                                            icon="sap-icon://excel-attachment"
                                            press=".onExportAccess"
                                            tooltip="Export to CSV" />
                                    </HBox>
                                </HBox>

                                <Table
                                    id="myAccessTable"
                                    items="{accessModel>/activeRoles}"
                                    noDataText="No active permissions found."
                                    class="sapUiNoMargin">
                                    <columns>
                                        <Column><Text text="System Name" /></Column>
                                        <Column><Text text="Role Title" /></Column>
                                        <Column><Text text="Category" /></Column>
                                        <Column><Text text="Granted Date" /></Column>
                                        <Column><Text text="Expiry Date" /></Column>
                                        <Column><Text text="Status" /></Column>
                                        <Column hAlign="Center"><Text text="Details" /></Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem vAlign="Middle">
                                            <cells>
                                                <Text text="{accessModel>system}" />
                                                <ObjectIdentifier title="{accessModel>roleName}" subtitle="{accessModel>roleId}" />
                                                <Text text="{accessModel>category}" />
                                                <Text text="{accessModel>grantedDate}" />
                                                <Text text="{accessModel>expiryDate}" />
                                                <ObjectStatus
                                                    text="{accessModel>status}"
                                                    state="{accessModel>statusState}"
                                                    icon="{accessModel>statusIcon}" />
                                                <HBox justifyContent="Center">
                                                    <Button
                                                        text="View Details"
                                                        icon="sap-icon://hint"
                                                        type="Default"
                                                        press=".onViewRoleDetails"
                                                        tooltip="View Role Details" />
                                                </HBox>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </VBox>
                        </IconTabFilter>

                        <!-- SECTOR 4: MY REQUESTS -->
                        <IconTabFilter text="My Requests" icon="sap-icon://history" key="myRequests">
                            <VBox class="fioriTableCard sapUiResponsivePadding">
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                                    <VBox>
                                        <Title text="My Submitted Access Requests &amp; Audit Trail" level="H4" />
                                        <Text text="Real-time status tracking for all your access addition and revocation requests." class="fioriDescriptionText" />
                                    </VBox>
                                    <HBox alignItems="Center">
                                        <SearchField
                                            placeholder="Search request ID or role..."
                                            width="260px"
                                            liveChange=".onSearchRequests"
                                            class="sapUiTinyMarginEnd" />
                                        <Button
                                            icon="sap-icon://excel-attachment"
                                            press=".onExportRequests"
                                            tooltip="Export Audit Log" />
                                    </HBox>
                                </HBox>

                                <Table
                                    id="myRequestsTable"
                                    items="{accessModel>/requestHistory}"
                                    noDataText="No request history available."
                                    class="sapUiNoMargin">
                                    <columns>
                                        <Column><Text text="Request ID" /></Column>
                                        <Column><Text text="Request Type" /></Column>
                                        <Column><Text text="Target System" /></Column>
                                        <Column><Text text="Role Title" /></Column>
                                        <Column><Text text="Submitted Date" /></Column>
                                        <Column><Text text="Approver" /></Column>
                                        <Column><Text text="Approval Status" /></Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem vAlign="Middle">
                                            <cells>
                                                <ObjectIdentifier title="{accessModel>requestId}" />
                                                <ObjectStatus
                                                    text="{accessModel>type}"
                                                    state="{= ${accessModel>type} === 'Revocation' ? 'Error' : 'None' }" />
                                                <Text text="{accessModel>system}" />
                                                <Text text="{accessModel>roleName}" />
                                                <Text text="{accessModel>submissionDate}" />
                                                <Text text="{accessModel>approver}" />
                                                <ObjectStatus
                                                    text="{accessModel>status}"
                                                    state="{accessModel>statusState}"
                                                    icon="{accessModel>statusIcon}" />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </VBox>
                        </IconTabFilter>
                    </items>
                </IconTabBar>
            </VBox>
        </content>
    </Page>
</mvc:View>
