<mvc:View
    controllerName="kyra001.pages.kyraFEReq.KyraAddAccess"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true">

    <VBox id="addAccessSectionContainer" class="fioriTableCard sapUiResponsivePadding sapUiSmallMarginBottom fioriStepSlideAnim">
        <!-- Section Header -->
        <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom fioriAddAccessHeader">
            <HBox alignItems="Center">
                <Avatar src="sap-icon://add-process" backgroundColor="Accent1" displaySize="S" class="sapUiSmallMarginEnd" />
                <VBox>
                    <Title text="KYRA Enterprise Access Request" level="H4" class="fioriCardHeaderTitle" />
                    <Text text="Complete scope selection, regional mapping, multi-system configuration, and compliance review." class="fioriDescriptionText" />
                </VBox>
            </HBox>
            <Button
                icon="sap-icon://decline"
                type="Transparent"
                press=".onCloseAddAccessSector"
                tooltip="Close Add Access Section" />
        </HBox>

        <!-- ANIMATED 5-STEP PROGRESS TRACKER BAR -->
        <HBox justifyContent="Center" alignItems="Center" class="sapUiSmallMarginBottom fioriWizardProgressTrack">
            <!-- Step 1: Business Sector -->
            <HBox alignItems="Center" class="{= ${accessModel>/addAccessStep} === 1 || !${accessModel>/addAccessStep} ? 'fioriStepPill fioriStepPillActive' : 'fioriStepPill fioriStepPillDone' }">
                <Avatar src="{= ${accessModel>/addAccessStep} > 1 ? 'sap-icon://sys-enter-2' : 'sap-icon://building' }" displaySize="XS" class="kyraStepAvatar" />
                <Text text="1. Business Sector" class="fioriStepPillText" />
            </HBox>
            
            <HBox class="{= ${accessModel>/addAccessStep} > 1 ? 'fioriStepConnectorLine fioriStepConnectorActive' : 'fioriStepConnectorLine' }" />
            
            <!-- Step 2: Region Selection -->
            <HBox alignItems="Center" class="{= ${accessModel>/addAccessStep} === 2 ? 'fioriStepPill fioriStepPillActive' : (${accessModel>/addAccessStep} > 2 ? 'fioriStepPill fioriStepPillDone' : 'fioriStepPill') }">
                <Avatar src="{= ${accessModel>/addAccessStep} > 2 ? 'sap-icon://sys-enter-2' : 'sap-icon://globe' }" displaySize="XS" class="kyraStepAvatar" />
                <Text text="2. Region Selection" class="fioriStepPillText" />
            </HBox>

            <HBox class="{= ${accessModel>/addAccessStep} > 2 ? 'fioriStepConnectorLine fioriStepConnectorActive' : 'fioriStepConnectorLine' }" />

            <!-- Step 3: Access Configuration -->
            <HBox alignItems="Center" class="{= ${accessModel>/addAccessStep} === 3 ? 'fioriStepPill fioriStepPillActive' : (${accessModel>/addAccessStep} > 3 ? 'fioriStepPill fioriStepPillDone' : 'fioriStepPill') }">
                <Avatar src="{= ${accessModel>/addAccessStep} > 3 ? 'sap-icon://sys-enter-2' : 'sap-icon://user-settings' }" displaySize="XS" class="kyraStepAvatar" />
                <Text text="3. Access Configuration" class="fioriStepPillText" />
            </HBox>

            <HBox class="{= ${accessModel>/addAccessStep} > 3 ? 'fioriStepConnectorLine fioriStepConnectorActive' : 'fioriStepConnectorLine' }" />

            <!-- Step 4: Access Validation -->
            <HBox alignItems="Center" class="{= ${accessModel>/addAccessStep} === 4 ? 'fioriStepPill fioriStepPillActive' : (${accessModel>/addAccessStep} > 4 ? 'fioriStepPill fioriStepPillDone' : 'fioriStepPill') }">
                <Avatar src="{= ${accessModel>/addAccessStep} > 4 ? 'sap-icon://sys-enter-2' : 'sap-icon://shield' }" displaySize="XS" class="kyraStepAvatar" />
                <Text text="4. Access Validation" class="fioriStepPillText" />
            </HBox>

            <HBox class="{= ${accessModel>/addAccessStep} > 4 ? 'fioriStepConnectorLine fioriStepConnectorActive' : 'fioriStepConnectorLine' }" />

            <!-- Step 5: Review & Summary -->
            <HBox alignItems="Center" class="{= ${accessModel>/addAccessStep} === 5 ? 'fioriStepPill fioriStepPillActive' : 'fioriStepPill' }">
                <Avatar src="{= ${accessModel>/addAccessStep} > 5 ? 'sap-icon://sys-enter-2' : 'sap-icon://summary-detail' }" displaySize="XS" class="kyraStepAvatar" />
                <Text text="5. Review &amp; Summary" class="fioriStepPillText" />
            </HBox>
        </HBox>

        <!-- =========================================================================
             SLIDE 1 / STEP 1: BUSINESS SECTOR & FUNCTION
             ========================================================================= -->
        <VBox visible="{= ${accessModel>/addAccessStep} === 1 || !${accessModel>/addAccessStep} }" class="fioriStepSlideAnim">
            <VBox class="kyraEnterpriseScopeCard sapUiSmallMarginBottom">
                <!-- Card Header -->
                <HBox alignItems="Center" class="kyraScopeCardHeader">
                    <VBox class="kyraScopeHeaderIconWrap" justifyContent="Center" alignItems="Center">
                        <core:Icon src="sap-icon://org-chart" class="kyraScopeHeaderIcon" />
                    </VBox>
                    <VBox class="kyraScopeHeaderTitles">
                        <Title text="Enterprise Scope Selection" level="H4" class="kyraScopeTitle" />
                        <Text text="Select your target business sector and aligned business function to initiate governance workflows." class="kyraScopeSubtitle" />
                    </VBox>
                </HBox>

                <!-- 2-Column Responsive Field Grid -->
                <HBox class="kyraScopeGridRow" wrap="Wrap">
                    <!-- Column 1: Business Sector -->
                    <VBox class="kyraScopeFieldCol">
                        <HBox alignItems="Center" class="kyraFieldLabelRow">
                            <core:Icon src="sap-icon://building" class="kyraFieldIcon" />
                            <Label text="Business Sector" required="true" class="kyraModernFormLabel" labelFor="inPageBusinessSectorSelect" />
                        </HBox>
                        <ComboBox
                            id="inPageBusinessSectorSelect"
                            selectedKey="{accessModel>/selectedSector}"
                            selectionChange=".onInPageSectorChange"
                            placeholder="Select Business Sector..."
                            width="100%"
                            class="kyraModernSelectField fioriSelectGlow">
                            <core:Item key="Finance &amp; Enterprise Performance" text="Finance &amp; Enterprise Performance" />
                            <core:Item key="Global Supply Chain &amp; Logistics" text="Global Supply Chain &amp; Logistics" />
                            <core:Item key="Human Capital Management (HCM)" text="Human Capital Management (HCM)" />
                            <core:Item key="Information Technology &amp; Security" text="Information Technology &amp; Security" />
                            <core:Item key="Customer Operations &amp; Sales" text="Customer Operations &amp; Sales" />
                        </ComboBox>
                    </VBox>

                    <!-- Column 2: Business Function -->
                    <VBox class="kyraScopeFieldCol">
                        <HBox alignItems="Center" class="kyraFieldLabelRow">
                            <core:Icon src="sap-icon://user-settings" class="kyraFieldIcon" />
                            <Label text="Business Function" required="true" class="kyraModernFormLabel" labelFor="inPageBusinessFunctionSelect" />
                        </HBox>
                        <ComboBox
                            id="inPageBusinessFunctionSelect"
                            selectedKey="{accessModel>/selectedFunction}"
                            items="{accessModel>/availableFunctions}"
                            placeholder="Select Business Function..."
                            width="100%"
                            class="kyraModernSelectField fioriSelectGlow">
                            <core:Item key="{accessModel>key}" text="{accessModel>text}" />
                        </ComboBox>
                    </VBox>
                </HBox>
            </VBox>

            <HBox justifyContent="End" class="sapUiSmallMarginTop">
                <Button
                    text="Cancel"
                    type="Transparent"
                    press=".onCloseAddAccessSector"
                    class="sapUiTinyMarginEnd" />
                <Button
                    text="Next"
                    type="Emphasized"
                    icon="sap-icon://navigation-right-arrow"
                    press=".onGoToAddAccessStep2"
                    class="fioriEmphasizedBtn" />
            </HBox>
        </VBox>

        <!-- =========================================================================
             SLIDE 2 / STEP 2: REGION SELECTION (INTERACTIVE WORLD MAP)
             ========================================================================= -->
        <VBox visible="{= ${accessModel>/addAccessStep} === 2 }" class="fioriStepSlideAnim">
            <!-- Card 1: World Map Container Box -->
            <VBox class="fioriMapCardOuter sapUiSmallMarginBottom">
                <core:HTML content='&lt;div id="mapWrapper" class="map-wrapper"&gt;
                        &lt;img id="worldMapImgAccessPage" src="world-map.jpg" alt="World Map" class="world-map-img"&gt;
                        &lt;div id="pinsLayer" class="map-pins-layer"&gt;&lt;/div&gt;
                        
                        &lt;div id="selectAllBtn" class="select-all-btn-wrapper"&gt;
                          &lt;div class="select-all-icon"&gt;
                            &lt;svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"&gt;
                              &lt;path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5-2.5z"/&gt;
                            &lt;/svg&gt;
                          &lt;/div&gt;
                          &lt;span class="select-all-text"&gt;Select All Regions&lt;/span&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;'>
                </core:HTML>
            </VBox>

            <!-- Card 2: Selected Regions Box -->
            <VBox class="selected-regions-card-box sapUiSmallMarginBottom" alignContent="Center" alignItems="Center">
                <Text text="SELECTED REGIONS" class="selected-regions-header" />
                <HBox id="selectedChipsList" items="{accessModel>/mapSelectedRegions}" class="selected-chips-list" justifyContent="Center" wrap="Wrap">
                    <Button 
                        text="{accessModel>name}" 
                        icon="sap-icon://decline" 
                        iconFirst="false" 
                        press=".onRemoveMapRegionChip"
                        class="region-chip-btn sapUiTinyMarginEnd sapUiTinyMarginBottom" />
                </HBox>
                <Text text="No regions selected" class="no-selection-text" visible="{= !${accessModel>/hasMapRegionSelection} }" />
            </VBox>

            <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginTop">
                <Button
                    text="Back to Step 1"
                    icon="sap-icon://navigation-left-arrow"
                    type="Default"
                    press=".onGoToAddAccessStep1" />
                <HBox>
                    <Button
                        text="Cancel"
                        type="Transparent"
                        press=".onCloseAddAccessSector"
                        class="sapUiTinyMarginEnd" />
                    <Button
                        text="Next"
                        type="Emphasized"
                        icon="sap-icon://navigation-right-arrow"
                        press=".onGoToAddAccessStep3"
                        class="fioriEmphasizedBtn" />
                </HBox>
            </HBox>
        </VBox>

        <!-- =========================================================================
             SLIDE 3 & 4 / STEP 3: ACCESS CONFIGURATION (SYSTEM SLIDES & DURATION)
             ========================================================================= -->
        <VBox visible="{= ${accessModel>/addAccessStep} === 3 }" class="fioriStepSlideAnim">
            
            <!-- SUB-STEP 3.1: TARGET SYSTEMS SLIDE CONFIGURATION -->
            <VBox visible="{= ${accessModel>/addAccessConfigSubStep} === 1 || !${accessModel>/addAccessConfigSubStep} }">
                <form:SimpleForm
                    editable="true"
                    layout="ColumnLayout"
                    columnsM="2"
                    columnsL="2"
                    singleContainerFullWidth="false"
                    class="sapUiSmallMarginBottom">
                    <form:content>
                        <core:Title text="Target Systems &amp; Process Selection" />
                        
                        <Label text="Select Target Systems &amp; Processes" required="true" />
                        <MultiComboBox
                            id="inPageSystemsMultiSelect"
                            selectedKeys="{accessModel>/addAccessSelectedSystems}"
                            selectionChange=".onInPageTargetSystemsSelectionChange"
                            placeholder="Select target system processes..."
                            width="100%"
                            class="fioriFormSelect">
                            <core:Item key="SAP BTP Cloud Platform" text="SAP BTP Cloud Platform" />
                            <core:Item key="SAP S/4HANA Enterprise" text="SAP S/4HANA Enterprise" />
                            <core:Item key="KYRA Central Governance" text="KYRA Central Governance" />
                            <core:Item key="Active Directory / IAM" text="Active Directory / IAM" />
                            <core:Item key="SAP SuccessFactors" text="SAP SuccessFactors" />
                            <core:Item key="SAP Ariba Supply Network" text="SAP Ariba Supply Network" />
                        </MultiComboBox>
                    </form:content>
                </form:SimpleForm>

                <!-- PER-TARGET SYSTEM SLIDE CARD -->
                <VBox visible="{= ${accessModel>/addAccessSelectedSystems} &amp;&amp; ${accessModel>/addAccessSelectedSystems}.length &gt; 0 }" class="fioriTableCard sapUiResponsivePadding sapUiSmallMarginBottom">
                    <!-- Target System Slide Header Banner -->
                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom fioriConflictHeaderBanner">
                        <HBox alignItems="Center">
                            <Avatar src="sap-icon://action-settings" backgroundColor="Accent6" displaySize="S" class="sapUiTinyMarginEnd" />
                            <VBox>
                                <Title text="{= 'Target System Slide (' + (${accessModel>/addAccessCurrentSystemIndex} + 1) + ' of ' + ${accessModel>/addAccessSelectedSystems}.length + '): ' + ${accessModel>/currentSystemSlideName} }" level="H4" class="fioriCardHeaderTitle" />
                                <Text text="Configure specific services, team roles, and personas for this target system." class="fioriDescriptionText" />
                            </VBox>
                        </HBox>
                        <ObjectStatus
                            text="{= 'Slide ' + (${accessModel>/addAccessCurrentSystemIndex} + 1) + ' / ' + ${accessModel>/addAccessSelectedSystems}.length }"
                            state="Information" />
                    </HBox>

                    <form:SimpleForm
                        editable="true"
                        layout="ColumnLayout"
                        columnsM="2"
                        columnsL="2"
                        singleContainerFullWidth="false">
                        <form:content>
                            <core:Title text="{= 'Entitlements &amp; Personas for ' + ${accessModel>/currentSystemSlideName} }" />
                            
                            <!-- FIELD 1: SERVICE / TOPIC -->
                            <Label text="Service / Topic" required="true" />
                            <MultiComboBox
                                id="inPageServicesMultiSelect"
                                selectedKeys="{accessModel>/addAccessSelectedServices}"
                                selectionChange=".onInPageServicesSelectionChange"
                                placeholder="Select service topics for this system..."
                                width="100%"
                                class="fioriFormSelect">
                                <core:Item key="System Administrator" text="System Administrator" />
                                <core:Item key="System Owners" text="System Owners" />
                                <core:Item key="Stakeholders" text="Stakeholders" />
                            </MultiComboBox>

                            <!-- FIELD 2: TEAM ROLE -->
                            <Label text="Team Role" required="true" />
                            <MultiComboBox
                                id="inPageTeamMultiSelect"
                                selectedKeys="{accessModel>/addAccessSelectedRoles}"
                                selectionChange=".onInPageTeamSelectionChange"
                                items="{accessModel>/addAccessSubRolesList}"
                                placeholder="{= ${accessModel>/addAccessSelectedServices} &amp;&amp; ${accessModel>/addAccessSelectedServices}.length &gt; 0 ? 'Select team roles for this system...' : 'Select Service / Topic above first...' }"
                                width="100%"
                                enabled="{= ${accessModel>/addAccessSelectedServices} &amp;&amp; ${accessModel>/addAccessSelectedServices}.length &gt; 0 }"
                                class="fioriFormSelect">
                                <core:Item key="{accessModel>key}" text="{accessModel>text}" />
                            </MultiComboBox>

                            <!-- FIELD 3: ASSIGNED PERSONA -->
                            <Label text="Assigned Persona" required="true" />
                            <MultiComboBox
                                id="inPagePersonaMultiSelect"
                                selectedKeys="{accessModel>/addAccessSelectedPersonas}"
                                items="{accessModel>/addAccessPersonasList}"
                                placeholder="{= ${accessModel>/addAccessSelectedRoles} &amp;&amp; ${accessModel>/addAccessSelectedRoles}.length &gt; 0 ? 'Select personas for this system...' : 'Select Team Role above first...' }"
                                width="100%"
                                enabled="{= ${accessModel>/addAccessSelectedRoles} &amp;&amp; ${accessModel>/addAccessSelectedRoles}.length &gt; 0 }"
                                class="fioriFormSelect">
                                <core:Item key="{accessModel>key}" text="{accessModel>text}" />
                            </MultiComboBox>
                        </form:content>
                    </form:SimpleForm>

                    <!-- Slide Navigation Buttons -->
                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginTop">
                        <Button
                            text="Previous System Slide"
                            icon="sap-icon://navigation-left-arrow"
                            type="Default"
                            visible="{= !${accessModel>/isEditingFromSummary} &amp;&amp; ${accessModel>/addAccessCurrentSystemIndex} &gt; 0 }"
                            press=".onPrevSystemSlide" />
                        <Text text="" visible="{= ${accessModel>/isEditingFromSummary} || ${accessModel>/addAccessCurrentSystemIndex} === 0 }" />
                        
                        <HBox>
                            <!-- Simple OK button shown ONLY when editing from Summary -->
                            <Button
                                text="OK"
                                type="Emphasized"
                                icon="sap-icon://accept"
                                visible="{accessModel>/isEditingFromSummary}"
                                press=".onSaveAndReturnToSummary"
                                class="fioriEmphasizedBtn"
                                tooltip="Save changes and return straight to Summary" />
                            <Button
                                text="Next System Slide"
                                type="Emphasized"
                                icon="sap-icon://navigation-right-arrow"
                                visible="{= !${accessModel>/isEditingFromSummary} &amp;&amp; (${accessModel>/addAccessCurrentSystemIndex} + 1) &lt; ${accessModel>/addAccessSelectedSystems}.length }"
                                enabled="{= ${accessModel>/addAccessSelectedPersonas} &amp;&amp; ${accessModel>/addAccessSelectedPersonas}.length &gt; 0 }"
                                press=".onNextSystemSlide"
                                class="fioriEmphasizedBtn sapUiTinyMarginEnd" />
                            <Button
                                text="Submit System Configs &amp; Set Duration"
                                type="Emphasized"
                                icon="sap-icon://accept"
                                visible="{= !${accessModel>/isEditingFromSummary} &amp;&amp; (${accessModel>/addAccessCurrentSystemIndex} + 1) === ${accessModel>/addAccessSelectedSystems}.length }"
                                enabled="{= ${accessModel>/addAccessSelectedPersonas} &amp;&amp; ${accessModel>/addAccessSelectedPersonas}.length &gt; 0 }"
                                press=".onCompleteSystemSlides"
                                class="fioriEmphasizedBtn" />
                        </HBox>
                    </HBox>
                </VBox>

                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginTop" visible="{= !${accessModel>/isEditingFromSummary} }">
                    <Button
                        text="Back to Step 2 (Region)"
                        icon="sap-icon://navigation-left-arrow"
                        type="Default"
                        press=".onGoToAddAccessStep2" />
                    <Button
                        text="Cancel"
                        type="Transparent"
                        press=".onCloseAddAccessSector" />
                </HBox>
            </VBox>

            <!-- SUB-STEP 3.2: DURATION & BUSINESS JUSTIFICATION -->
            <VBox visible="{= ${accessModel>/addAccessConfigSubStep} === 2 }">
                <form:SimpleForm
                    editable="true"
                    layout="ColumnLayout"
                    columnsM="2"
                    columnsL="2"
                    singleContainerFullWidth="false"
                    class="sapUiSmallMarginBottom">
                    <form:content>
                        <core:Title text="Access Duration &amp; Business Justification" />
                        
                        <!-- SUB-STEP 3.2 - FIELD 1: DURATION -->
                        <Label text="Access Duration" required="true" />
                        <ComboBox
                            id="inPageDurationSelect"
                            selectedKey="{accessModel>/addAccessDuration}"
                            placeholder="Select Access Duration..."
                            width="100%"
                            class="fioriFormSelect">
                            <core:Item key="Permanent (Default)" text="Permanent (Default)" />
                            <core:Item key="30 Days (Temporary)" text="30 Days (Temporary)" />
                            <core:Item key="90 Days (Project)" text="90 Days (Project)" />
                        </ComboBox>

                        <!-- SUB-STEP 3.2 - FIELD 2: JUSTIFICATION -->
                        <Label text="Business Justification" required="true" />
                        <TextArea
                            value="{accessModel>/addAccessJustification}"
                            placeholder="Provide detailed business justification for requesting these system permissions..."
                            rows="4"
                            width="100%" />
                    </form:content>
                </form:SimpleForm>

                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginTop">
                    <Button
                        text="Back to System Slides"
                        icon="sap-icon://navigation-left-arrow"
                        type="Default"
                        visible="{= !${accessModel>/isEditingFromSummary} }"
                        press=".onBackToSystemSlides" />
                    <Text text="" visible="{accessModel>/isEditingFromSummary}" />
                    <HBox>
                        <!-- Simple OK button shown ONLY when editing from Summary -->
                        <Button
                            text="OK"
                            type="Emphasized"
                            icon="sap-icon://accept"
                            visible="{accessModel>/isEditingFromSummary}"
                            press=".onSaveAndReturnToSummary"
                            class="fioriEmphasizedBtn"
                            tooltip="Save changes and return straight to Summary" />
                        <Button
                            text="Cancel"
                            type="Transparent"
                            visible="{= !${accessModel>/isEditingFromSummary} }"
                            press=".onCloseAddAccessSector"
                            class="sapUiTinyMarginEnd" />
                        <Button
                            text="Proceed to Summary"
                            type="Emphasized"
                            icon="sap-icon://navigation-right-arrow"
                            visible="{= !${accessModel>/isEditingFromSummary} }"
                            press=".onGoToAddAccessStep4"
                            class="fioriEmphasizedBtn" />
                    </HBox>
                </HBox>
            </VBox>
        </VBox>

        <!-- =========================================================================
             SLIDE 5 & 6 / STEP 4: CONFLICT ANALYSIS & SOD VALIDATION
             ========================================================================= -->

        <!-- SLIDE 1: ACCESS VALIDATION (3 COMPACT SUMMARY CARDS) -->
        <VBox visible="{= ${accessModel>/addAccessStep} === 4 &amp;&amp; (${accessModel>/addAccessStep4SubStep} || 1) === 1 }" class="fioriStepSlideAnim sapUiResponsivePadding">
            <!-- Top Header Banner -->
            <HBox justifyContent="SpaceBetween" alignItems="Center" class="fioriConflictHeaderBanner sapUiSmallMarginBottom">
                <HBox alignItems="Center">
                    <Title text="Step 4: Access Validation" level="H4" class="fioriBannerTitle" />
                </HBox>
                <HBox alignItems="Center">
                    <Text text="Requester ID: " class="fioriRequestForLabel" />
                    <Text text="{= ${accessModel>/activeUser} || 'Dev001' }" class="fioriRequestForUser sapUiTinyMarginBegin" />
                </HBox>
            </HBox>

            <!-- COMPACT SUMMARY CARD 1: Threshold Limits -->
            <VBox class="fioriConflictSectionBox sapUiSmallMarginBottom">
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom">
                    <HBox alignItems="Center">
                        <Avatar src="sap-icon://chain-link" backgroundColor="Accent6" displaySize="S" class="sapUiTinyMarginEnd" />
                        <Title text="Threshold Limits" level="H5" class="fioriConflictSectionTitle" />
                    </HBox>
                    <ObjectStatus text="0 Issues" state="Success" icon="sap-icon://sys-enter-2" style="font-weight: 700;" />
                </HBox>
                <Table id="thresholdLimitsTable" class="fioriConflictTable" fixedLayout="true" noDataText="No Threshold Limits">
                    <columns>
                        <Column width="25%"><Text text="System" class="fioriConflictTableHeader" /></Column>
                        <Column width="25%"><Text text="Sector" class="fioriConflictTableHeader" /></Column>
                        <Column width="25%"><Text text="Limit" class="fioriConflictTableHeader" /></Column>
                        <Column width="25%"><Text text="Excessive Percentage" class="fioriConflictTableHeader" /></Column>
                    </columns>
                </Table>
            </VBox>

            <!-- COMPACT SUMMARY CARD 2: Restricted Records -->
            <VBox class="fioriConflictSectionBox sapUiSmallMarginBottom">
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom">
                    <HBox alignItems="Center">
                        <Avatar src="sap-icon://security-risk" backgroundColor="Accent6" displaySize="S" class="sapUiTinyMarginEnd" />
                        <Title text="Restricted Records" level="H5" class="fioriConflictSectionTitle" />
                    </HBox>
                    <ObjectStatus text="0 Records" state="Success" icon="sap-icon://sys-enter-2" style="font-weight: 700;" />
                </HBox>
                <Table id="restrictedRecordsTable" class="fioriConflictTable" fixedLayout="true" noDataText="No Restricted Records">
                    <columns>
                        <Column width="14%"><Text text="System" class="fioriConflictTableHeader" /></Column>
                        <Column width="14%"><Text text="Sector" class="fioriConflictTableHeader" /></Column>
                        <Column width="14%"><Text text="Position" class="fioriConflictTableHeader" /></Column>
                        <Column width="14%"><Text text="Module Name" class="fioriConflictTableHeader" /></Column>
                        <Column width="14%"><Text text="Security Group" class="fioriConflictTableHeader" /></Column>
                        <Column width="15%"><Text text="Team Name" class="fioriConflictTableHeader" /></Column>
                        <Column width="15%"><Text text="Ad Group Name" class="fioriConflictTableHeader" /></Column>
                    </columns>
                </Table>
            </VBox>

            <!-- COMPACT SUMMARY CARD 3: Duplicate Roles -->
            <VBox class="fioriConflictSectionBox sapUiSmallMarginBottom">
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom">
                    <HBox alignItems="Center">
                        <Avatar src="sap-icon://copy" backgroundColor="Accent6" displaySize="S" class="sapUiTinyMarginEnd" />
                        <Title text="Duplicate Roles" level="H5" class="fioriConflictSectionTitle" />
                    </HBox>
                    <ObjectStatus text="0 Duplicates" state="Success" icon="sap-icon://sys-enter-2" style="font-weight: 700;" />
                </HBox>
                <Table id="duplicateRolesTable" class="fioriConflictTable" fixedLayout="true" noDataText="No Duplicate Roles">
                    <columns>
                        <Column width="14%"><Text text="System" class="fioriConflictTableHeader" /></Column>
                        <Column width="14%"><Text text="Functional Role" class="fioriConflictTableHeader" /></Column>
                        <Column width="14%"><Text text="Module Name" class="fioriConflictTableHeader" /></Column>
                        <Column width="16%"><Text text="Selected Security Groups" class="fioriConflictTableHeader" /></Column>
                        <Column width="14%"><Text text="Team Name" class="fioriConflictTableHeader" /></Column>
                        <Column width="14%"><Text text="Ad Group Name" class="fioriConflictTableHeader" /></Column>
                        <Column width="14%"><Text text="Existing Group/ Roles" class="fioriConflictTableHeader" /></Column>
                    </columns>
                </Table>
            </VBox>

            <!-- Slide 1 Footer Action Bar -->
            <HBox justifyContent="SpaceBetween" alignItems="Center" class="fioriConflictFooterBar sapUiSmallMarginTop">
                <Button text="Previous" icon="sap-icon://navigation-left-arrow" type="Default" press=".onGoBackToDurationSlide" class="sapUiTinyMarginEnd" />
                <HBox alignItems="Center">
                    <Button text="Cancel" type="Transparent" press=".onCloseAddAccessSector" class="sapUiTinyMarginEnd" />
                    <Button text="Continue" type="Emphasized" icon="sap-icon://navigation-right-arrow" press=".onGoToStep4Slide2" class="fioriEmphasizedBtn" />
                </HBox>
            </HBox>
        </VBox>

        <!-- SLIDE 2: SOD CONFLICT REVIEW -->
        <VBox visible="{= ${accessModel>/addAccessStep} === 4 &amp;&amp; ${accessModel>/addAccessStep4SubStep} === 2 }" class="fioriStepSlideAnim sapUiResponsivePadding">
            <!-- Top Header Banner -->
            <HBox justifyContent="SpaceBetween" alignItems="Center" class="fioriConflictHeaderBanner sapUiSmallMarginBottom">
                <HBox alignItems="Center">
                    <Title text="Step 4: SoD Conflict Review" level="H4" class="fioriBannerTitle" />
                </HBox>
                <HBox alignItems="Center">
                    <Text text="Requester ID: " class="fioriRequestForLabel" />
                    <Text text="{= ${accessModel>/activeUser} || 'Dev001' }" class="fioriRequestForUser sapUiTinyMarginBegin" />
                </HBox>
            </HBox>

            <!-- SOD Conflicts/Conflicting Personas Section -->
            <VBox class="fioriConflictSectionBox sapUiSmallMarginBottom">
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom">
                    <Title text="SOD Conflicts/Conflicting Personas" level="H5" class="fioriConflictSectionTitle" />
                    <SegmentedButton selectedKey="{accessModel>/sodConflictToggle}" selectionChange=".onSodConflictToggleChange" class="fioriSodSegmentedBtn">
                        <items>
                            <SegmentedButtonItem key="existing" text="Existing Access" />
                            <SegmentedButtonItem key="new" text="New Access" />
                        </items>
                    </SegmentedButton>
                </HBox>

                <Table id="sodConflictsTable" class="fioriConflictTable" fixedLayout="true">
                    <columns>
                        <Column width="35%"><Text text="Configured Target Role" class="fioriConflictTableHeader" /></Column>
                        <Column width="35%"><Text text="Conflicting Active Role" class="fioriConflictTableHeader" /></Column>
                        <Column width="30%"><Text text="Segregation of Duties (SoD) Conflict Detail" class="fioriConflictTableHeader" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem vAlign="Middle">
                            <cells>
                                <HBox class="fioriAppBoxPill">
                                    <Text text="SAP S/4HANA Enterprise — IT Developers (System Administrator)" class="fioriAppBoxText" />
                                </HBox>
                                <HBox class="fioriAppBoxPill">
                                    <Text text="Active Directory / IAM — IT Security (System Administrator)" class="fioriAppBoxText" />
                                </HBox>
                                <Text text="Critical: S/4HANA System Administrator vs. Active Directory IAM Security Governance" class="fioriConflictDetailText" />
                            </cells>
                        </ColumnListItem>
                        <ColumnListItem vAlign="Middle">
                            <cells>
                                <HBox class="fioriAppBoxPill">
                                    <Text text="SAP BTP Cloud Platform — Lead Engineer (System Administrator)" class="fioriAppBoxText" />
                                </HBox>
                                <HBox class="fioriAppBoxPill">
                                    <Text text="KYRA Central Governance — Compliance Manager (Stakeholders)" class="fioriAppBoxText" />
                                </HBox>
                                <Text text="High: BTP Lead Engineer Code Deployer vs. Central Governance Compliance Auditor" class="fioriConflictDetailText" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>

            <!-- Slide 2 Footer Action Bar -->
            <HBox justifyContent="SpaceBetween" alignItems="Center" class="fioriConflictFooterBar sapUiSmallMarginTop">
                <Button text="Previous" icon="sap-icon://navigation-left-arrow" type="Default" press=".onGoToStep4Slide1" class="sapUiTinyMarginEnd" />
                <HBox alignItems="Center">
                    <Button text="Cancel" type="Transparent" press=".onCloseAddAccessSector" class="sapUiTinyMarginEnd" />
                    <Button text="Continue" type="Emphasized" icon="sap-icon://navigation-right-arrow" press=".onGoToAddAccessStep5" class="fioriEmphasizedBtn" />
                </HBox>
            </HBox>
        </VBox>

        <!-- =========================================================================
             SLIDE 7 / STEP 5: ACCESS REQUEST REVIEW & SUMMARY
             ========================================================================= -->
        <VBox visible="{= ${accessModel>/addAccessStep} === 5 }" class="fioriStepSlideAnim sapUiResponsivePadding">
            <!-- Top Header Banner -->
            <HBox justifyContent="SpaceBetween" alignItems="Center" class="fioriConflictHeaderBanner sapUiSmallMarginBottom">
                <HBox alignItems="Center">
                    <Title text="Step 5: Review &amp; Summary" level="H4" class="fioriBannerTitle" />
                </HBox>
                <HBox alignItems="Center">
                    <Text text="Requester ID: " class="fioriRequestForLabel" />
                    <Text text="{= ${accessModel>/activeUser} || 'Dev001' }" class="fioriRequestForUser sapUiTinyMarginBegin" />
                </HBox>
            </HBox>

            <!-- Top Scope & Governance Metadata Summary Card -->
            <VBox class="kyraSummaryTopDetailsCard sapUiSmallMarginBottom">
                <HBox class="kyraSummaryDetailGrid" alignItems="Center">
                    <VBox class="kyraSummaryDetailItem">
                        <Text text="REQUESTER ID" class="kyraSummaryDetailLabel" />
                        <Text text="{= ${accessModel>/activeUser} || 'Dev001' }" class="kyraSummaryDetailValue kyraRequesterIdHighlight" />
                    </VBox>
                    <VBox class="kyraSummaryDetailItem">
                        <Text text="BUSINESS SECTOR" class="kyraSummaryDetailLabel" />
                        <Text text="{accessModel>/selectedSector}" class="kyraSummaryDetailValue" />
                    </VBox>
                    <VBox class="kyraSummaryDetailItem">
                        <Text text="BUSINESS FUNCTION" class="kyraSummaryDetailLabel" />
                        <Text text="{accessModel>/selectedFunction}" class="kyraSummaryDetailValue" />
                    </VBox>
                    <VBox class="kyraSummaryDetailItem">
                        <Text text="OPERATING REGION" class="kyraSummaryDetailLabel" />
                        <Text text="{accessModel>/addAccessRegion}" class="kyraSummaryDetailValue" />
                    </VBox>
                    <VBox class="kyraSummaryDetailItem">
                        <Text text="ACCESS DURATION" class="kyraSummaryDetailLabel" />
                        <Text text="{accessModel>/addAccessDuration}" class="kyraSummaryDetailValue" />
                    </VBox>
                </HBox>
                <VBox class="kyraSummaryJustificationBox" visible="{= !!${accessModel>/addAccessJustification} }">
                    <Text text="BUSINESS JUSTIFICATION" class="kyraSummaryDetailLabel" />
                    <Text text="{accessModel>/addAccessJustification}" class="kyraSummaryDetailJustification" />
                </VBox>
            </VBox>

            <!-- Configured Entitlements Separated Target Tables Container -->
            <VBox items="{accessModel>/addAccessSummaryTables}">
                <items>
                    <VBox class="kyraSummaryCardContainer">
                        <!-- Target System Table Card Header -->
                        <HBox justifyContent="SpaceBetween" alignItems="Center" class="kyraSummaryCardHeader">
                            <HBox alignItems="Center">
                                <Avatar src="{accessModel>systemIcon}" class="kyraSummaryAvatar" displaySize="S" />
                                <VBox>
                                    <Title text="{= 'Target System ' + ${accessModel>systemIndex} + ': ' + ${accessModel>systemName} }" level="H5" class="kyraSummaryCardTitle" />
                                    <Text text="{= ${accessModel>items}.length + ' Configured Entitlement(s)' }" class="kyraSummaryCardSubtitle" />
                                </VBox>
                            </HBox>
                            <Button
                                text="Edit"
                                icon="sap-icon://edit"
                                press=".onEditSystemConfiguration"
                                class="kyraSummaryEditBtn"
                                tooltip="Edit configuration for this target system" />
                        </HBox>

                        <!-- Separate 7-Column Table for this Target System -->
                        <Table
                            items="{accessModel>items}"
                            noDataText="No access items configured for this system."
                            class="kyraSummaryTable"
                            fixedLayout="true">
                            <columns>
                                <!-- 1. REQUEST ID -->
                                <Column width="16%">
                                    <HBox alignItems="Center">
                                        <core:Icon src="sap-icon://document" class="kyraSummaryColHeaderIcon sapUiTinyMarginEnd" />
                                        <Text text="REQUEST ID" class="kyraSummaryColHeader" />
                                    </HBox>
                                </Column>
                                <!-- 2. TOPIC -->
                                <Column width="15%">
                                    <HBox alignItems="Center">
                                        <core:Icon src="sap-icon://comment" class="kyraSummaryColHeaderIcon sapUiTinyMarginEnd" />
                                        <Text text="TOPIC" class="kyraSummaryColHeader" />
                                    </HBox>
                                </Column>
                                <!-- 3. ROLE TITLE -->
                                <Column width="15%">
                                    <HBox alignItems="Center">
                                        <core:Icon src="sap-icon://shield" class="kyraSummaryColHeaderIcon sapUiTinyMarginEnd" />
                                        <Text text="ROLE TITLE" class="kyraSummaryColHeader" />
                                    </HBox>
                                </Column>
                                <!-- 4. ASSIGNED PERSONA -->
                                <Column width="25%">
                                    <HBox alignItems="Center">
                                        <core:Icon src="sap-icon://customer" class="kyraSummaryColHeaderIcon sapUiTinyMarginEnd" />
                                        <Text text="ASSIGNED PERSONA" class="kyraSummaryColHeader" />
                                    </HBox>
                                </Column>
                                <!-- 5. DURATION -->
                                <Column width="11%">
                                    <HBox alignItems="Center">
                                        <core:Icon src="sap-icon://calendar" class="kyraSummaryColHeaderIcon sapUiTinyMarginEnd" />
                                        <Text text="DURATION" class="kyraSummaryColHeader" />
                                    </HBox>
                                </Column>
                                <!-- 6. STATUS -->
                                <Column width="12%">
                                    <HBox alignItems="Center">
                                        <core:Icon src="sap-icon://message-information" class="kyraSummaryColHeaderIcon sapUiTinyMarginEnd" />
                                        <Text text="STATUS" class="kyraSummaryColHeader" />
                                    </HBox>
                                </Column>
                                <!-- 7. ACTION -->
                                <Column width="6%" hAlign="Center">
                                    <HBox alignItems="Center" justifyContent="Center">
                                        <core:Icon src="sap-icon://action-settings" class="kyraSummaryColHeaderIcon sapUiTinyMarginEnd" />
                                        <Text text="ACTION" class="kyraSummaryColHeader" />
                                    </HBox>
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem vAlign="Middle">
                                    <cells>
                                        <Text text="{accessModel>requestId}" class="kyraSummaryReqIdText" />
                                        <Text text="{accessModel>topic}" class="kyraSummaryTopicText" />
                                        <Text text="{accessModel>roleTitle}" class="kyraSummaryRoleTitleText" />
                                        <Text text="{accessModel>persona}" class="kyraSummaryPersonaText" />
                                        <Text text="{accessModel>duration}" class="kyraSummaryDurationText" />
                                        <ObjectStatus
                                            text="{accessModel>existingStatus}"
                                            state="{accessModel>existingState}"
                                            icon="{accessModel>existingIcon}"
                                            class="{= 'kyraSummaryStatusText ' + (${accessModel>statusType} === 'new' ? 'kyraStatusNew' : (${accessModel>statusType} === 'pending' ? 'kyraStatusPending' : 'kyraStatusExisting')) }" />
                                        <HBox justifyContent="Center" alignItems="Center">
                                            <Button
                                                icon="sap-icon://delete"
                                                class="kyraSummaryDeleteBtn"
                                                press=".onRemoveInPageSummaryItem"
                                                tooltip="Remove this access item" />
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                </items>
            </VBox>

            <!-- Footer Action Bar -->
            <HBox justifyContent="SpaceBetween" alignItems="Center" class="fioriConflictFooterBar sapUiSmallMarginTop">
                <Link text="&lt; Back to Duration &amp; Justification" press=".onGoBackToDurationSlide" class="fioriStartOverLink" />
                <HBox alignItems="Center">
                    <Button text="Cancel Request" type="Transparent" press=".onCloseAddAccessSector" class="sapUiTinyMarginEnd" />
                    <Button
                        text="Submit Access Request"
                        type="Emphasized"
                        icon="sap-icon://paper-plane"
                        press=".onFinalSubmitInPageAddAccess"
                        class="fioriEmphasizedBtn" />
                </HBox>
            </HBox>
        </VBox>
    </VBox>
</mvc:View>
