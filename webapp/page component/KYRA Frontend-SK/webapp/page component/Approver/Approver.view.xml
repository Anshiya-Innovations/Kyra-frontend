<mvc:View
    controllerName="kyra001.pages.Approver.Approver"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core">

    <VBox class="sapUiNoContentPadding">

        <!-- SECTION 2: USER REQUESTS BOX & HISTORY LOG -->
        <VBox
            visible="true"
            class="kyraApproverCard sapUiNoMargin">
            
            <!-- TOP COMPACT TOOLBAR ROW: LEFT (Title, Subtitle, Access/Revoke) | RIGHT (Pending, History, Search, Filter, Export) -->
            <HBox justifyContent="SpaceBetween" alignItems="Start" wrap="Wrap" class="kyraApproverTopToolbar sapUiTinyMarginBottom">
                <!-- LEFT SIDE: Title & Description with Access / Revoke buttons directly below -->
                <VBox class="kyraApproverLeftCol">
                    <HBox alignItems="Center" class="kyraCardHeaderLeft sapUiSmallMarginBottom">
                        <Avatar src="sap-icon://user-edit" class="kyraMasterViewAvatar" displaySize="S" />
                        <VBox class="kyraCardHeaderTextCol">
                            <Title text="{= ${accessModel>/showApprovalHistory} ? 'Processed Approval History Log' : 'User Requests' }" level="H4" class="fioriApproverTitle fioriCardHeaderTitle" />
                            <Text text="{= ${accessModel>/showApprovalHistory} ? 'Audit history of all previously approved, rejected, and cancelled access requests.' : 'Click any request row bar below to open the dedicated full summary review page.' }" class="fioriDescriptionText" />
                        </VBox>
                    </HBox>
                    
                    <HBox visible="{= !${accessModel>/showApprovalHistory} }" class="kyraAccessRevokeBar" alignItems="Center">
                        <Button
                            text="{= 'Access (' + (${accessModel>/pendingAccessCount} || 0) + ')' }"
                            icon="sap-icon://add"
                            type="{= (${accessModel>/approverPendingTab} || 'accessRequests') === 'accessRequests' ? 'Emphasized' : 'Transparent' }"
                            press=".onSelectAccessRequestsTab"
                            class="kyraTabPillBtn sapUiTinyMarginEnd" />
                        <Button
                            text="{= 'Revoke (' + (${accessModel>/pendingRevokeCount} || 0) + ')' }"
                            icon="sap-icon://delete"
                            type="{= ${accessModel>/approverPendingTab} === 'revokeRequests' ? 'Emphasized' : 'Transparent' }"
                            press=".onSelectRevokeRequestsTab"
                            class="kyraTabPillBtn" />
                    </HBox>
                </VBox>

                <!-- RIGHT SIDE: All Controls (Pending, History, Search, Filter, Export) in ONE compact toolbar -->
                <HBox alignItems="Center" class="kyraApproverRightToolbar">
                    <HBox class="kyraApproverPillGroup sapUiTinyMarginEnd" alignItems="Center">
                        <Button
                            icon="sap-icon://time-entry-request"
                            text="{= 'Pending (' + ((${accessModel>/pendingRequests} || []).length) + ')' }"
                            type="{= !${accessModel>/showApprovalHistory} ? 'Emphasized' : 'Transparent' }"
                            press=".onSelectPendingQueue"
                            tooltip="Pending Queue"
                            class="kyraApproverPillBtn" />
                        <Button
                            icon="sap-icon://history"
                            text="{= 'History (' + ((${accessModel>/processedRequests} || []).length) + ')' }"
                            type="{= ${accessModel>/showApprovalHistory} ? 'Emphasized' : 'Transparent' }"
                            press=".onSelectHistoryLog"
                            tooltip="Processed History"
                            class="kyraApproverPillBtn" />
                    </HBox>

                    <SearchField
                        placeholder="Search request..."
                        width="210px"
                        liveChange=".onSearchApprovalTable"
                        class="kyraEntitlementsSearchField sapUiTinyMarginEnd" />
                    
                    <Button
                        icon="sap-icon://filter"
                        type="Transparent"
                        press=".onFilterApprovalsDialog"
                        tooltip="Filter Requests"
                        class="kyraHistoryExportBtn sapUiTinyMarginEnd" />

                    <Button
                        icon="sap-icon://excel-attachment"
                        type="Transparent"
                        press=".onExportApprovals"
                        tooltip="Export Audit Log"
                        class="kyraHistoryExportBtn" />
                </HBox>
            </HBox>

            <!-- CLASSIFICATIONS CONTENT -->
            <VBox visible="{= !${accessModel>/showApprovalHistory} }" class="sapUiNoMargin">

                <!-- CLASSIFICATION 1: ACCESS REQUESTS -->
                <Table
                    id="approvalAccessTable"
                    visible="{= (${accessModel>/approverPendingTab} || 'accessRequests') === 'accessRequests' }"
                    items="{accessModel>/pendingAccessRequests}"
                    noDataText="No pending access requests in queue."
                    fixedLayout="true"
                    popinLayout="GridSmall"
                    class="sapUiNoMargin kyraApproverTable">
                    <columns>
                        <Column width="11%" hAlign="Begin"><Text text="USER ID" class="kyraEntitlementColHeader" /></Column>
                        <Column width="22%" hAlign="Begin"><Text text="USER DETAILS" class="kyraEntitlementColHeader" /></Column>
                        <Column width="18%" minScreenWidth="Tablet" demandPopin="true" hAlign="Begin"><Text text="BUSINESS SECTOR" class="kyraEntitlementColHeader" /></Column>
                        <Column width="17%" minScreenWidth="Tablet" demandPopin="true" hAlign="Begin"><Text text="SERVICES" class="kyraEntitlementColHeader" /></Column>
                        <Column width="13%" minScreenWidth="Desktop" demandPopin="true" hAlign="Center"><Text text="SUBMISSION DATE" class="kyraEntitlementColHeader" /></Column>
                        <Column width="19%" hAlign="Center"><Text text="APPROVAL STATUS" class="kyraEntitlementColHeader" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Navigation" press=".onOpenRequestSummaryDialog" vAlign="Middle" class="kyraApproverRowItem">
                            <cells>
                                <Text text="{accessModel>requesterId}" class="kyraUserIdText" />
                                <Text text="{= ${accessModel>selectedPersona} || (${accessModel>persona} &amp;&amp; ${accessModel>persona} !== 'Requester' ? ${accessModel>persona} : 'Frontend &amp; UI Developer Persona') }" class="kyraUserDetailsText" />
                                <Text text="{accessModel>sector}" wrapping="true" class="kyraSectorText" />
                                <Text text="{= ${accessModel>serviceTopic} || ${accessModel>function} }" wrapping="true" class="kyraFunctionText" />
                                <Text text="{accessModel>submissionDate}" class="kyraDateText" />
                                <ObjectStatus text="{accessModel>status}" state="{accessModel>statusState}" icon="{accessModel>statusIcon}" class="kyraApproverStatusBadge" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <!-- CLASSIFICATION 2: REVOKE REQUESTS -->
                <Table
                    id="approvalRevokeTable"
                    visible="{= ${accessModel>/approverPendingTab} === 'revokeRequests' }"
                    items="{accessModel>/pendingRevokeRequests}"
                    noDataText="No pending revocation requests in queue."
                    fixedLayout="true"
                    popinLayout="GridSmall"
                    class="sapUiNoMargin kyraApproverTable">
                    <columns>
                        <Column width="11%" hAlign="Begin"><Text text="USER ID" class="kyraEntitlementColHeader" /></Column>
                        <Column width="22%" hAlign="Begin"><Text text="USER DETAILS" class="kyraEntitlementColHeader" /></Column>
                        <Column width="18%" minScreenWidth="Tablet" demandPopin="true" hAlign="Begin"><Text text="BUSINESS SECTOR" class="kyraEntitlementColHeader" /></Column>
                        <Column width="17%" minScreenWidth="Tablet" demandPopin="true" hAlign="Begin"><Text text="SERVICES" class="kyraEntitlementColHeader" /></Column>
                        <Column width="13%" minScreenWidth="Desktop" demandPopin="true" hAlign="Center"><Text text="SUBMISSION DATE" class="kyraEntitlementColHeader" /></Column>
                        <Column width="19%" hAlign="Center"><Text text="APPROVAL STATUS" class="kyraEntitlementColHeader" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Navigation" press=".onOpenRequestSummaryDialog" vAlign="Middle" class="kyraApproverRowItem">
                            <cells>
                                <Text text="{accessModel>requesterId}" class="kyraUserIdText" />
                                <Text text="{= ${accessModel>selectedPersona} || (${accessModel>persona} &amp;&amp; ${accessModel>persona} !== 'Requester' ? ${accessModel>persona} : 'Frontend &amp; UI Developer Persona') }" class="kyraUserDetailsText" />
                                <Text text="{accessModel>sector}" wrapping="true" class="kyraSectorText" />
                                <Text text="{= ${accessModel>serviceTopic} || ${accessModel>function} }" wrapping="true" class="kyraFunctionText" />
                                <Text text="{accessModel>submissionDate}" class="kyraDateText" />
                                <ObjectStatus text="{accessModel>status}" state="{accessModel>statusState}" icon="{accessModel>statusIcon}" class="kyraApproverStatusBadge" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>

            <!-- TABLE 2: PROCESSED APPROVAL HISTORY LOG TABLE -->
            <Table
                id="approvalHistoryTable"
                visible="{accessModel>/showApprovalHistory}"
                items="{accessModel>/processedRequests}"
                noDataText="No processed approval history available."
                fixedLayout="true"
                popinLayout="GridSmall"
                class="sapUiNoMargin kyraApproverTable">
                <columns>
                    <Column width="11%" hAlign="Begin"><Text text="USER ID" class="kyraEntitlementColHeader" /></Column>
                    <Column width="21%" hAlign="Begin"><Text text="USER DETAILS" class="kyraEntitlementColHeader" /></Column>
                    <Column width="17%" minScreenWidth="Tablet" demandPopin="true" hAlign="Begin"><Text text="BUSINESS SECTOR" class="kyraEntitlementColHeader" /></Column>
                    <Column width="16%" minScreenWidth="Tablet" demandPopin="true" hAlign="Begin"><Text text="SERVICES" class="kyraEntitlementColHeader" /></Column>
                    <Column width="12%" minScreenWidth="Desktop" demandPopin="true" hAlign="Center"><Text text="DECISION DATE" class="kyraEntitlementColHeader" /></Column>
                    <Column width="13%" hAlign="Center"><Text text="FINAL DECISION" class="kyraEntitlementColHeader" /></Column>
                    <Column width="10%" hAlign="Center"><Text text="BREAKDOWN" class="kyraEntitlementColHeader" /></Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle" class="kyraApproverRowItem">
                        <cells>
                            <Text text="{accessModel>requesterId}" class="kyraUserIdText" />
                            <Text text="{= ${accessModel>selectedPersona} || (${accessModel>persona} &amp;&amp; ${accessModel>persona} !== 'Requester' ? ${accessModel>persona} : 'Frontend &amp; UI Developer Persona') }" class="kyraUserDetailsText" />
                            <Text text="{accessModel>sector}" wrapping="true" class="kyraSectorText" />
                            <Text text="{= ${accessModel>serviceTopic} || ${accessModel>function} }" wrapping="true" class="kyraFunctionText" />
                            <Text text="{accessModel>decisionDate}" class="kyraDateText" />
                            <ObjectStatus
                                text="{accessModel>status}"
                                state="{accessModel>statusState}"
                                icon="{accessModel>statusIcon}"
                                class="kyraApproverStatusBadge" />
                            <HBox justifyContent="Center" alignItems="Center">
                                <Button
                                    text="View"
                                    icon="sap-icon://hint"
                                    type="Transparent"
                                    press=".onOpenDecisionBreakdownDialog"
                                    tooltip="View Approved and Rejected Details"
                                    class="kyraBreakdownViewBtn" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </VBox>
</mvc:View>
