<mvc:View
    controllerName="kyra001.pages.Approver.ApproverDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core">

    <Page id="approverDetailPage" showHeader="false" enableScrolling="true" class="kyraGovPageBg">
        <content>
            <VBox class="kyraGovPageContainer fioriStepSlideAnim">
                <!-- Page Header: Avatar + Title + Subtitle + Back to Portal Button -->
                <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="kyraGovHeaderRow sapUiSmallMarginBottom" width="100%">
                    <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                        <Avatar
                            src="sap-icon://customer"
                            displaySize="M"
                            class="kyraGovHeaderAvatar sapUiSmallMarginEnd" />
                        <VBox>
                            <Title text="Access Request Governance Review" level="H2" class="kyraGovHeaderTitle" />
                            <Text text="Review and validate entitlement request before approval" class="kyraGovHeaderSubtitle" />
                        </VBox>
                    </HBox>
                    <Button
                        text="Back"
                        icon="sap-icon://navigation-left-arrow"
                        press=".onCloseRequestSummaryView"
                        class="kyraBackTealBtn"
                        tooltip="Back to Dashboard" />
                </HBox>

                <!-- CARD 1: REQUEST & REQUESTER OVERVIEW CARD (Matching Exact Design from Template) -->
                <VBox class="kyraGovCard kyraGovOverviewCard sapUiSmallMarginBottom">
                    <!-- Mint Banner Box: User ID + Subtitle + Pending Status Badge -->
                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="kyraGovRequestBannerBox" width="100%">
                        <HBox alignItems="Center">
                            <HBox class="kyraGovDocIconBox" justifyContent="Center" alignItems="Center">
                                <core:Icon src="sap-icon://customer" class="kyraGovDocIcon" />
                            </HBox>
                            <VBox class="sapUiSmallMarginBegin">
                                <Text text="User ID" class="kyraGovInfoLabel" />
                                <Title text="{= ${accessModel>/selectedRequest/requesterId} || 'Stake001' }" level="H4" class="kyraGovBannerReqNum" />
                                <Text text="Employee access governance review" class="kyraGovBannerReqSub" />
                            </VBox>
                        </HBox>
                        <HBox class="kyraGovPendingBadge" alignItems="Center">
                            <core:Icon src="sap-icon://history" class="kyraGovPendingClockIcon sapUiTinyMarginEnd" />
                            <Text text="{accessModel>/selectedRequest/status}" class="kyraGovPendingBadgeText" />
                        </HBox>
                    </HBox>

                    <!-- Row 1: 4-Column Grid (Business Sector, Business Function, Region, Duration) -->
                    <HBox class="kyraGovRequesterGrid" width="100%">
                        <!-- Column 1: Business Sector -->
                        <VBox class="kyraGovRequesterCol" width="25%">
                            <HBox alignItems="Center" class="kyraGovInfoItem">
                                <HBox class="kyraGovInfoIconCircle" justifyContent="Center" alignItems="Center">
                                    <core:Icon src="sap-icon://building" class="kyraGovInfoIcon" />
                                </HBox>
                                <VBox class="sapUiSmallMarginBegin">
                                    <Text text="Business Sector" class="kyraGovInfoLabel" />
                                    <Text text="{= (${accessModel>/selectedRequest/businessSector} &amp;&amp; ${accessModel>/selectedRequest/businessSector} !== '—' &amp;&amp; ${accessModel>/selectedRequest/businessSector} !== '–' &amp;&amp; ${accessModel>/selectedRequest/businessSector} !== '-') ? ${accessModel>/selectedRequest/businessSector} : ((${accessModel>/selectedRequest/sector} &amp;&amp; ${accessModel>/selectedRequest/sector} !== '—' &amp;&amp; ${accessModel>/selectedRequest/sector} !== '–' &amp;&amp; ${accessModel>/selectedRequest/sector} !== '-') ? ${accessModel>/selectedRequest/sector} : 'Global Supply Chain &amp; Logistics') }" class="kyraGovInfoValue" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Column 2: Business Function -->
                        <VBox class="kyraGovRequesterCol" width="25%">
                            <HBox alignItems="Center" class="kyraGovInfoItem">
                                <HBox class="kyraGovInfoIconCircle" justifyContent="Center" alignItems="Center">
                                    <core:Icon src="sap-icon://action-settings" class="kyraGovInfoIcon" />
                                </HBox>
                                <VBox class="sapUiSmallMarginBegin">
                                    <Text text="Business Function" class="kyraGovInfoLabel" />
                                    <Text text="{= (${accessModel>/selectedRequest/businessFunction} &amp;&amp; ${accessModel>/selectedRequest/businessFunction} !== '—' &amp;&amp; ${accessModel>/selectedRequest/businessFunction} !== '–' &amp;&amp; ${accessModel>/selectedRequest/businessFunction} !== '-') ? ${accessModel>/selectedRequest/businessFunction} : ((${accessModel>/selectedRequest/function} &amp;&amp; ${accessModel>/selectedRequest/function} !== '—' &amp;&amp; ${accessModel>/selectedRequest/function} !== '–' &amp;&amp; ${accessModel>/selectedRequest/function} !== '-') ? ${accessModel>/selectedRequest/function} : 'Procurement Audit') }" class="kyraGovInfoValue" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Column 3: Region -->
                        <VBox class="kyraGovRequesterCol" width="25%">
                            <HBox alignItems="Center" class="kyraGovInfoItem">
                                <HBox class="kyraGovInfoIconCircle" justifyContent="Center" alignItems="Center">
                                    <core:Icon src="sap-icon://locate-me" class="kyraGovInfoIcon" />
                                </HBox>
                                <VBox class="sapUiSmallMarginBegin">
                                    <Text text="Region" class="kyraGovInfoLabel" />
                                    <Text text="{= (${accessModel>/selectedRequest/operatingRegion} &amp;&amp; ${accessModel>/selectedRequest/operatingRegion} !== '—' &amp;&amp; ${accessModel>/selectedRequest/operatingRegion} !== '–' &amp;&amp; ${accessModel>/selectedRequest/operatingRegion} !== '-') ? ${accessModel>/selectedRequest/operatingRegion} : ((${accessModel>/selectedRequest/region} &amp;&amp; ${accessModel>/selectedRequest/region} !== '—' &amp;&amp; ${accessModel>/selectedRequest/region} !== '–' &amp;&amp; ${accessModel>/selectedRequest/region} !== '-') ? ${accessModel>/selectedRequest/region} : 'Africa') }" class="kyraGovInfoValue" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Column 4: Duration -->
                        <VBox class="kyraGovRequesterCol kyraGovRequesterColLast" width="25%">
                            <HBox alignItems="Center" class="kyraGovInfoItem">
                                <HBox class="kyraGovInfoIconCircle" justifyContent="Center" alignItems="Center">
                                    <core:Icon src="sap-icon://suitcase" class="kyraGovInfoIcon" />
                                </HBox>
                                <VBox class="sapUiSmallMarginBegin">
                                    <Text text="Duration" class="kyraGovInfoLabel" />
                                    <Text text="{= (${accessModel>/selectedRequest/accessDuration} &amp;&amp; ${accessModel>/selectedRequest/accessDuration} !== '—' &amp;&amp; ${accessModel>/selectedRequest/accessDuration} !== '–' &amp;&amp; ${accessModel>/selectedRequest/accessDuration} !== '-') ? ${accessModel>/selectedRequest/accessDuration} : ((${accessModel>/selectedRequest/duration} &amp;&amp; ${accessModel>/selectedRequest/duration} !== '—' &amp;&amp; ${accessModel>/selectedRequest/duration} !== '–' &amp;&amp; ${accessModel>/selectedRequest/duration} !== '-') ? ${accessModel>/selectedRequest/duration} : 'Permanent') }" class="kyraGovInfoValue" />
                                </VBox>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- Row 2: Business Justification -->
                    <HBox width="100%" alignItems="Center" class="sapUiMediumMarginTop">
                        <HBox alignItems="Center" class="kyraGovInfoItem" width="100%">
                            <HBox class="kyraGovInfoIconCircle" justifyContent="Center" alignItems="Center">
                                <core:Icon src="sap-icon://document-text" class="kyraGovInfoIcon" />
                            </HBox>
                            <VBox class="sapUiSmallMarginBegin">
                                <Text text="Business Justification" class="kyraGovInfoLabel" />
                                <Text text="{= (${accessModel>/selectedRequest/justification} &amp;&amp; ${accessModel>/selectedRequest/justification} !== '—' &amp;&amp; ${accessModel>/selectedRequest/justification} !== '–' &amp;&amp; ${accessModel>/selectedRequest/justification} !== '-') ? ${accessModel>/selectedRequest/justification} : 'Standard business operational access and governance privileges.' }" class="kyraGovInfoValue" />
                            </VBox>
                        </HBox>
                    </HBox>
                </VBox>



                <!-- CARD 2: SOD CONFLICT REVIEW SECTION (Visible only when conflicts exist) -->
                <VBox class="fioriTableCard sapUiResponsivePadding sapUiSmallMarginBottom" visible="{= ((${accessModel>/selectedRequestSodActiveConflicts} &amp;&amp; ${accessModel>/selectedRequestSodActiveConflicts}.length > 0) || (${accessModel>/selectedRequestSodPendingConflicts} &amp;&amp; ${accessModel>/selectedRequestSodPendingConflicts}.length > 0) || (${accessModel>/selectedRequestSodBatchConflicts} &amp;&amp; ${accessModel>/selectedRequestSodBatchConflicts}.length > 0)) }">
                    <!-- Top Action Bar -->
                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="kyraSodActionBar sapUiSmallMarginBottom" width="100%">
                        <HBox alignItems="Center">
                            <Title text="SoD Conflict Review" level="H3" class="sapUiTinyMarginEnd" />
                            <Text text="|" class="kyraSodDivider sapUiSmallMarginBegin sapUiSmallMarginEnd" />
                            <Text text="Requester ID:" class="kyraSodReqLabel sapUiTinyMarginEnd" />
                            <Text text="{= ${accessModel>/selectedRequest/requesterId} || 'Stake001' }" class="kyraSodReqValue" />
                        </HBox>
                    </HBox>

                    <!-- ================= SINGLE UNIFIED SOD CONFLICT REVIEW ================= -->
                    <!-- 1. FIRST: EXISTING ACCESS - CONFLICTS WITH ACTIVE / EXISTING ACCESS -->
                    <VBox class="kyraSodRedCard sapUiSmallMarginBottom">
                        <!-- Card Header -->
                        <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%">
                            <HBox alignItems="Center">
                                <Avatar src="sap-icon://alert" class="kyraSodAvatarRed sapUiSmallMarginEnd" displaySize="S" />
                                <VBox>
                                    <Title text="Conflicts with Active / Existing Access" level="H5" class="kyraSodTitleRed" />
                                    <Text text="Conflicts detected against active system access entitlements." class="kyraSodSubtitle" />
                                </VBox>
                            </HBox>
                            <HBox class="{= (${accessModel>/selectedRequestSodActiveConflicts} &amp;&amp; ${accessModel>/selectedRequestSodActiveConflicts}.length > 0) ? 'kyraPillBadgeDanger' : 'kyraPillBadgeSuccess' }" alignItems="Center">
                                <core:Icon src="{= (${accessModel>/selectedRequestSodActiveConflicts} &amp;&amp; ${accessModel>/selectedRequestSodActiveConflicts}.length > 0) ? 'sap-icon://alert' : 'sap-icon://accept' }" size="12px" class="sapUiTinyMarginEnd" />
                                <Text text="{= (${accessModel>/selectedRequestSodActiveConflicts} ? ${accessModel>/selectedRequestSodActiveConflicts}.length : 0) + ' Conflicts' }" class="{= (${accessModel>/selectedRequestSodActiveConflicts} &amp;&amp; ${accessModel>/selectedRequestSodActiveConflicts}.length > 0) ? 'kyraPillBadgeDangerText' : 'kyraPillBadgeSuccessText' }" />
                            </HBox>
                        </HBox>

                        <!-- 3-Column Header Bar: 35% / 35% / 30% -->
                        <HBox class="kyraSodTableHeadRed" width="100%" alignItems="Center" visible="{= ${accessModel>/selectedRequestSodActiveConflicts} &amp;&amp; ${accessModel>/selectedRequestSodActiveConflicts}.length > 0 }">
                            <HBox width="35%" class="kyraSodHeadCol"><Text text="EXISTING ACCESS" class="kyraSodColHeader" /></HBox>
                            <HBox width="35%" class="kyraSodHeadCol"><Text text="NEWLY ADDED ACCESS" class="kyraSodColHeader" /></HBox>
                            <HBox width="30%" class="kyraSodHeadCol"><Text text="SEGREGATION OF DUTIES (SOD) CONFLICT DETAIL" class="kyraSodColHeader" /></HBox>
                        </HBox>

                        <!-- Dynamic Active Conflict Rows -->
                        <VBox items="{accessModel>/selectedRequestSodActiveConflicts}" visible="{= ${accessModel>/selectedRequestSodActiveConflicts} &amp;&amp; ${accessModel>/selectedRequestSodActiveConflicts}.length > 0 }">
                            <HBox class="kyraSodContentRow" alignItems="Center" width="100%">
                                <HBox width="35%" class="kyraSodColWrapper">
                                    <HBox class="kyraSodBoxYellowCard1" width="100%" alignItems="Center">
                                        <Avatar src="sap-icon://customer" class="kyraSodAvatarYellow sapUiTinyMarginEnd" displaySize="S" />
                                        <VBox class="kyraSodCardTextGroup">
                                            <Text text="{accessModel>existingRole}" class="kyraSodBoxTitle" />
                                            <Text text="{accessModel>existingPersona}" class="kyraSodBoxSubtitle" />
                                        </VBox>
                                    </HBox>
                                </HBox>
                                <HBox width="35%" class="kyraSodColWrapper">
                                    <HBox class="kyraSodBoxYellowCard2" width="100%" alignItems="Center">
                                        <Avatar src="sap-icon://database" class="kyraSodAvatarBlue sapUiTinyMarginEnd" displaySize="S" />
                                        <VBox class="kyraSodCardTextGroup">
                                            <Text text="{accessModel>newRole}" class="kyraSodBoxTitle" />
                                            <Text text="{accessModel>newPersona}" class="kyraSodBoxSubtitle" />
                                        </VBox>
                                    </HBox>
                                </HBox>
                                <HBox width="30%" class="kyraSodColWrapper kyraSodConflictWrapper" alignItems="Center">
                                    <HBox class="kyraSodConflictDetailBoxAmber" width="100%" alignItems="Center">
                                        <core:Icon src="sap-icon://alert" class="kyraSodAlertLargeIconAmber sapUiTinyMarginEnd" />
                                        <VBox class="kyraSodConflictTextGroup">
                                            <Text text="{accessModel>conflictTitle}" class="kyraSodConflictMainTitleAmber" />
                                            <Text text="{accessModel>conflictDesc}" class="kyraSodConflictMainDesc" />
                                        </VBox>
                                    </HBox>
                                </HBox>
                            </HBox>
                        </VBox>

                        <!-- Compact Empty State -->
                        <VBox class="kyraSodEmptyBoxRed" alignItems="Center" justifyContent="Center" visible="{= !${accessModel>/selectedRequestSodActiveConflicts} || ${accessModel>/selectedRequestSodActiveConflicts}.length === 0 }">
                            <HBox class="kyraSodRedCircleCompact" justifyContent="Center" alignItems="Center">
                                <core:Icon src="sap-icon://accept" class="kyraSodMintIconCompact" />
                            </HBox>
                            <Text text="No SoD Conflicts with Active / Existing Access" class="kyraSodEmptyTitleGreen" />
                            <Text text="Great! No conflicts found between active access and new requests." class="kyraSodEmptyDesc" />
                        </VBox>
                    </VBox>

                    <!-- 2. NEXT: EXISTING ACCESS - CONFLICTS WITH IN-FLIGHT / PENDING ACCESS REQUESTS -->
                    <VBox class="kyraSodYellowCard sapUiSmallMarginBottom">
                        <!-- Card Header -->
                        <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%">
                            <HBox alignItems="Center">
                                <Avatar src="sap-icon://alert" class="kyraSodAvatarAmber sapUiSmallMarginEnd" displaySize="S" />
                                <VBox>
                                    <Title text="Conflicts with In-Flight / Pending Access Requests" level="H5" class="kyraSodTitleAmber" />
                                    <Text text="Conflicts detected against pending access requests currently undergoing approval." class="kyraSodSubtitle" />
                                </VBox>
                            </HBox>
                            <HBox class="{= (${accessModel>/selectedRequestSodPendingConflicts} &amp;&amp; ${accessModel>/selectedRequestSodPendingConflicts}.length > 0) ? 'kyraPillBadgeWarning' : 'kyraPillBadgeSuccess' }" alignItems="Center">
                                <core:Icon src="{= (${accessModel>/selectedRequestSodPendingConflicts} &amp;&amp; ${accessModel>/selectedRequestSodPendingConflicts}.length > 0) ? 'sap-icon://alert' : 'sap-icon://accept' }" size="12px" class="sapUiTinyMarginEnd" />
                                <Text text="{= (${accessModel>/selectedRequestSodPendingConflicts} ? ${accessModel>/selectedRequestSodPendingConflicts}.length : 0) + ' Conflicts' }" class="{= (${accessModel>/selectedRequestSodPendingConflicts} &amp;&amp; ${accessModel>/selectedRequestSodPendingConflicts}.length > 0) ? 'kyraPillBadgeWarningText' : 'kyraPillBadgeSuccessText' }" />
                            </HBox>
                        </HBox>

                        <!-- 3-Column Header Bar: 35% / 35% / 30% -->
                        <HBox class="kyraSodTableHeadYellow" width="100%" alignItems="Center" visible="{= ${accessModel>/selectedRequestSodPendingConflicts} &amp;&amp; ${accessModel>/selectedRequestSodPendingConflicts}.length > 0 }">
                            <HBox width="35%" class="kyraSodHeadCol"><Text text="EXISTING ACCESS" class="kyraSodColHeader" /></HBox>
                            <HBox width="35%" class="kyraSodHeadCol"><Text text="NEWLY ADDED ACCESS" class="kyraSodColHeader" /></HBox>
                            <HBox width="30%" class="kyraSodHeadCol"><Text text="SEGREGATION OF DUTIES (SOD) CONFLICT DETAIL" class="kyraSodColHeader" /></HBox>
                        </HBox>

                        <!-- Dynamic Pending Conflict Rows -->
                        <VBox items="{accessModel>/selectedRequestSodPendingConflicts}" visible="{= ${accessModel>/selectedRequestSodPendingConflicts} &amp;&amp; ${accessModel>/selectedRequestSodPendingConflicts}.length > 0 }">
                            <HBox class="kyraSodContentRow" alignItems="Center" width="100%">
                                <HBox width="35%" class="kyraSodColWrapper">
                                    <HBox class="kyraSodBoxYellowCard1" width="100%" alignItems="Center">
                                        <Avatar src="sap-icon://customer" class="kyraSodAvatarYellow sapUiTinyMarginEnd" displaySize="S" />
                                        <VBox class="kyraSodCardTextGroup">
                                            <Text text="{accessModel>existingRole}" class="kyraSodBoxTitle" />
                                            <Text text="{accessModel>existingPersona}" class="kyraSodBoxSubtitle" />
                                        </VBox>
                                    </HBox>
                                </HBox>
                                <HBox width="35%" class="kyraSodColWrapper">
                                    <HBox class="kyraSodBoxYellowCard2" width="100%" alignItems="Center">
                                        <Avatar src="sap-icon://database" class="kyraSodAvatarBlue sapUiTinyMarginEnd" displaySize="S" />
                                        <VBox class="kyraSodCardTextGroup">
                                            <Text text="{accessModel>newRole}" class="kyraSodBoxTitle" />
                                            <Text text="{accessModel>newPersona}" class="kyraSodBoxSubtitle" />
                                        </VBox>
                                    </HBox>
                                </HBox>
                                <HBox width="30%" class="kyraSodColWrapper kyraSodConflictWrapper" alignItems="Center">
                                    <HBox class="kyraSodConflictDetailBoxAmber" width="100%" alignItems="Center">
                                        <core:Icon src="sap-icon://alert" class="kyraSodAlertLargeIconAmber sapUiTinyMarginEnd" />
                                        <VBox class="kyraSodConflictTextGroup">
                                            <Text text="{accessModel>conflictTitle}" class="kyraSodConflictMainTitleAmber" />
                                            <Text text="{accessModel>conflictDesc}" class="kyraSodConflictMainDesc" />
                                        </VBox>
                                    </HBox>
                                </HBox>
                            </HBox>
                        </VBox>

                        <!-- Clean Empty State when NO pending conflicts exist -->
                        <VBox class="kyraSodEmptyBoxRed" alignItems="Center" justifyContent="Center" visible="{= !${accessModel>/selectedRequestSodPendingConflicts} || ${accessModel>/selectedRequestSodPendingConflicts}.length === 0 }">
                            <HBox class="kyraSodRedCircleCompact" justifyContent="Center" alignItems="Center">
                                <core:Icon src="sap-icon://accept" class="kyraSodMintIconCompact" />
                            </HBox>
                            <Text text="No SoD Conflicts with In-Flight / Pending Access Requests" class="kyraSodEmptyTitleGreen" />
                            <Text text="Great! No conflicts detected against your pending access requests." class="kyraSodEmptyDesc" />
                        </VBox>
                    </VBox>

                    <!-- 3. NEXT DOWN: NEW ACCESS - CONFLICTS WITHIN CURRENT REQUEST BATCH (INTRA-ROLE) -->
                    <VBox class="kyraSodGreenCard">
                        <!-- Card Header -->
                        <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%">
                            <HBox alignItems="Center">
                                <Avatar src="sap-icon://document-text" class="kyraSodAvatarGreen sapUiSmallMarginEnd" displaySize="S" />
                                <VBox>
                                    <Title text="Conflicts Within Current Request Batch (Intra-Role)" level="H5" class="kyraSodTitleGreen" />
                                    <Text text="Conflicts detected between multiple roles selected together in this request." class="kyraSodSubtitle" />
                                </VBox>
                            </HBox>
                            <HBox class="{= (${accessModel>/selectedRequestSodBatchConflicts} &amp;&amp; ${accessModel>/selectedRequestSodBatchConflicts}.length > 0) ? 'kyraPillBadgeWarning' : 'kyraPillBadgeSuccess' }" alignItems="Center">
                                <core:Icon src="{= (${accessModel>/selectedRequestSodBatchConflicts} &amp;&amp; ${accessModel>/selectedRequestSodBatchConflicts}.length > 0) ? 'sap-icon://alert' : 'sap-icon://accept' }" size="12px" class="sapUiTinyMarginEnd" />
                                <Text text="{= (${accessModel>/selectedRequestSodBatchConflicts} ? ${accessModel>/selectedRequestSodBatchConflicts}.length : 0) + ' Conflicts' }" class="{= (${accessModel>/selectedRequestSodBatchConflicts} &amp;&amp; ${accessModel>/selectedRequestSodBatchConflicts}.length > 0) ? 'kyraPillBadgeWarningText' : 'kyraPillBadgeSuccessText' }" />
                            </HBox>
                        </HBox>

                        <!-- 3-Column Header Bar: 35% / 35% / 30% -->
                        <HBox class="kyraSodTableHeadGreen" width="100%" alignItems="Center" visible="{= ${accessModel>/selectedRequestSodBatchConflicts} &amp;&amp; ${accessModel>/selectedRequestSodBatchConflicts}.length > 0 }">
                            <HBox width="35%" class="kyraSodHeadCol"><Text text="NEWLY ADDED ACCESS (ROLE A)" class="kyraSodColHeader" /></HBox>
                            <HBox width="35%" class="kyraSodHeadCol"><Text text="NEWLY ADDED ACCESS (ROLE B)" class="kyraSodColHeader" /></HBox>
                            <HBox width="30%" class="kyraSodHeadCol"><Text text="SEGREGATION OF DUTIES (SOD) CONFLICT DETAIL" class="kyraSodColHeader" /></HBox>
                        </HBox>

                        <!-- Dynamic Batch Conflict Rows -->
                        <VBox items="{accessModel>/selectedRequestSodBatchConflicts}" visible="{= ${accessModel>/selectedRequestSodBatchConflicts} &amp;&amp; ${accessModel>/selectedRequestSodBatchConflicts}.length > 0 }">
                            <HBox class="kyraSodContentRow" alignItems="Center" width="100%">
                                <HBox width="35%" class="kyraSodColWrapper">
                                    <HBox class="kyraSodBoxYellowCard1" width="100%" alignItems="Center">
                                        <Avatar src="sap-icon://customer" class="kyraSodAvatarYellow sapUiTinyMarginEnd" displaySize="S" />
                                        <VBox class="kyraSodCardTextGroup">
                                            <Text text="{= ${accessModel>roleA} || ${accessModel>existingRole} }" class="kyraSodBoxTitle" />
                                            <Text text="{= ${accessModel>personaA} || ${accessModel>existingPersona} }" class="kyraSodBoxSubtitle" />
                                        </VBox>
                                    </HBox>
                                </HBox>
                                <HBox width="35%" class="kyraSodColWrapper">
                                    <HBox class="kyraSodBoxYellowCard2" width="100%" alignItems="Center">
                                        <Avatar src="sap-icon://database" class="kyraSodAvatarBlue sapUiTinyMarginEnd" displaySize="S" />
                                        <VBox class="kyraSodCardTextGroup">
                                            <Text text="{= ${accessModel>roleB} || ${accessModel>newRole} }" class="kyraSodBoxTitle" />
                                            <Text text="{= ${accessModel>personaB} || ${accessModel>newPersona} }" class="kyraSodBoxSubtitle" />
                                        </VBox>
                                    </HBox>
                                </HBox>
                                <HBox width="30%" class="kyraSodColWrapper kyraSodConflictWrapper" alignItems="Center">
                                    <HBox class="kyraSodConflictDetailBoxAmber" width="100%" alignItems="Center">
                                        <core:Icon src="sap-icon://alert" class="kyraSodAlertLargeIconAmber sapUiTinyMarginEnd" />
                                        <VBox class="kyraSodConflictTextGroup">
                                            <Text text="{accessModel>conflictTitle}" class="kyraSodConflictMainTitleAmber" />
                                            <Text text="{accessModel>conflictDesc}" class="kyraSodConflictMainDesc" />
                                        </VBox>
                                    </HBox>
                                </HBox>
                            </HBox>
                        </VBox>

                        <!-- Clean Centered Success State Below Headings -->
                        <VBox class="kyraSodEmptyBoxCompact" alignItems="Center" justifyContent="Center" visible="{= !${accessModel>/selectedRequestSodBatchConflicts} || ${accessModel>/selectedRequestSodBatchConflicts}.length === 0 }">
                            <HBox class="kyraSodMintCircleCompact" justifyContent="Center" alignItems="Center">
                                <core:Icon src="sap-icon://accept" class="kyraSodMintIconCompact" />
                            </HBox>
                            <Text text="No SoD Conflicts Within Current Request" class="kyraSodEmptyTitleGreen" />
                            <Text text="The selected roles do not conflict with each other." class="kyraSodEmptyDesc" />
                        </VBox>
                    </VBox>
                </VBox>

                <!-- CARD 3+: TARGET SYSTEMS SEPARATED TABLE CARDS (Matching Template Image 2) -->
                <VBox items="{accessModel>/selectedRequest/summaryTables}">
                    <items>
                        <VBox class="kyraGovCard kyraGovTargetSystemCard sapUiSmallMarginBottom">
                            <!-- Target System Header Banner at Top -->
                            <HBox alignItems="Center" class="kyraGovSystemHeader">
                                <HBox class="kyraGovCloudIconCircle" justifyContent="Center" alignItems="Center">
                                    <core:Icon src="sap-icon://cloud" class="kyraGovCloudIcon" />
                                </HBox>
                                <VBox class="sapUiSmallMarginBegin">
                                    <Title text="{= 'Target System ' + ${accessModel>systemIndex} + ': ' + ${accessModel>systemName} }" level="H4" class="kyraGovSystemTitle" />
                                    <Text text="{= ${accessModel>items}.length + ' Configured Entitlement(s)' }" class="kyraGovSystemSubtitle" />
                                </VBox>
                            </HBox>

                            <!-- Table Container with 8 Columns, Perfect Gaps, Alignment & Vertical Dividers -->
                            <VBox class="kyraGovTableWrapper">
                                <!-- 8-Column Header Row with Vertical Dividers -->
                                <HBox class="kyraGovTableHeadRow" width="100%" renderType="Bare">
                                    <HBox class="kyraGovHeadCol kyraGovHeadCol1" alignItems="Center"><Text text="REQUEST ID" class="kyraGovColHeadText" /></HBox>
                                    <HBox class="kyraGovHeadCol kyraGovHeadCol2" alignItems="Center"><Text text="TEAM" class="kyraGovColHeadText" /></HBox>
                                    <HBox class="kyraGovHeadCol kyraGovHeadCol3" alignItems="Center"><Text text="ROLES" class="kyraGovColHeadText" /></HBox>
                                    <HBox class="kyraGovHeadCol kyraGovHeadCol4" alignItems="Center"><Text text="SELECTED PERSONA" class="kyraGovColHeadText" /></HBox>
                                    <HBox class="kyraGovHeadCol kyraGovHeadCol5" alignItems="Center"><Text text="GRANTED DATE" class="kyraGovColHeadText" /></HBox>
                                    <HBox class="kyraGovHeadCol kyraGovHeadCol6" alignItems="Center" justifyContent="Center"><Text text="STATUS" class="kyraGovColHeadText" /></HBox>
                                    <HBox class="kyraGovHeadCol kyraGovHeadCol7" alignItems="Center"><Text text="REMARKS" class="kyraGovColHeadText" /></HBox>
                                    <HBox class="kyraGovHeadCol kyraGovHeadCol8 kyraGovHeadColLast" alignItems="Center" justifyContent="Center"><Text text="DECISION" class="kyraGovColHeadText" /></HBox>
                                </HBox>

                                <!-- Items List Container -->
                                <VBox items="{accessModel>items}" class="kyraGovTableBody">
                                    <items>
                                        <VBox class="kyraGovDataRowWrapper">
                                            <!-- Main Request Data Row (8 Columns with Matching Grid & Dividers) -->
                                            <HBox class="kyraGovDataRow" width="100%" renderType="Bare">
                                                <HBox class="kyraGovCell kyraGovCell1" alignItems="Center">
                                                    <Text text="{accessModel>requestId}" class="kyraGovReqIdText" />
                                                </HBox>
                                                <HBox class="kyraGovCell kyraGovCell2" alignItems="Center">
                                                    <Text text="{accessModel>team}" class="kyraGovTeamText" />
                                                </HBox>
                                                <HBox class="kyraGovCell kyraGovCell3" alignItems="Center">
                                                    <Text text="{accessModel>roleName}" class="kyraGovRoleText" />
                                                </HBox>
                                                <HBox class="kyraGovCell kyraGovCell4" alignItems="Center">
                                                    <Text text="{accessModel>selectedPersona}" class="kyraGovPersonaText" />
                                                </HBox>
                                                <HBox class="kyraGovCell kyraGovCell5" alignItems="Center">
                                                    <Text text="{accessModel>grantedDate}" class="kyraGovDateText" />
                                                </HBox>
                                                <HBox class="kyraGovCell kyraGovCell6" alignItems="Center" justifyContent="Center">
                                                    <ObjectStatus
                                                        text="{= (${accessModel>status} === 'Approved' || ${accessModel>status} === 'Active') ? 'Approved' : ((${accessModel>status} === 'Rejected' || ${accessModel>status} === 'Error') ? 'Rejected' : 'Pending') }"
                                                        state="{= (${accessModel>status} === 'Approved' || ${accessModel>status} === 'Active') ? 'Success' : ((${accessModel>status} === 'Rejected' || ${accessModel>status} === 'Error') ? 'Error' : 'Warning') }"
                                                        icon="{= (${accessModel>status} === 'Approved' || ${accessModel>status} === 'Active') ? 'sap-icon://sys-enter-2' : ((${accessModel>status} === 'Rejected' || ${accessModel>status} === 'Error') ? 'sap-icon://error' : 'sap-icon://history') }"
                                                        class="kyraTableStatusBadge kyraApproverStatusBadge" />
                                                </HBox>
                                                <HBox class="kyraGovCell kyraGovCell7" alignItems="Center">
                                                    <Input
                                                        value="{accessModel>comment}"
                                                        liveChange=".onRemarkLiveChange"
                                                        placeholder="Add remark..."
                                                        class="kyraGovRemarkInput"
                                                        width="100%" />
                                                </HBox>
                                                <HBox class="kyraGovCell kyraGovCell8 kyraGovCellLast" alignItems="Center" justifyContent="Center">
                                                    <Button
                                                        icon="sap-icon://accept"
                                                        press=".onAcceptEntitlement"
                                                        class="kyraGovApproveBtn"
                                                        tooltip="Approve this entitlement" />
                                                    <Button
                                                        icon="sap-icon://decline"
                                                        press=".onRejectEntitlement"
                                                        class="kyraGovRejectBtn"
                                                        tooltip="Reject this entitlement" />
                                                </HBox>
                                            </HBox>

                                            <!-- Approver Remark Sub-Row (Visible only for Compliance Reviewer) -->
                                            <HBox class="kyraApproverRemarkSubRow" alignItems="Center" width="100%" visible="{= ${accessModel>/isCompliancePersona} === true }">
                                                <Text text="Approver Remark:" class="kyraApproverRemarkLabel" />
                                                <Text text="{accessModel>approverRemark}" class="kyraApproverRemarkContent sapUiTinyMarginBegin" />
                                            </HBox>
                                        </VBox>
                                    </items>
                                </VBox>
                            </VBox>
                        </VBox>
                    </items>
                </VBox>

                <!-- Batch Operations & Footer Action Bar -->
                <VBox class="kyraGovCard kyraGovBottomCard sapUiSmallMarginBottom">
                    <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" width="100%">
                        <HBox alignItems="Center" class="kyraGovBottomLeftBtns sapUiTinyMarginBottom">
                            <Button
                                text="Approve All"
                                icon="sap-icon://accept"
                                press=".onAcceptAllRequests"
                                class="kyraBatchApproveBtn"
                                tooltip="Approve all entitlements" />
                            <Button
                                text="Reject All"
                                icon="sap-icon://decline"
                                press=".onRejectAllRequests"
                                class="kyraBatchRejectBtn"
                                tooltip="Reject all entitlements" />
                        </HBox>
                        <HBox alignItems="Center" class="kyraGovBottomRightBtns">
                            <Button
                                text="Back"
                                icon="sap-icon://navigation-left-arrow"
                                press=".onCloseRequestSummaryView"
                                class="kyraBackTealBtn"
                                tooltip="Back to Dashboard" />
                            <Button
                                text="Submit Decision"
                                icon="sap-icon://navigation-right-arrow"
                                iconFirst="false"
                                type="Emphasized"
                                press=".onApproveSelectedRequest"
                                class="kyraPrimaryBtn fioriEmphasizedBtn"
                                tooltip="Submit Decision" />
                        </HBox>
                    </HBox>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
