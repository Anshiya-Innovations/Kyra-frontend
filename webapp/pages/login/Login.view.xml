<mvc:View
    controllerName="kyra001.pages.login.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    
    <Page showHeader="false" enableScrolling="false" class="kyraDesktopLoginPage">
        <content>
            <FlexBox class="kyraLoginLayoutWrapper" direction="Row" wrap="Wrap" height="100%" width="100%">
                
                <!-- ================= LEFT SECTION (50% COLUMN - PURE VECTOR SECURITY ARCHITECTURE) ================= -->
                <VBox class="kyraLoginLeftPanel" justifyContent="Center" alignItems="Center">
                    
                    <!-- Top-Left Branding Header -->
                    <HBox alignItems="Center" class="kyraLeftBrandHeader">
                        <Image src="{login>/brandHeaderUrl}" height="42px" densityAware="false" class="kyraBrandHeaderImg" />
                    </HBox>

                    <!-- Main Hero Content: Headline with Teal Accent Bar, Styled Description and Native Vector Security Architecture -->
                    <VBox class="kyraLeftCenteredBlock" justifyContent="Center" alignItems="Start">
                        <VBox class="kyraHeroTitleContainer">
                            <Text text="Secure Access." class="kyraHeroTitleWhite" />
                            <Text text="Total Control." class="kyraHeroTitleTeal" />
                            <HBox class="kyraHeroTealDashBar" />
                        </VBox>
                        
                        <!-- Formatted Governance Description with Highlighted Hybrid Cloud Ecosystem -->
                        <FormattedText
                            htmlText="Centralized enterprise identity governance, dynamic role entitlement provisioning, and continuous automated compliance across your &lt;span class='kyraTealHighlight'&gt;hybrid cloud ecosystem.&lt;/span&gt;"
                            class="kyraHeroDescription" />

                        <!-- Native Vector Security Architecture Graphic (Zero Image Compression Seams) -->
                        <VBox class="kyraHeroVectorGraphicContainer" alignItems="Center" justifyContent="Center" width="100%">
                            <Image src="{login>/securityVectorUrl}" width="100%" maxWidth="520px" densityAware="false" class="kyraSecurityVectorImgNative" />
                        </VBox>
                    </VBox>
                </VBox>

                <!-- ================= RIGHT SECTION (50% COLUMN - DEAD VERTICAL CENTER LOGIN CARD) ================= -->
                <VBox class="kyraLoginRightPanel" justifyContent="Center" alignItems="Center">
                    <VBox class="kyraLoginCardContainer">
                        
                        <!-- Top Card Header: Centered KYRA Logo + Wordmark + Portals -->
                        <VBox alignItems="Center" class="kyraCardHeaderBox">
                            <Image src="{login>/logoUrl}" height="42px" densityAware="false" class="kyraCardLogoImgDirect" />
                            <Text text="KYRA" class="kyraCardBrandTitle" />
                            <Text text="ENTERPRISE ACCESS" class="kyraCardBrandSub" />
                            <Text text="Secure Admin Access Portal" class="kyraCardPortalTitle" />
                            <Text text="Welcome back! Please sign in to continue." class="kyraCardWelcomeText" />
                        </VBox>

                        <!-- Error Notification MessageStrip -->
                        <MessageStrip
                            visible="{login>/hasError}"
                            text="{login>/errorMessage}"
                            type="Error"
                            showIcon="true"
                            showCloseButton="true"
                            close=".onDismissError"
                            class="sapUiTinyMarginBottom" />

                        <!-- Form Controls Container -->
                        <VBox width="100%" class="kyraLoginFormBody">
                            
                            <!-- Login As Dropdown -->
                            <VBox class="kyraFormGroup" width="100%">
                                <Label text="Login As" labelFor="roleSelect" class="kyraFormLabel" />
                                <Select
                                    id="roleSelect"
                                    selectedKey="{login>/selectedRole}"
                                    change=".onRoleChange"
                                    width="100%"
                                    class="kyraModernSelect">
                                    <items>
                                        <core:Item key="Requester" text="Requester" icon="sap-icon://customer" />
                                        <core:Item key="Approver" text="Approver" icon="sap-icon://shield" />
                                        <core:Item key="Compliance Review" text="Compliance Review" icon="sap-icon://user-settings" />
                                    </items>
                                </Select>
                            </VBox>

                            <!-- Dynamic ID Input Field -->
                            <VBox class="kyraFormGroup" width="100%">
                                <Label text="{login>/idLabel}" labelFor="idInput" class="kyraFormLabel" />
                                <Input
                                    id="idInput"
                                    value="{login>/userId}"
                                    placeholder="{login>/idPlaceholder}"
                                    valueState="{login>/idState}"
                                    valueStateText="{login>/idStateText}"
                                    liveChange=".onInputChange"
                                    change=".onInputChange"
                                    submit=".onLogin"
                                    showClearButton="true"
                                    class="kyraModernInput"
                                    width="100%" />
                            </VBox>

                            <!-- Full Width Solid #008C9C Sign In Button -->
                            <Button
                                id="signInButton"
                                text="Sign In"
                                type="Emphasized"
                                width="100%"
                                press=".onLogin"
                                busy="{login>/isBusy}"
                                class="kyraPrimarySignInBtn" />

                        </VBox>
                    </VBox>
                </VBox>

            </FlexBox>
        </content>
    </Page>
</mvc:View>