<mvc:View
    controllerName="kyra001.pages.addAccess.AddAccess"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true">

    <Page showHeader="false" enableScrolling="true" class="fioriDashboardBg">
        <content>
            <!-- Enterprise ShellBar Header -->
            <f:ShellBar
                title="KYRA Enterprise"
                secondTitle="User Access Management Portal"
                homeIcon="sap-icon://shield"
                showCopilot="false"
                showSearch="true"
                showNotifications="true"
                notificationsNumber="3">
                <f:profile>
                    <Avatar initials="DU" backgroundColor="Accent1" />
                </f:profile>
                <f:additionalContent>
                    <Button
                        text="Back to User Portal"
                        type="Transparent"
                        press=".onNavBackToPortal"
                        class="kyraSignOutHeaderBtn"
                        tooltip="Back to Access Portal" />
                </f:additionalContent>
            </f:ShellBar>

            <!-- Main Content Container -->
            <VBox class="fioriMainContentBox fioriBottomPaddingBox">
                <!-- Enterprise Top Header Banner (Matching Dashboard Top) -->
                <VBox class="fioriWelcomeCard sapUiSmallMarginBottom">
                    <!-- Security Shield Focus Background Emblem (Center Pulse Effect) -->
                    <HBox class="kyraBannerShieldFocus" alignItems="Center" justifyContent="Center">
                        <Image src="{= ${addAccessModel>/shieldFocusUrl} || 'images/kyra_shield_focus.svg' }" class="kyraShieldFocusImg" densityAware="false" alt="Security Shield" />
                    </HBox>

                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="kyraBannerRow">
                        <HBox alignItems="Center" class="kyraBannerLeftGroup">
                            <!-- KYRA Project Logo Badge (K Logo) -->
                            <HBox alignItems="Center" justifyContent="Center" class="kyraBannerShieldAvatar" tooltip="KYRA Governance Portal">
                                <Image src="{= ${addAccessModel>/brandLogoUrl} || 'images/kyra_k_logo.png' }" width="30px" height="36px" densityAware="false" class="kyraBannerLogoImg" alt="KYRA Logo" />
                            </HBox>
                            <VBox class="kyraBannerTextGroup">
                                <Title text="KYRA Access Management" level="H2" class="fioriWelcomeTitle" />
                                <HBox alignItems="Center" class="kyraBannerPersonaRow">
                                    <Text text="Active Persona:" class="fioriWelcomeSubtitle" />
                                    <Text text="{= ${addAccessModel>/activeRole} || 'Approver' }" class="kyraHeaderRolePill" />
                                </HBox>
                            </VBox>
                        </HBox>
                        <HBox alignItems="Center" class="kyraBannerRightControls">
                            <!-- User ID Pill Badge -->
                            <HBox alignItems="Center" class="kyraHeaderUserIdPill">
                                <core:Icon src="sap-icon://customer" class="kyraUserIdIcon" />
                                <Text text="User ID:" class="kyraUserIdLabel" />
                                <Text text="{= ${addAccessModel>/activeUser} || 'emp081' }" class="kyraUserIdValue" />
                            </HBox>
                        </HBox>
                    </HBox>
                </VBox>

                <!-- STEP 1 CONTAINER: BUSINESS SECTOR &amp; BUSINESS FUNCTION -->
                <VBox
                    visible="{addAccessModel>/step1Visible}"
                    class="fioriTableCard sapUiResponsivePadding sapUiSmallMarginBottom">
                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                        <HBox alignItems="Center">
                            <Avatar src="sap-icon://building" backgroundColor="Accent1" displaySize="S" class="sapUiTinyMarginEnd" />
                            <VBox>
                                <Title text="Step 1: Business Sector and Business Function Selection" level="H4" />
                                <Text text="Select your target enterprise sector and operational business function below." class="fioriDescriptionText" />
                            </VBox>
                        </HBox>
                        <Button
                            icon="sap-icon://decline"
                            type="Transparent"
                            press=".onNavBackToPortal"
                            tooltip="Close Add Access Section"
                            ariaLabel="Close Add Access"
                            class="kyraCloseIconBtn kyraAddAccessCloseBtn" />
                    </HBox>

                    <form:SimpleForm
                        editable="true"
                        layout="ColumnLayout"
                        columnsM="2"
                        columnsL="2"
                        singleContainerFullWidth="false">
                        <form:content>
                            <core:Title text="Business Sector Configuration" />
                            
                            <Label text="Business Sector" required="true" />
                            <Select
                                id="businessSectorSelect"
                                selectedKey="{addAccessModel>/sector}"
                                change=".onSectorChange"
                                width="100%"
                                class="fioriFormSelect">
                                <core:Item key="" text="-- Select Business Sector --" />
                                <core:Item key="Finance &amp; Enterprise Performance" text="Finance &amp; Enterprise Performance" icon="sap-icon://money-bills" />
                                <core:Item key="Global Supply Chain &amp; Logistics" text="Global Supply Chain &amp; Logistics" icon="sap-icon://shipping-status" />
                                <core:Item key="Human Capital Management (HCM)" text="Human Capital Management (HCM)" icon="sap-icon://group" />
                                <core:Item key="Information Technology &amp; Security" text="Information Technology &amp; Security" icon="sap-icon://shield" />
                                <core:Item key="Customer Operations &amp; Sales" text="Customer Operations &amp; Sales" icon="sap-icon://customer-briefing" />
                            </Select>

                            <core:Title text="Business Function Alignment" />

                            <Label text="Business Function" required="true" />
                            <Select
                                id="businessFunctionSelect"
                                selectedKey="{addAccessModel>/function}"
                                items="{addAccessModel>/functionsList}"
                                width="100%"
                                class="fioriFormSelect">
                                <core:Item key="{addAccessModel>key}" text="{addAccessModel>text}" icon="{addAccessModel>icon}" />
                            </Select>
                        </form:content>
                    </form:SimpleForm>

                    <HBox justifyContent="End" class="sapUiSmallMarginTop">
                        <Button
                            text="Cancel"
                            type="Default"
                            press=".onNavBackToPortal"
                            class="kyraSecondaryBtn sapUiTinyMarginEnd" />
                        <Button
                            text="Next"
                            type="Emphasized"
                            press=".onGoToStep2"
                            class="fioriEmphasizedBtn" />
                    </HBox>
                </VBox>

                <!-- STEP 2 CONTAINER: ADD ACCESS REQUEST (REGION, SYSTEMS, SERVICES, TEAM &amp; PERSONA) -->
                <VBox
                    visible="{addAccessModel>/step2Visible}"
                    class="fioriTableCard sapUiResponsivePadding sapUiSmallMarginBottom">
                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                        <HBox alignItems="Center">
                            <Avatar src="sap-icon://system" backgroundColor="Accent2" displaySize="S" class="sapUiTinyMarginEnd" />
                            <VBox>
                                <Title text="Add Access Request" level="H4" />
                                <Text text="Configure region, multiple systems, services, team roles, and persona details." class="fioriDescriptionText" />
                            </VBox>
                        </HBox>
                        <Button
                            icon="sap-icon://decline"
                            type="Transparent"
                            press=".onNavBackToPortal"
                            tooltip="Close Add Access Section"
                            ariaLabel="Close Add Access"
                            class="kyraCloseIconBtn kyraAddAccessCloseBtn" />
                    </HBox>

                    <form:SimpleForm
                        editable="true"
                        layout="ColumnLayout"
                        columnsM="2"
                        columnsL="2"
                        singleContainerFullWidth="false">
                        <form:content>
                            <core:Title text="Region and Systems Selection" />
                            
                            <Label text="Operating Region Selection" required="true" class="sapUiSmallMarginBottom" />
                            <VBox class="fioriMapCardOuter sapUiSmallMarginBottom">
                                <core:HTML content='&lt;div id="mapWrapperAddAccess" class="map-wrapper"&gt;
                                        &lt;img id="worldMapImgAddAccess" src="world-map.jpg" alt="World Map" class="world-map-img"&gt;
                                        &lt;div id="pinsLayerAddAccess" class="map-pins-layer"&gt;&lt;/div&gt;
                                        
                                        &lt;div id="selectAllBtnAddAccess" class="select-all-btn-wrapper"&gt;
                                          &lt;div class="select-all-icon"&gt;
                                            &lt;svg class="select-all-pin-icon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"&gt;
                                              &lt;path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5-2.5z"/&gt;
                                            &lt;/svg&gt;
                                            &lt;svg class="select-all-check-icon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"&gt;
                                              &lt;path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/&gt;
                                            &lt;/svg&gt;
                                          &lt;/div&gt;
                                          &lt;span class="select-all-text"&gt;Select All Regions&lt;/span&gt;
                                        &lt;/div&gt;
                                    &lt;/div&gt;'>
                                </core:HTML>
                            </VBox>

                            <VBox class="selected-regions-card-box sapUiSmallMarginBottom" alignContent="Center" alignItems="Center">
                                <Text text="SELECTED REGIONS" class="selected-regions-header" />
                                <HBox id="selectedChipsListAddAccess" items="{addAccessModel>/selectedRegionChips}" class="selected-chips-list" justifyContent="Center" wrap="Wrap">
                                    <Button 
                                        text="{addAccessModel>name}" 
                                        icon="sap-icon://decline" 
                                        iconFirst="false" 
                                        press=".onRemoveMapRegionChip"
                                        class="region-chip-btn sapUiTinyMarginEnd sapUiTinyMarginBottom" />
                                </HBox>
                                <Text text="No regions selected" class="no-selection-text" visible="{= !${addAccessModel>/hasRegionSelection} }" />
                            </VBox>

                            <Label text="Systems" required="true" />
                            <MultiComboBox
                                id="systemsMultiSelect"
                                selectedKeys="{addAccessModel>/selectedSystems}"
                                placeholder="Select one or multiple systems..."
                                width="100%"
                                class="fioriFormSelect">
                                <core:Item key="SAP Business Technology Platform" text="SAP Business Technology Platform" />
                            </MultiComboBox>

                            <Label text="Services" required="true" />
                            <MultiComboBox
                                id="servicesMultiSelectStep2"
                                selectedKeys="{addAccessModel>/selectedServices}"
                                selectionChange=".onServicesSelectionChange"
                                placeholder="Select one or multiple services..."
                                width="100%"
                                class="fioriFormSelect">
                                <core:Item key="xsuaa (Authorization and Trust Management Service)" text="xsuaa (Authorization and Trust Management Service)" />
                                <core:Item key="identity (Cloud Identity Services - IAS / IdP / SSO)" text="identity (Cloud Identity Services - IAS / IdP / SSO)" />
                                <core:Item key="credstore (SAP Credential Store)" text="credstore (SAP Credential Store)" />
                                <core:Item key="auditlog-management (Audit Log Service)" text="auditlog-management (Audit Log Service)" />
                                <core:Item key="uas (User Account and Authentication Service)" text="uas (User Account and Authentication Service)" />
                                <core:Item key="personal-data-manager-service (Data Privacy &amp; GDPR Governance)" text="personal-data-manager-service (Data Privacy &amp; GDPR Governance)" />
                                <core:Item key="destination &amp; connectivity (Destinations &amp; Cloud Connector Tunneling)" text="destination &amp; connectivity (Destinations &amp; Cloud Connector Tunneling)" />
                                <core:Item key="it-rt (SAP Integration Suite / Cloud Integration Runtime)" text="it-rt (SAP Integration Suite / Cloud Integration Runtime)" />
                                <core:Item key="sap-graph (Unified Enterprise Data Access)" text="sap-graph (Unified Enterprise Data Access)" />
                                <core:Item key="saas-registry &amp; service-manager (Tenant Provisioning &amp; Service Broker)" text="saas-registry &amp; service-manager (Tenant Provisioning &amp; Service Broker)" />
                                <core:Item key="one-mds (Master Data Integration Service)" text="one-mds (Master Data Integration Service)" />
                                <core:Item key="apimanagement-apiportal-trial / apimanagement-devportal-trial" text="apimanagement-apiportal-trial / apimanagement-devportal-trial" />
                                <core:Item key="build-workzone-standard (SAP Build Work Zone / Fiori Launchpad)" text="build-workzone-standard (SAP Build Work Zone / Fiori Launchpad)" />
                                <core:Item key="html5-apps-repo &amp; app-front (HTML5 Repository &amp; Frontend Hosting)" text="html5-apps-repo &amp; app-front (HTML5 Repository &amp; Frontend Hosting)" />
                                <core:Item key="theming &amp; ui5-flexibility-keyuser (Theme Designer &amp; UI Adaptation)" text="theming &amp; ui5-flexibility-keyuser (Theme Designer &amp; UI Adaptation)" />
                                <core:Item key="hana-cloud / hana / hanatrial (SAP HANA Cloud DB &amp; Data Lake)" text="hana-cloud / hana / hanatrial (SAP HANA Cloud DB &amp; Data Lake)" />
                                <core:Item key="postgresql-db (PostgreSQL Backing Service)" text="postgresql-db (PostgreSQL Backing Service)" />
                                <core:Item key="redis-cache (Redis In-Memory Cache)" text="redis-cache (Redis In-Memory Cache)" />
                                <core:Item key="process-automation-service (SAP Build Process Automation / Workflows &amp; RPA)" text="process-automation-service (SAP Build Process Automation / Workflows &amp; RPA)" />
                                <core:Item key="document-information-extraction-trial &amp; document-translation" text="document-information-extraction-trial &amp; document-translation" />
                                <core:Item key="data-attribute-recommendation-trial / business-entity / service-ticket-intelligence" text="data-attribute-recommendation-trial / business-entity / service-ticket-intelligence" />
                                <core:Item key="abap-trial &amp; xfs-runtime-trial (ABAP Cloud / Steampunk &amp; Extension Suite)" text="abap-trial &amp; xfs-runtime-trial (ABAP Cloud / Steampunk &amp; Extension Suite)" />
                                <core:Item key="mobile-services (SAP Mobile Services)" text="mobile-services (SAP Mobile Services)" />
                                <core:Item key="jobscheduler &amp; autoscaler (Task Scheduling &amp; Dynamic Scaling)" text="jobscheduler &amp; autoscaler (Task Scheduling &amp; Dynamic Scaling)" />
                                <core:Item key="application-logs &amp; alert-notification (Logging &amp; Real-time Alerts)" text="application-logs &amp; alert-notification (Logging &amp; Real-time Alerts)" />
                                <core:Item key="feature-flags &amp; transport (Feature Toggles &amp; Cloud Transport - cTMS)" text="feature-flags &amp; transport (Feature Toggles &amp; Cloud Transport - cTMS)" />
                                <core:Item key="cis (Cloud Management Service)" text="cis (Cloud Management Service)" />
                            </MultiComboBox>

                            <Label text="Team" required="true" />
                            <MultiComboBox
                                id="teamMultiSelectStep2"
                                selectedKeys="{addAccessModel>/selectedRoles}"
                                selectionChange=".onTeamSelectionChange"
                                items="{addAccessModel>/subRolesList}"
                                placeholder="Select one or multiple team roles..."
                                width="100%"
                                class="fioriFormSelect">
                                <core:Item key="{addAccessModel>key}" text="{addAccessModel>text}" icon="{addAccessModel>icon}" />
                            </MultiComboBox>

                            <Label text="Persona" required="true" />
                            <MultiComboBox
                                id="personaMultiSelectStep2"
                                selectedKeys="{addAccessModel>/selectedPersonas}"
                                items="{addAccessModel>/personasList}"
                                placeholder="Select one or multiple personas..."
                                width="100%"
                                class="fioriFormSelect">
                                <core:Item key="{addAccessModel>key}" text="{addAccessModel>text}" icon="{addAccessModel>icon}" />
                            </MultiComboBox>

                            <core:Title text="Duration and Justification" />

                            <Label text="Access Duration" required="true" />
                            <Select
                                id="durationSelectStep2"
                                selectedKey="{addAccessModel>/duration}"
                                width="100%"
                                class="fioriFormSelect">
                                <core:Item key="" text="-- Select Access Duration --" />
                                <core:Item key="Permanent (Default)" text="Permanent (Default)" />
                                <core:Item key="30 Days (Temporary)" text="30 Days (Temporary)" />
                                <core:Item key="90 Days (Project)" text="90 Days (Project)" />
                            </Select>

                            <Label text="Business Justification" required="true" />
                            <TextArea
                                value="{addAccessModel>/justification}"
                                placeholder="Provide detailed justification for granting these system roles..."
                                rows="3"
                                width="100%" />
                        </form:content>
                    </form:SimpleForm>

                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginTop">
                        <Button
                            text="Back to Step 1"
                            press=".onBackToStep1"
                            class="kyraBackTealBtn" />
                        <HBox>
                            <Button
                                text="Cancel"
                                type="Default"
                                press=".onNavBackToPortal"
                                class="kyraSecondaryBtn sapUiTinyMarginEnd" />
                            <Button
                                text="Next"
                                type="Emphasized"
                                press=".onGoToStep3Summary"
                                class="fioriEmphasizedBtn" />
                        </HBox>
                    </HBox>
                </VBox>

                <!-- STEP 3 CONTAINER: ACCESS REQUEST SUMMARY & REVIEW PAGE -->
                <VBox
                    visible="{addAccessModel>/step3Visible}"
                    class="fioriTableCard sapUiResponsivePadding sapUiSmallMarginBottom">

                    <!-- Section Header: Title + Back to User Access Portal button -->
                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                        <HBox alignItems="Center">
                            <Avatar src="sap-icon://customer" backgroundColor="Accent6" displaySize="M" class="sapUiSmallMarginEnd" />
                            <VBox>
                                <Title text="Access Request Governance Summary Review" level="H3" />
                                <Text text="{= 'Reviewing entitlement submission for Requester User ID: ' + (${addAccessModel>/activeUser} || '') }" class="fioriDescriptionText" />
                            </VBox>
                        </HBox>
                        <Button
                            text="Back to User Access Portal"
                            press=".onNavBackToPortal"
                            class="kyraBackTealBtn"
                            tooltip="Back to User Access Portal" />
                    </HBox>

                    <!-- Full Access Governance & Requester Details Card -->
                    <VBox class="fioriTableCard sapUiResponsivePadding sapUiSmallMarginTop">
                        <Title text="Full Access Governance &amp; Requester Details" level="H5" class="sapUiTinyMarginBottom" />
                        <HBox wrap="Wrap" class="sapUiTinyMarginTop">
                            <VBox width="25%" class="sapUiTinyMarginBottom">
                                <Label text="User ID" class="fioriFormLabel" />
                                <Text text="{addAccessModel>/activeUser}" class="sapUiTinyMarginTop" style="font-weight: 600;" />
                            </VBox>
                            <VBox width="25%" class="sapUiTinyMarginBottom">
                                <Label text="Business Sector" class="fioriFormLabel" />
                                <Text text="{addAccessModel>/sector}" class="sapUiTinyMarginTop" style="font-weight: 600;" />
                            </VBox>
                            <VBox width="25%" class="sapUiTinyMarginBottom">
                                <Label text="Business Function" class="fioriFormLabel" />
                                <Text text="{addAccessModel>/function}" class="sapUiTinyMarginTop" style="font-weight: 600;" />
                            </VBox>
                            <VBox width="25%" class="sapUiTinyMarginBottom">
                                <Label text="Region" class="fioriFormLabel" />
                                <Text text="{addAccessModel>/region}" class="sapUiTinyMarginTop" style="font-weight: 600;" />
                            </VBox>
                            <VBox width="25%" class="sapUiTinyMarginBottom">
                                <Label text="Duration" class="fioriFormLabel" />
                                <Text text="{addAccessModel>/duration}" class="sapUiTinyMarginTop" style="font-weight: 600;" />
                            </VBox>
                            <VBox width="25%" class="sapUiTinyMarginBottom">
                                <Label text="Business Justification" class="fioriFormLabel" />
                                <Text text="{addAccessModel>/justification}" class="sapUiTinyMarginTop" style="font-weight: 600;" />
                            </VBox>
                            <VBox width="25%" class="sapUiTinyMarginBottom">
                                <Label text="Status" class="fioriFormLabel" />
                                <ObjectStatus
                                    text="Pending Approval"
                                    state="Warning"
                                    icon="sap-icon://history"
                                    class="sapUiTinyMarginTop" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Action Buttons -->
                    <HBox justifyContent="End" alignItems="Center" class="sapUiSmallMarginTop">
                        <Button
                            text="Cancel Request"
                            type="Default"
                            press=".onNavBackToPortal"
                            class="kyraSecondaryBtn sapUiTinyMarginEnd" />
                        <Button
                            text="Submit Access Request"
                            type="Emphasized"
                            icon="sap-icon://paper-plane"
                            press=".onFinalSubmitRequest"
                            enabled="{addAccessModel>/submitEnabled}"
                            class="fioriEmphasizedBtn" />
                    </HBox>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
