<mvc:View
    controllerName="kyra001.pages.login.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    
    <Page showHeader="false" enableScrolling="false" class="kyraDesktopLoginPage">
        <content>
            <!-- Ambient Background Effects (Cyber Mesh Grid, Glow Orbs, Subtle Watermark) -->
            <VBox class="kyraAmbientCanvasContainer" width="100%" height="100%">
                <HBox class="kyraCyberGridOverlay" />
                <HBox class="kyraAmbientOrb kyraAmbientOrb1" />
                <HBox class="kyraAmbientOrb kyraAmbientOrb2" />
                <HBox class="kyraAmbientOrb kyraAmbientOrb3" />
                <Image src="{login>/logoUrl}" densityAware="false" class="kyraWatermarkK" />
            </VBox>

            <FlexBox class="kyraLoginLayoutWrapper" direction="Row" wrap="Wrap" height="100%" width="100%">
                
                <!-- ================= LEFT SECTION (58% COLUMN - ZERO-TRUST CYBERSECURITY HUB) ================= -->
                <VBox class="kyraLoginLeftPanel" justifyContent="Center" alignItems="Stretch">
                    
                    <!-- Top Brand Logo Only (Clean & Proper) -->
                    <HBox alignItems="Center" class="kyraHeroBrandLogoContainer">
                        <Image src="{login>/logoUrl}" height="48px" densityAware="false" class="kyraHeroBrandLogoOnly" />
                    </HBox>

                    <!-- Hero Typography & Core Value Proposition -->
                    <VBox class="kyraHeroMainContentBox">
                        <Text text="Secure Access." class="kyraHeroTitleDark" />
                        <Text text="Total Control." class="kyraHeroTitleTeal" />
                        <HBox class="kyraHeroTealDashBar" />
                        <FormattedText 
                            htmlText="Centralized enterprise identity governance, dynamic role entitlement provisioning, and continuous automated compliance across your &lt;strong class='kyraTealHighlight'&gt;hybrid cloud ecosystem.&lt;/strong&gt;" 
                            class="kyraHeroSubtitleText" />
                    </VBox>

                    <!-- 3D Security Shield Architecture (User Uploaded Design Matching) -->
                    <VBox class="kyraHero3dShowcaseWrapper" alignItems="Center" justifyContent="Center" width="100%">
                        <Image 
                            id="kyraSecurity3dGraphic"
                            src="{login>/shieldArchitectureUrl}"
                            densityAware="false" 
                            class="kyraHero3dArchitectureImg" 
                            tooltip="KYRA Secure Access Platform - Identity Governance, Role Management, Entitlement Provisioning, Continuous Compliance" />
                    </VBox>

                    <!-- Left Live Status Footer -->
                    <HBox alignItems="Center" class="kyraLeftLiveStatusRow">
                        <HBox class="kyraLivePulseDot" />
                        <Text text="Enterprise Gateway Active" class="kyraLiveStatusHighlight" />
                        <Text text="•" class="kyraLiveStatusSep" />
                        <Text text="256-Bit TLS" class="kyraLiveStatusText" />
                        <Text text="•" class="kyraLiveStatusSep" />
                        <Text text="Multi-Tenant Isolated" class="kyraLiveStatusText" />
                    </HBox>

                </VBox>

                <!-- ================= RIGHT SECTION (42% COLUMN - MODERN GLASSMORPHIC LOGIN CARD) ================= -->
                <VBox class="kyraLoginRightPanel" justifyContent="Center" alignItems="Center">
                    <VBox class="kyraLoginCardContainer">
                        
                        <!-- Top Card Header: Clean Logo Only + Wordmark -->
                        <VBox alignItems="Center" class="kyraCardHeaderBox">
                            
                            <!-- Clean Brand Logo Direct -->
                            <Image src="{login>/logoUrl}" height="48px" densityAware="false" class="kyraCardLogoImgDirect" tooltip="KYRA Secure Access" />

                            <Text text="KYRA" class="kyraCardBrandTitle" />
                            <Text text="ENTERPRISE ACCESS" class="kyraCardBrandSub" />
                            <Text text="Secure Identity Gateway" class="kyraCardPortalTitle" />
                            <Text text="Welcome back! Please sign in to continue." class="kyraCardWelcomeText" />
                        </VBox>

                        <!-- Error Notification MessageStrip -->
                        <MessageStrip
                            visible="{login>/hasError}"
                            text="{login>/errorMessage}"
                            type="Error"
                            showIcon="true"
                            showCloseButton="true"
                            close=".onDismissError"
                            class="sapUiTinyMarginBottom kyraLoginErrorStrip" />

                        <!-- Form Controls Container -->
                        <VBox width="100%" class="kyraLoginFormBody">
                            
                            <!-- Login As Dropdown -->
                            <VBox class="kyraFormGroup" width="100%">
                                <HBox alignItems="Center" class="kyraLabelRow">
                                    <core:Icon src="sap-icon://customer" class="kyraLabelIcon" />
                                    <Label text="Login As" labelFor="roleSelect" class="kyraFormLabel" />
                                </HBox>
                                <Select
                                    id="roleSelect"
                                    selectedKey="{login>/selectedRole}"
                                    change=".onRoleChange"
                                    width="100%"
                                    class="kyraModernSelect">
                                    <items>
                                        <core:Item key="Requester" text="Requester" icon="sap-icon://customer" />
                                        <core:Item key="Approver" text="Approver" icon="sap-icon://shield" />
                                        <core:Item key="Compliance Review" text="Compliance Review" icon="sap-icon://user-settings" />
                                    </items>
                                </Select>
                            </VBox>

                            <!-- Dynamic ID Input Field -->
                            <VBox class="kyraFormGroup" width="100%">
                                <HBox alignItems="Center" class="kyraLabelRow">
                                    <core:Icon src="sap-icon://customer" class="kyraLabelIcon" />
                                    <Label text="{login>/idLabel}" labelFor="idInput" class="kyraFormLabel" />
                                </HBox>
                                <Input
                                    id="idInput"
                                    value="{login>/userId}"
                                    placeholder="{login>/idPlaceholder}"
                                    valueState="{login>/idState}"
                                    valueStateText="{login>/idStateText}"
                                    liveChange=".onInputChange"
                                    change=".onInputChange"
                                    submit=".onLogin"
                                    showClearButton="true"
                                    class="kyraModernInput"
                                    width="100%" />
                            </VBox>

                            <!-- Full Width Solid Vibrant Teal Sign In Button with Arrow & Shine -->
                            <Button
                                id="signInButton"
                                text="Sign In"
                                icon="sap-icon://navigation-right-arrow"
                                iconFirst="false"
                                type="Emphasized"
                                width="100%"
                                press=".onLogin"
                                busy="{login>/isBusy}"
                                class="kyraPrimarySignInBtn" />

                        </VBox>
                    </VBox>
                </VBox>

            </FlexBox>
        </content>
    </Page>
</mvc:View>