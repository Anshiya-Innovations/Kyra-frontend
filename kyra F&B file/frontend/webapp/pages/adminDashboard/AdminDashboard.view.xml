<mvc:View
    controllerName="kyra001.pages.adminDashboard.AdminDashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page showHeader="false" enableScrolling="true" class="fioriDashboardBg">
        <!-- Admin Top ShellBar -->
        <f:ShellBar
            title="{i18n>adminDashboardTitle}"
            secondTitle="System Administration"
            homeIcon="sap-icon://user-settings"
            showCopilot="false"
            showSearch="true"
            showNotifications="true"
            notificationsNumber="5">
            <f:profile>
                <Avatar initials="AD" backgroundColor="Accent1" />
            </f:profile>
            <f:additionalContent>
                <Button
                    icon="sap-icon://log-out"
                    text="{i18n>logoutButton}"
                    type="Transparent"
                    press=".onLogout"
                    tooltip="{i18n>logoutButton}" />
            </f:additionalContent>
        </f:ShellBar>

        <!-- Main Admin Dashboard Content -->
        <VBox class="sapUiResponsiveMargin">
            <!-- Welcome Banner Card -->
            <VBox class="fioriWelcomeCard sapUiSmallMarginBottom sapUiResponsivePadding">
                <HBox justifyContent="SpaceBetween" alignItems="Center">
                    <VBox>
                        <Title text="{i18n>welcomeAdminMessage}" level="H2" class="fioriWelcomeTitle" />
                        <Text text="{i18n>adminRoleText}" class="fioriWelcomeSubtitle" />
                    </VBox>
                    <HBox alignItems="Center">
                        <ObjectStatus
                            title="Role"
                            text="Administrator"
                            state="Information"
                            icon="sap-icon://shield"
                            class="sapUiSmallMarginEnd" />
                        <Button
                            icon="sap-icon://refresh"
                            type="Transparent"
                            press=".onRefreshData"
                            tooltip="Refresh System Status" />
                    </HBox>
                </HBox>
            </VBox>

            <!-- Admin KPI Tiles Container -->
            <Title text="System Control &amp; Audit Metrics" level="H3" class="sapUiSmallMarginBottom" />
            <HBox wrap="Wrap" class="fioriTileRow sapUiSmallMarginBottom">
                <GenericTile
                    header="Active Sessions"
                    subheader="Current logged-in users"
                    class="sapUiTinyMarginEnd sapUiTinyMarginBottom fioriKpiTile"
                    press=".onTilePress">
                    <TileContent footer="Normal load">
                        <NumericContent
                            value="142"
                            icon="sap-icon://group"
                            valueColor="Good" />
                    </TileContent>
                </GenericTile>

                <GenericTile
                    header="System Uptime"
                    subheader="Last 30 Days"
                    class="sapUiTinyMarginEnd sapUiTinyMarginBottom fioriKpiTile"
                    press=".onTilePress">
                    <TileContent footer="All services healthy">
                        <NumericContent
                            value="99.99%"
                            icon="sap-icon://electrocardiogram"
                            valueColor="Good" />
                    </TileContent>
                </GenericTile>

                <GenericTile
                    header="Pending Audits"
                    subheader="Security logs"
                    class="sapUiTinyMarginEnd sapUiTinyMarginBottom fioriKpiTile"
                    press=".onTilePress">
                    <TileContent footer="Requires review">
                        <NumericContent
                            value="3"
                            icon="sap-icon://security-high"
                            valueColor="Critical" />
                    </TileContent>
                </GenericTile>
            </HBox>

            <!-- Quick Admin Actions -->
            <VBox class="fioriQuickActionsBox sapUiSmallMarginBottom sapUiResponsivePadding">
                <Title text="Admin Control Panel" level="H4" class="sapUiSmallMarginBottom" />
                <HBox wrap="Wrap">
                    <Button
                        text="User Management"
                        icon="sap-icon://user-settings"
                        type="Default"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                        press=".onQuickAction" />
                    <Button
                        text="Security Logs"
                        icon="sap-icon://action-settings"
                        type="Default"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                        press=".onQuickAction" />
                    <Button
                        text="System Backup"
                        icon="sap-icon://save"
                        type="Default"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                        press=".onQuickAction" />
                </HBox>
            </VBox>
        </VBox>
    </Page>
</mvc:View>
