{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start Backend (CAP)",
      "request": "launch",
      "type": "node",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npx",
      "args": [
        "cds",
        "serve"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ],
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "server listening on \\{\\s*url:\\s*'http://localhost:[0-9]+'\\s*\\}",
        "uriFormat": "http://localhost:8080/test/flp.html?sap-ui-xx-viewCache=false#app-preview"
      }
    },
    {
      "name": "Start Frontend (UI5)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/app",
      "runtimeExecutable": "npx",
      "args": [
        "fiori",
        "run",
        "--config",
        "./ui5-local.yaml",
        "--open",
        "test/flp.html#app-preview"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ],
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Initialized for app",
        "uriFormat": "http://localhost:8080/test/flp.html?sap-ui-xx-viewCache=false#app-preview"
      }
    }
  ],
  "compounds": [
    {
      "name": "Start Both (Backend & Frontend)",
      "configurations": [
        "Start Frontend (UI5)",
        "Start Backend (CAP)"
      ]
    }
  ]
}