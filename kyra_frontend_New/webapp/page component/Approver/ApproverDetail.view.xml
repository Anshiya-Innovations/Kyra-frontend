<mvc:View
    controllerName="kyra001.pages.Approver.ApproverDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core">

    <Page id="approverDetailPage" showHeader="false" enableScrolling="true" class="fioriDashboardBg">
        <content>
            <VBox class="sapUiResponsiveMargin fioriStepSlideAnim">
                <!-- Dynamic Page Title Banner Card for Summary Review -->
                <VBox class="fioriHeaderBannerCard sapUiSmallMarginBottom">
                    <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" width="100%">
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                            <Avatar
                                src="sap-icon://summary-detail"
                                displaySize="L"
                                backgroundColor="Accent1"
                                class="fioriShieldHeaderAvatar sapUiMediumMarginEnd" />
                            <VBox>
                                <Title text="Access Request Governance Summary Review" level="H1" class="fioriBannerTitle" />
                                <Text text="{= 'Reviewing entitlement submission for Requester User ID: ' + ${accessModel>/selectedRequest/requesterId} }" class="fioriBannerSubtitle" />
                            </VBox>
                        </HBox>
                        <Button
                            text="Back to User Access Portal"
                            icon="sap-icon://navigation-left-arrow"
                            type="Default"
                            press=".onCloseRequestSummaryView" />
                    </HBox>
                </VBox>

                <!-- CARD 1: FULL ACCESS GOVERNANCE & REQUESTER DETAILS (4 Grid Columns) -->
                <VBox class="fioriTableCard sapUiResponsivePadding sapUiSmallMarginBottom">
                    <Title text="Full Access Governance &amp; Requester Details" level="H3" class="sapUiSmallMarginBottom" />

                    <!-- Grid Layout matching exact columns in user uploaded screenshot -->
                    <l:Grid defaultSpan="L3 M6 S12" class="sapUiNoContentPadding sapUiSmallMarginBottom">
                        <!-- Column 1 -->
                        <VBox class="sapUiSmallMarginBottom">
                            <VBox class="sapUiSmallMarginBottom">
                                <Label text="Requester User ID" class="fioriFormLabel" />
                                <Text text="{accessModel>/selectedRequest/requesterId}" class="sapUiTinyMarginTop" style="font-weight: 700; font-size: 1.05rem;" />
                            </VBox>
                            <VBox>
                                <Label text="Operating Region" class="fioriFormLabel" />
                                <Text text="{accessModel>/selectedRequest/region}" class="sapUiTinyMarginTop" style="font-weight: 600;" />
                            </VBox>
                        </VBox>

                        <!-- Column 2 -->
                        <VBox class="sapUiSmallMarginBottom">
                            <VBox class="sapUiSmallMarginBottom">
                                <Label text="Requester Role Persona" class="fioriFormLabel" />
                                <Text text="{accessModel>/selectedRequest/persona}" class="sapUiTinyMarginTop" style="font-weight: 600;" />
                            </VBox>
                            <VBox class="sapUiSmallMarginBottom">
                                <Label text="Selected Entitlement Persona" class="fioriFormLabel" />
                                <Text text="{accessModel>/selectedRequest/selectedPersona}" class="sapUiTinyMarginTop" style="font-weight: 600;" />
                            </VBox>
                            <VBox>
                                <Label text="Access Duration" class="fioriFormLabel" />
                                <Text text="{accessModel>/selectedRequest/duration}" class="sapUiTinyMarginTop" style="font-weight: 600;" />
                            </VBox>
                        </VBox>

                        <!-- Column 3 -->
                        <VBox class="sapUiSmallMarginBottom">
                            <VBox class="sapUiSmallMarginBottom">
                                <Label text="Business Sector" class="fioriFormLabel" />
                                <Text text="{accessModel>/selectedRequest/sector}" class="sapUiTinyMarginTop" style="font-weight: 600;" />
                            </VBox>
                            <VBox>
                                <Label text="Business Justification" class="fioriFormLabel" />
                                <Text text="{accessModel>/selectedRequest/justification}" class="sapUiTinyMarginTop" style="font-style: italic;" />
                            </VBox>
                        </VBox>

                        <!-- Column 4 -->
                        <VBox class="sapUiSmallMarginBottom">
                            <VBox class="sapUiSmallMarginBottom">
                                <Label text="Business Function" class="fioriFormLabel" />
                                <Text text="{accessModel>/selectedRequest/function}" class="sapUiTinyMarginTop" style="font-weight: 600;" />
                            </VBox>
                            <VBox>
                                <Label text="Approval Status" class="fioriFormLabel" />
                                <ObjectStatus
                                    text="{accessModel>/selectedRequest/status}"
                                    state="{accessModel>/selectedRequest/statusState}"
                                    icon="{accessModel>/selectedRequest/statusIcon}"
                                    class="sapUiTinyMarginTop" />
                            </VBox>
                        </VBox>
                    </l:Grid>
                </VBox>

                <!-- CARD 2: TARGET SYSTEMS SEPARATED TABLE CARDS (SYSTEM HEADER AT TOP & SYSTEM COLUMN REMOVED) -->
                <VBox items="{accessModel>/selectedRequest/summaryTables}">
                    <items>
                        <VBox class="fioriConflictSectionBox sapUiSmallMarginBottom">
                            <!-- Target System Header Banner at Top -->
                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom fioriConflictHeaderBanner">
                                <HBox alignItems="Center">
                                    <Avatar src="{accessModel>systemIcon}" backgroundColor="Accent6" displaySize="S" class="sapUiTinyMarginEnd" />
                                    <VBox>
                                        <Title text="{= 'Target System ' + ${accessModel>systemIndex} + ': ' + ${accessModel>systemName} }" level="H5" class="fioriConflictSectionTitle" />
                                        <Text text="{= ${accessModel>items}.length + ' Configured Entitlement(s)' }" class="fioriDescriptionText" />
                                    </VBox>
                                </HBox>
                            </HBox>

                            <!-- Table for this System (System Column Removed, 9 Columns Maintained) -->
                            <Table
                                items="{accessModel>items}"
                                noDataText="No entitlement details available for this system."
                                popinLayout="GridSmall"
                                class="sapUiNoMargin">
                                <columns>
                                    <Column width="9%"><Text text="REQUEST ID" style="font-weight: 700;" /></Column>
                                    <Column width="8%"><Text text="TEAM" style="font-weight: 700;" /></Column>
                                    <Column width="11%"><Text text="ROLES" style="font-weight: 700;" /></Column>
                                    <Column width="13%" minScreenWidth="Tablet" demandPopin="true"><Text text="SELECTED PERSONA" style="font-weight: 700;" /></Column>
                                    <Column width="8%" minScreenWidth="Desktop" demandPopin="true"><Text text="GRANTED DATE" style="font-weight: 700;" /></Column>
                                    <Column width="8%" minScreenWidth="Desktop" demandPopin="true"><Text text="EXPIRY DATE" style="font-weight: 700;" /></Column>
                                    <Column width="8%"><Text text="STATUS" style="font-weight: 700;" /></Column>
                                    <Column width="13%" minScreenWidth="Tablet" demandPopin="true"><Text text="APPROVER REMARKS / REASON" style="font-weight: 700;" /></Column>
                                    <Column width="22%" hAlign="Center"><Text text="ACCEPT / REJECT" style="font-weight: 700;" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem vAlign="Middle">
                                        <cells>
                                            <ObjectIdentifier title="{accessModel>requestId}" />
                                            <Text text="{accessModel>team}" />
                                            <Text text="{accessModel>roleName}" style="font-weight: 700;" />
                                            <Text text="{accessModel>selectedPersona}" style="font-weight: 500;" />
                                            <Text text="{accessModel>grantedDate}" />
                                            <Text text="{accessModel>expiryDate}" />
                                            <ObjectStatus
                                                text="{accessModel>status}"
                                                state="{accessModel>statusState}"
                                                icon="{accessModel>statusIcon}" />
                                            <Input
                                                value="{accessModel>comment}"
                                                placeholder="{= ${accessModel>status} === 'Approved' ? 'Approval note added' : (${accessModel>status} === 'Rejected' ? 'Rejection reason added' : 'Add remark...') }"
                                                width="100%" />
                                            <HBox justifyContent="Center" alignItems="Center" class="fioriRowActionBtnBox">
                                                <Button
                                                    text="✓ APPROVE"
                                                    type="{= ${accessModel>status} === 'Approved' ? 'Accept' : 'Default' }"
                                                    press=".onAcceptEntitlement"
                                                    class="fioriRowApproveBtnLarge sapUiTinyMarginEnd"
                                                    tooltip="Approve entitlement" />
                                                <Button
                                                    text="✕ REJECT"
                                                    type="{= ${accessModel>status} === 'Rejected' ? 'Reject' : 'Default' }"
                                                    press=".onRejectEntitlement"
                                                    class="fioriRowRejectBtnLarge"
                                                    tooltip="Reject entitlement" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </items>
                </VBox>

                <!-- Batch Operations & Footer Action Bar -->
                <VBox class="fioriTableCard sapUiResponsivePadding sapUiSmallMarginBottom">
                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                        <HBox alignItems="Center">
                            <Button
                                text="Accept All Requests"
                                icon="sap-icon://sys-enter-2"
                                type="Default"
                                press=".onAcceptAllRequests"
                                class="fioriActionBtnAccept sapUiTinyMarginEnd" />
                            <Button
                                text="Reject All Requests"
                                icon="sap-icon://error"
                                type="Default"
                                press=".onRejectAllRequests"
                                class="fioriActionBtnReject" />
                        </HBox>
                        <HBox alignItems="Center">
                            <Button
                                text="Back to Dashboard"
                                icon="sap-icon://navigation-left-arrow"
                                type="Transparent"
                                press=".onCloseRequestSummaryView"
                                class="sapUiTinyMarginEnd" />
                            <Button
                                text="Submit Decision"
                                icon="sap-icon://accept"
                                type="Emphasized"
                                press=".onApproveSelectedRequest"
                                class="fioriEmphasizedBtn" />
                        </HBox>
                    </HBox>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
